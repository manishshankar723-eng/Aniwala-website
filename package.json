{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev --background",
    "stop": "astro dev stop",
    "restart": "astro dev stop && astro dev --background",
    "status": "astro dev status",
    "logs": "astro dev logs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:dataset": "node scripts/check-dataset.mjs",
    "check:og": "node scripts/check-og.mjs",
    "verify": "node scripts/check-dataset.mjs && node scripts/check-og.mjs && node --experimental-strip-types --test tests/chat.test.ts && astro check && astro build && node scripts/check-links.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "test:chat": "node --experimental-strip-types --test tests/chat.test.ts",
    "eval:chat": "node --experimental-strip-types scripts/eval-chat.mjs",
    "chat:usage": "npx supabase db query --linked --project-ref ocxbnnfchqzgkbqlagnq -f supabase/queries/chat-usage.sql",
    "chat:refused": "npx supabase db query --linked --project-ref ocxbnnfchqzgkbqlagnq -f supabase/queries/chat-refused.sql"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.5.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.2.4",
    "github-slugger": "^2.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.2"
  }
}
