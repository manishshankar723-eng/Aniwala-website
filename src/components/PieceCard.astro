---
import type { Piece } from '../lib/pieces';
import { categoryBySlug } from '../lib/workCategories';

/**
 * One portfolio tile.
 *
 * Image-led rather than text-led: a portfolio is scanned, not read, so the
 * art gets the whole tile and the metadata sits on a scrim over the bottom
 * of it. The card that reads the work back to you in a paragraph is
 * `CaseCard` — this one's job is to make you want to click.
 *
 * NOT A LINK, ever. It used to become one when the piece named a case study,
 * and the tile carried a "read the case study" line. That was the portfolio
 * selling the writing about the work instead of the work: somebody browsing a
 * discipline wants the next picture, not an essay, and the case studies have
 * their own page and their own cards for the reader who does want one.
 *
 * So the tile is the media and nothing else clickable — which also means the
 * image keeps its real alt text, rather than the empty alt it needed when a
 * heading inside an anchor was announcing the tile instead.
 */
interface Props {
  piece: Piece;
  /** Hide the discipline chip on pages that are already one discipline. */
  showCategory?: boolean;
}


const { piece, showCategory = true } = Astro.props;
const { title, blurb, kind, client, year, tools, tint, video, image, imageAlt, srcset } = piece;

/*
 * WHICH WIDTH THE BROWSER SHOULD PICK.
 *
 * Without `sizes` a browser assumes a srcset image fills the viewport and
 * takes the largest rung, which wastes bytes on a narrow tile; without
 * `srcset` at all — which is what this was — it takes the single `src` and
 * stretches it, which is the opposite problem and the one that was visible.
 *
 * A wide tile spans the row. A narrow one is half of it above 900px, where the
 * gallery goes to two columns, and the full width below.
 */
/*
 * What fraction of the viewport this tile occupies, so the browser picks a
 * rung off the srcset instead of assuming full width.
 *
 * Read off the tile's own width rather than passed in: the tile knows how much
 * of the row it takes, and a parent that had to tell it would be a second
 * place for the two to disagree. Widest-first, which is the order a browser
 * evaluates them.
 */
const SIZES = {
  third: '(min-width: 1200px) 33vw, (min-width: 900px) 50vw, 100vw',
  half: '(min-width: 900px) 50vw, 100vw',
  twoThirds: '(min-width: 1200px) 67vw, 100vw',
  full: '100vw',
} as const;
const sizes = SIZES[piece.span] ?? SIZES.half;

/* kebab for the class, camel in the data — the gallery styles these. */
const SPAN_CLASS = {
  third: 'piece--span-third',
  half: 'piece--span-half',
  twoThirds: 'piece--span-two-thirds',
  full: 'piece--span-full',
} as const;

/*
 * Controls exist for a NATIVE video and nothing else.
 *
 * A Stream tile is an iframe carrying Cloudflare's own player: a pause button
 * outside it has nothing to talk to, and the player inside already has its
 * own. Reaching into it is not merely awkward, it is cross-origin and simply
 * refused.
 *
 * There is no longer a `sound` field on a piece to consult: the native bar
 * always carries a volume control, so whether there is audio to hear is a
 * question about the FILE, not about the interface. `upload-r2.mjs` strips the
 * track unless it is passed `--keep-audio`, which is why most of these are
 * silent — and a browser greys the volume button out entirely on a file with
 * no audio STREAM. So a tile that will not unmute is a file uploaded without
 * the flag, not a lock in here; re-upload it with one before going looking.
 *
 * MUTED ON ARRIVAL, EVERY ARRIVAL — and the visitor's to unmute from there.
 * That last clause is the whole difference between a tile and a hero: a hero
 * is wallpaper and is held silent for the life of the page, while a tile IS
 * the work, and the bar in front of it is a real offer. `data-video`
 * marks the tile as a player rather than as wallpaper, which buys it three
 * things from `lib/video.ts`: the mute is re-applied on every navigation, so a
 * browser restoring the volume a visitor left behind cannot start a page with
 * audio; a pause the visitor presses is honoured rather than fought; and only
 * one tile on the page may have sound at a time, because nine autoplaying
 * videos that each remember being unmuted is not a feature.
 */
const hasPlayer = video?.kind === 'file';

const category = await categoryBySlug(piece.category);

/* Same rule the case study cards follow: a self-directed piece must never be
   read as commissioned work, so the client line only appears when there is a
   client distinct from us. */
const isStudioProject = kind === 'Studio project';

---

<article
  class:list={[
    'piece',
    piece.wide && 'piece--wide',
    hasPlayer && 'piece--player',
    SPAN_CLASS[piece.span] ?? SPAN_CLASS.half,
    piece.fit === 'contain' && 'piece--contain',
  ]}
  style={`--tint:${tint}`}
  data-reveal
>
  <div class="piece-inner">
    {/*
      The piece itself, over its tint.

      A portfolio tile is the one card on this site whose whole job is the
      picture, so this is the most consequential of the three. Decorative in
      the markup for the usual reason — the tile's own title is right below it
      — except on a tile that is NOT a link, where there is no heading in an
      anchor to read instead and the alt text is all a screen reader has.
    */}
    <span class="piece-art" aria-hidden="true"></span>
    {image && (
      <img
        class="piece-img"
        src={image}
        srcset={srcset}
        sizes={sizes}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
      />
    )}
    {
      video?.kind === 'file' && (
        /*
          THE BROWSER'S OWN PLAYER, rather than buttons of our own. It is the
          same bar a visitor gets in full screen and the same one they get on
          every other site: play, scrub, volume, full screen and
          picture-in-picture, all already understood and all already
          keyboard-accessible.

          It replaced a custom cluster whose volume button only appeared when
          an editor had ticked a box — so most tiles offered no way to hear
          anything at all, which is the fault that prompted this.

          A direct file plays natively — no player, no iframe, no third party.
          The still is the POSTER, so the tile shows a frame of the work from
          the first paint rather than a black box while the video opens.

          Muted and playsinline are not preferences: without both, iOS refuses
          to autoplay and shows its own play button over the tile, which turns
          a gallery of moving work into a grid of paused videos.
        */
        /*
          `data-src`, not `src`: deferred to the viewport gate in lib/video.ts
          rather than fetched the moment the parser arrives. A discipline page
          holds nine of these and a browser will happily start all nine at
          once — on a phone that is the entire connection spent on eight tiles
          nobody has scrolled to yet. The poster is what the tile shows until
          one is actually approached, and a press on the control bar overrides
          the wait outright.
        */
        <video
          class="piece-video"
          data-video="player"
          data-src={video.src}
          poster={image}
          autoplay
          muted
          loop
          playsinline
          preload="none"
          controls
          controlslist="nodownload"
        />
      )
    }
    {
      video?.kind === 'stream' && (
        /*
          Stream carries its own player, so this is an iframe. Over the still,
          not instead of it: the poster stays underneath and the player fades
          in on top once it has something to draw.

          `loading="lazy"` is right here and wrong on the tools marquee, and
          the difference is that this grid holds still — a tile below the fold
          is genuinely not needed yet, and an iframe is an order of magnitude
          heavier than the few KB of SVG that marquee defers.
        */
        <iframe
          class="piece-video"
          src={`${video.src}?autoplay=true&loop=true&muted=true&controls=false&preload=metadata${image ? `&poster=${encodeURIComponent(image)}` : ''}`}
          title={title}
          loading="lazy"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen
          tabindex="-1"
        />
      )
    }
    <span class="piece-scrim" aria-hidden="true"></span>

    <span class="piece-top">
      <span class:list={['piece-kind', isStudioProject && 'piece-kind--own']}>{kind}</span>
      {
        showCategory && category && (
          <span class="piece-cat">{category.title}</span>
        )
      }
    </span>

    <span class="piece-body">
      <span class="piece-meta">
        {!isStudioProject && <span>{client}</span>}
        <span>{year}</span>
      </span>

      <h3 class="piece-title">{title}</h3>
      <p class="piece-blurb">{blurb}</p>

      {
        tools.length > 0 && (
          <span class="piece-tools">{tools.join(' · ')}</span>
        )
      }

    </span>
  </div>
</article>

<style>
  .piece {
    position: relative;
    isolation: isolate;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .piece--linked:hover {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-line));
    transform: translateY(-2px);
  }

  .piece-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 20rem;
    height: 100%;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  @media (min-width: 700px) {
    .piece-inner {
      min-height: 24rem;
    }
    /* Both, deliberately. The portfolio index still lays these out in a
       grid and the discipline gallery in a flex row; each parent ignores
       the property meant for the other, so one card works in both without
       the card having to know which it is in. */
    .piece--wide {
      grid-column: span 2;
      flex-basis: 100%;
    }
    .piece--wide .piece-inner {
      min-height: 28rem;
      padding: clamp(1.75rem, 3vw, 2.75rem);
    }
  }

  /* --- Art ------------------------------------------------------------- */
  .piece-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 90% 70% at 30% 20%, hsl(var(--tint) / 0.85), transparent 70%),
      linear-gradient(160deg, hsl(var(--tint) / 0.55), #0b0c10 75%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Bottom-RIGHT, opposite the title block, so it never lands on the words.
     Always visible rather than revealed on hover: a control a visitor cannot
     see is a control they do not know they have, and on a touch screen there
     is no hover to reveal it with. */
  /*
   * LETTING CLICKS REACH THE PLAYER.
   *
   * `.piece-inner` fills the tile and sits over the video, so with it in the
   * way the control bar rendered perfectly and ignored every click — the same
   * fault that made full screen unusable, one layer up.
   *
   * Everything in the overlay is decoration: a scrim, a badge, a title. None
   * of it is clickable, so the whole layer stops taking pointer events and the
   * video takes them back. The scrim still PAINTS over the video, which is
   * wanted — the bar is white on a darkened strip, so it reads better there
   * than it would on a bright frame.
   */
  .piece--player .piece-inner {
    pointer-events: none;
  }
  .piece--player .piece-video {
    pointer-events: auto;
  }

  /*
   * Room for the bar, so the title is not sitting under it.
   *
   * The bar is only drawn on hover, so this is a gap that is empty most of the
   * time — which is the cheaper mistake. The other way round, every hover puts
   * a scrubber through the middle of the piece's name.
   */
  .piece--player .piece-body {
    padding-bottom: 2.75rem;
  }

  /* The player, over the poster — native <video> or Stream's iframe, same box
     either way, so the card does not care which it got. */
  .piece-video {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    /* Decorative motion, not a control surface: the tile is not a link and
       the player has no chrome, so nothing here should take a tab stop. */
    pointer-events: none;
  }

  /*
   * IN FULL SCREEN THE VIDEO IS THE INTERFACE, so the rule above has to stop
   * applying.
   *
   * `pointer-events: none` is right on the tile — the video is decoration
   * there and our own buttons sit over it. Carried into full screen it makes
   * the browser's OWN control bar unclickable: the bar renders, the scrubber
   * and volume are visibly right there, and every click passes straight
   * through. That is what it looked like.
   *
   * `contain` for the same reason. `cover` crops to the tile's shape, which is
   * the point on a grid and exactly wrong on a screen the visitor has just
   * asked to fill with the whole frame.
   *
   * ONE RULE, because the build prefixes this. Writing the `-webkit-` spelling
   * by hand produced a byte-identical duplicate in the output: Lightning CSS
   * normalises `:-webkit-full-screen` to `:fullscreen` and adds whatever the
   * browser targets actually need. If it ever has to be written by hand, write
   * it as a SEPARATE rule and never in one selector list with `:fullscreen` —
   * an unknown pseudo-class invalidates the whole list, which would drop both.
   */
  .piece-video:fullscreen {
    pointer-events: auto;
    object-fit: contain;
  }

  /*
   * SHOW THE WHOLE PICTURE.
   *
   * `cover` is the default and fills the tile, cutting whatever does not fit —
   * which is right for a render with room around the subject and wrong for a
   * character sheet, where the crop goes straight through the thing being
   * judged. `contain` fits the image inside the box instead and lets the tint
   * show around it.
   *
   * The video gets the same treatment, so a tile that has both does not crop
   * one and letterbox the other.
   *
   * `object-position: center` is explicit rather than inherited: with
   * `contain` the spare space is split evenly, which is the only arrangement
   * that looks deliberate when the tiles either side are filled.
   */
  .piece--contain .piece-img,
  .piece--contain .piece-video {
    object-fit: contain;
    object-position: center;
  }

  /*
   * `z-index: -1` is load bearing, and its absence was a bug waiting for the
   * first piece to have BOTH an image and a video.
   *
   * `.piece-inner` is `position: relative` with no z-index, so it is not a
   * stacking context and these all paint in `.piece`'s: the negative layers
   * first, then everything at `auto` in DOM order. Without a z-index here the
   * still was `auto`, which put it above `.piece-video` at -1 — a poster image
   * covering the video it is the poster FOR, and covering the scrim as well.
   *
   * It went unnoticed only because both video pieces happened to have no
   * image. The Studio now offers to fill that field in after every upload, so
   * the combination stopped being hypothetical.
   *
   * At -1 with the video, DOM order decides, and the still is written first.
   */
  .piece-img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Faded in over the still rather than cutting to it. Without JavaScript
     neither attribute is set and this does nothing. See lib/video.ts. */
  .piece-video[data-fade] {
    opacity: 0;
  }
  .piece-video[data-fade][data-ready] {
    opacity: 1;
    transition: opacity 0.5s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .piece-video[data-fade][data-ready] {
      transition: none;
    }
  }
  .piece--linked:hover .piece-img {
    transform: scale(1.05);
  }
  .piece--linked:hover .piece-art {
    transform: scale(1.06);
  }
  /* The scrim is what makes white type legible over art we do not control.
     It is a separate element rather than a ::after on the tile so it can sit
     between the art and the text in the stacking order. */
  .piece-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0.25) 55%, transparent 80%);
  }

  /* --- Badges (top) ----------------------------------------------------- */
  .piece-top {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
  }
  .piece-kind,
  .piece-cat {
    padding: 0.3rem 0.6rem;
    border-radius: 100px;
    /* Pinned light-on-dark: these sit on the art, which is dark in both
       themes, so they must not follow the theme tokens. */
    border: 1px solid rgb(255 255 255 / 0.28);
    background: rgb(0 0 0 / 0.35);
    color: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
  }
  .piece-kind--own {
    border-color: color-mix(in srgb, var(--color-accent-on-dark) 55%, transparent);
    color: var(--color-accent-on-dark);
  }

  /* --- Body ------------------------------------------------------------- */
  .piece-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .piece-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: rgb(255 255 255 / 0.6);
  }

  .piece-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: calc(760 + var(--type-display-weight, 0));
    font-stretch: 108%;
    letter-spacing: calc(-0.024em + var(--type-display-track, 0em));
    line-height: 1.1;
    font-size: calc(clamp(1.35rem, 2.6vw, 1.75rem) * var(--type-display-scale, 1));
    text-wrap: balance;
    color: #f4f4f2;
    transition: color 0.2s ease;
  }
  @media (min-width: 700px) {
    .piece--wide .piece-title {
      font-size: calc(clamp(1.75rem, 3.2vw, 2.5rem) * var(--type-heading-scale, 1));
    }
  }
  .piece--linked:hover .piece-title {
    color: var(--color-accent-on-dark);
  }

  .piece-blurb {
    margin: 0;
    max-width: 46ch;
    font-size: calc(0.9rem * var(--type-body-scale, 1));
    line-height: 1.55;
    color: rgb(255 255 255 / 0.74);
  }

  .piece-tools {
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: rgb(255 255 255 / 0.5);
  }

  .piece-more {
    margin-top: 0.35rem;
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: var(--color-accent-on-dark);
  }
  .piece-more span {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .piece--linked:hover .piece-more span {
    transform: translateX(4px);
  }
</style>
