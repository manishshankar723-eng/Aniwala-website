---
import type { Piece } from '../lib/pieces';
import { categoryBySlug } from '../lib/workCategories';
import { getUiCopy } from '../lib/studio';

/**
 * One portfolio tile.
 *
 * Image-led rather than text-led: a portfolio is scanned, not read, so the
 * art gets the whole tile and the metadata sits on a scrim over the bottom
 * of it. The card that reads the work back to you in a paragraph is
 * `CaseCard` — this one's job is to make you want to click.
 *
 * NOT A LINK, ever. It used to become one when the piece named a case study,
 * and the tile carried a "read the case study" line. That was the portfolio
 * selling the writing about the work instead of the work: somebody browsing a
 * discipline wants the next picture, not an essay, and the case studies have
 * their own page and their own cards for the reader who does want one.
 *
 * So the tile is the media and nothing else clickable — which also means the
 * image keeps its real alt text, rather than the empty alt it needed when a
 * heading inside an anchor was announcing the tile instead.
 */
interface Props {
  piece: Piece;
  /** Hide the discipline chip on pages that are already one discipline. */
  showCategory?: boolean;
}

const ui = await getUiCopy();

const { piece, showCategory = true } = Astro.props;
const { title, blurb, kind, client, year, tools, tint, video, sound, image, imageAlt, srcset } =
  piece;

/*
 * WHICH WIDTH THE BROWSER SHOULD PICK.
 *
 * Without `sizes` a browser assumes a srcset image fills the viewport and
 * takes the largest rung, which wastes bytes on a narrow tile; without
 * `srcset` at all — which is what this was — it takes the single `src` and
 * stretches it, which is the opposite problem and the one that was visible.
 *
 * A wide tile spans the row. A narrow one is half of it above 900px, where the
 * gallery goes to two columns, and the full width below.
 */
const sizes = piece.wide ? '100vw' : '(min-width: 900px) 50vw, 100vw';

/* Only a native <video> can be unmuted from here. Stream's player owns its own
   controls, so a toggle outside the iframe would have nothing to talk to. */
const canUnmute = sound && video?.kind === 'file';

const category = await categoryBySlug(piece.category);

/* Same rule the case study cards follow: a self-directed piece must never be
   read as commissioned work, so the client line only appears when there is a
   client distinct from us. */
const isStudioProject = kind === 'Studio project';

---

<article
  class:list={['piece', piece.wide && 'piece--wide', piece.fit === 'contain' && 'piece--contain']}
  style={`--tint:${tint}`}
  data-reveal
>
  <div class="piece-inner">
    {/*
      The piece itself, over its tint.

      A portfolio tile is the one card on this site whose whole job is the
      picture, so this is the most consequential of the three. Decorative in
      the markup for the usual reason — the tile's own title is right below it
      — except on a tile that is NOT a link, where there is no heading in an
      anchor to read instead and the alt text is all a screen reader has.
    */}
    <span class="piece-art" aria-hidden="true"></span>
    {image && (
      <img
        class="piece-img"
        src={image}
        srcset={srcset}
        sizes={sizes}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
      />
    )}
    {
      video?.kind === 'file' && (
        /*
          A direct file plays natively — no player, no iframe, no third party.
          The still is the POSTER, so the tile shows a frame of the work from
          the first paint rather than a black box while the video opens.

          Muted and playsinline are not preferences: without both, iOS refuses
          to autoplay and shows its own play button over the tile, which turns
          a gallery of moving work into a grid of paused videos.
        */
        <video
          class="piece-video"
          src={video.src}
          poster={image}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden={canUnmute ? undefined : 'true'}
          tabindex="-1"
        />
      )
    }
    {
      canUnmute && (
        /*
          Starts muted because it has to: no browser autoplays audio on a
          video nobody has touched, and there is no flag that changes it. So
          the tile plays silently and offers the sound rather than imposing
          it — which is also the kinder default on a page holding several.
        */
        <button class="piece-sound" type="button" data-sound aria-pressed="false">
          <span class="visually-hidden">Play sound</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path d="M8 2.5 4.8 5.2H2.4v5.6h2.4L8 13.5V2.5Z" />
            <path class="piece-sound-off" d="M10.4 6.1 12 7.7l1.6-1.6.9.9L12.9 8.6l1.6 1.6-.9.9L12 9.5l-1.6 1.6-.9-.9 1.6-1.6-1.6-1.6.9-.9Z" />
            <path class="piece-sound-on" d="M10.6 5.6a3.4 3.4 0 0 1 0 4.8l-.9-.9a2.1 2.1 0 0 0 0-3l.9-.9Zm1.8-1.8a6 6 0 0 1 0 8.4l-.9-.9a4.7 4.7 0 0 0 0-6.6l.9-.9Z" />
          </svg>
        </button>
      )
    }
    {
      video?.kind === 'stream' && (
        /*
          Stream carries its own player, so this is an iframe. Over the still,
          not instead of it: the poster stays underneath and the player fades
          in on top once it has something to draw.

          `loading="lazy"` is right here and wrong on the tools marquee, and
          the difference is that this grid holds still — a tile below the fold
          is genuinely not needed yet, and an iframe is an order of magnitude
          heavier than the few KB of SVG that marquee defers.
        */
        <iframe
          class="piece-video"
          src={`${video.src}?autoplay=true&loop=true&muted=true&controls=false&preload=metadata${image ? `&poster=${encodeURIComponent(image)}` : ''}`}
          title={title}
          loading="lazy"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen
          tabindex="-1"
        />
      )
    }
    <span class="piece-scrim" aria-hidden="true"></span>

    <span class="piece-top">
      <span class:list={['piece-kind', isStudioProject && 'piece-kind--own']}>{kind}</span>
      {
        showCategory && category && (
          <span class="piece-cat">{category.title}</span>
        )
      }
    </span>

    <span class="piece-body">
      <span class="piece-meta">
        {!isStudioProject && <span>{client}</span>}
        <span>{year}</span>
      </span>

      <h3 class="piece-title">{title}</h3>
      <p class="piece-blurb">{blurb}</p>

      {
        tools.length > 0 && (
          <span class="piece-tools">{tools.join(' · ')}</span>
        )
      }

    </span>
  </div>
</article>

{
  canUnmute && (
    <script>
      /*
        One listener per button, scoped to its own card. Delegating from the
        document would be fewer listeners and would also mean a gallery of
        forty tiles shares one handler that has to work out which video it
        meant — the bug where every tile unmutes at once.

        The button is the only thing that ever unmutes: nothing here starts
        audio on its own, so a visitor is never surprised by sound.
      */
      for (const btn of document.querySelectorAll('.piece-sound[data-sound]')) {
        const card = btn.closest('.piece');
        const video = card?.querySelector('video');
        if (!video) continue;

        btn.addEventListener('click', () => {
          const wantSound = (video as HTMLVideoElement).muted;

          /* Silence every OTHER tile first. Two videos talking over each
             other is not a state anybody chose, and it is the obvious way
             to arrive at it on a page of them. */
          if (wantSound) {
            for (const other of document.querySelectorAll<HTMLVideoElement>('.piece video')) {
              if (other !== video) other.muted = true;
            }
            for (const otherBtn of document.querySelectorAll('.piece-sound[data-sound]')) {
              if (otherBtn !== btn) otherBtn.setAttribute('aria-pressed', 'false');
            }
          }

          (video as HTMLVideoElement).muted = !wantSound;
          btn.setAttribute('aria-pressed', String(wantSound));
          const label = btn.querySelector('.visually-hidden');
          if (label) label.textContent = wantSound ? 'Mute' : 'Play sound';
        });
      }
    </script>
  )
}

<style>
  .piece {
    position: relative;
    isolation: isolate;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .piece--linked:hover {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-line));
    transform: translateY(-2px);
  }

  .piece-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 20rem;
    height: 100%;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  @media (min-width: 700px) {
    .piece-inner {
      min-height: 24rem;
    }
    /* Both, deliberately. The portfolio index still lays these out in a
       grid and the discipline gallery in a flex row; each parent ignores
       the property meant for the other, so one card works in both without
       the card having to know which it is in. */
    .piece--wide {
      grid-column: span 2;
      flex-basis: 100%;
    }
    .piece--wide .piece-inner {
      min-height: 28rem;
      padding: clamp(1.75rem, 3vw, 2.75rem);
    }
  }

  /* --- Art ------------------------------------------------------------- */
  .piece-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 90% 70% at 30% 20%, hsl(var(--tint) / 0.85), transparent 70%),
      linear-gradient(160deg, hsl(var(--tint) / 0.55), #0b0c10 75%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Bottom-RIGHT, opposite the title block, so it never lands on the words.
     Always visible rather than revealed on hover: a control a visitor cannot
     see is a control they do not know they have, and on a touch screen there
     is no hover to reveal it with. */
  .piece-sound {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(0 0 0 / 0.55);
    color: #f4f4f2;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .piece-sound:hover,
  .piece-sound:focus-visible {
    background: rgb(0 0 0 / 0.8);
    border-color: rgb(255 255 255 / 0.5);
  }
  .piece-sound svg {
    width: 1rem;
    height: 1rem;
  }
  /* The icon states the ACTION, not the status: muted shows a speaker with a
     cross (press to hear), unmuted shows waves (press to silence). */
  .piece-sound .piece-sound-on {
    display: none;
  }
  .piece-sound[aria-pressed='true'] .piece-sound-off {
    display: none;
  }
  .piece-sound[aria-pressed='true'] .piece-sound-on {
    display: inline;
  }

  /* The player, over the poster — native <video> or Stream's iframe, same box
     either way, so the card does not care which it got. */
  .piece-video {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    /* Decorative motion, not a control surface: the tile is not a link and
       the player has no chrome, so nothing here should take a tab stop. */
    pointer-events: none;
  }

  /*
   * SHOW THE WHOLE PICTURE.
   *
   * `cover` is the default and fills the tile, cutting whatever does not fit —
   * which is right for a render with room around the subject and wrong for a
   * character sheet, where the crop goes straight through the thing being
   * judged. `contain` fits the image inside the box instead and lets the tint
   * show around it.
   *
   * The video gets the same treatment, so a tile that has both does not crop
   * one and letterbox the other.
   *
   * `object-position: center` is explicit rather than inherited: with
   * `contain` the spare space is split evenly, which is the only arrangement
   * that looks deliberate when the tiles either side are filled.
   */
  .piece--contain .piece-img,
  .piece--contain .piece-video {
    object-fit: contain;
    object-position: center;
  }

  .piece-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .piece--linked:hover .piece-img {
    transform: scale(1.05);
  }
  .piece--linked:hover .piece-art {
    transform: scale(1.06);
  }
  /* The scrim is what makes white type legible over art we do not control.
     It is a separate element rather than a ::after on the tile so it can sit
     between the art and the text in the stacking order. */
  .piece-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0.25) 55%, transparent 80%);
  }

  /* --- Badges (top) ----------------------------------------------------- */
  .piece-top {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
  }
  .piece-kind,
  .piece-cat {
    padding: 0.3rem 0.6rem;
    border-radius: 100px;
    /* Pinned light-on-dark: these sit on the art, which is dark in both
       themes, so they must not follow the theme tokens. */
    border: 1px solid rgb(255 255 255 / 0.28);
    background: rgb(0 0 0 / 0.35);
    color: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
  }
  .piece-kind--own {
    border-color: color-mix(in srgb, var(--color-accent-on-dark) 55%, transparent);
    color: var(--color-accent-on-dark);
  }

  /* --- Body ------------------------------------------------------------- */
  .piece-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .piece-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: rgb(255 255 255 / 0.6);
  }

  .piece-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: calc(760 + var(--type-display-weight, 0));
    font-stretch: 108%;
    letter-spacing: calc(-0.024em + var(--type-display-track, 0em));
    line-height: 1.1;
    font-size: calc(clamp(1.35rem, 2.6vw, 1.75rem) * var(--type-display-scale, 1));
    text-wrap: balance;
    color: #f4f4f2;
    transition: color 0.2s ease;
  }
  @media (min-width: 700px) {
    .piece--wide .piece-title {
      font-size: calc(clamp(1.75rem, 3.2vw, 2.5rem) * var(--type-heading-scale, 1));
    }
  }
  .piece--linked:hover .piece-title {
    color: var(--color-accent-on-dark);
  }

  .piece-blurb {
    margin: 0;
    max-width: 46ch;
    font-size: calc(0.9rem * var(--type-body-scale, 1));
    line-height: 1.55;
    color: rgb(255 255 255 / 0.74);
  }

  .piece-tools {
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: rgb(255 255 255 / 0.5);
  }

  .piece-more {
    margin-top: 0.35rem;
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: var(--color-accent-on-dark);
  }
  .piece-more span {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .piece--linked:hover .piece-more span {
    transform: translateX(4px);
  }
</style>
