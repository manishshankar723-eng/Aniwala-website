---
import { nav, cta } from '../config/nav';
import { legalName, legalLinks } from '../config/contact';
import { getContactDetails } from '../lib/studio';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();

const serviceParent = nav.find((i) => i.children);

/* Accounts with no URL yet render under `astro dev` so the row can be laid
   out, and are dropped from the production build. See config/contact.ts. */
const { email, addressLines, country, mapsUrl, publishedSocials: social } =
  await getContactDetails();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-lead">
      <p class="footer-eyebrow">Start a project</p>
      <a href={`mailto:${email}`} class="footer-mail">{email}</a>
      <p class="footer-note">
        Tell us the deadline first. We'll tell you honestly whether we can hit it.
      </p>
      <a href={cta.href} class="footer-cta">{cta.label}</a>

      {/*
        The postal address, which is doing more work here than it looks. For a
        studio nobody has heard of, a real street address is one of the few
        cheap signals that there is a building and people in it.
      */}
      <address class="footer-address">
        <span class="footer-address-label">Office</span>
        <a href={mapsUrl} rel="noopener">
          {addressLines.map((line) => (
            <span class="footer-address-line">{line}</span>
          ))}
          <span class="footer-address-line">{country}</span>
        </a>
      </address>
    </div>

    <nav class="footer-cols" aria-label="Footer">
      <div class="footer-col">
        <h2 class="footer-col-title">Studio</h2>
        <ul>
          {
            /* Items with children have their own column below, so listing them
               here too would print "Services" twice in the same footer. */
            nav
              .filter((i) => i.href && i.href !== '/' && !i.children)
              .map((i) => (
                <li>
                  <a href={i.href}>{i.label}</a>
                </li>
              ))
          }
        </ul>
      </div>

      <div class="footer-col">
        {/* The heading is the link to the services index, so the column does
            not need a row for its own parent page. */}
        <h2 class="footer-col-title">
          {serviceParent?.href ? (
            <a href={serviceParent.href} class="footer-col-title-link">Services</a>
          ) : (
            'Services'
          )}
        </h2>
        <ul>
          {
            serviceParent?.children?.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        social.length > 0 && (
          <div class="footer-col">
            <h2 class="footer-col-title">Follow</h2>
            <ul class="footer-social">
              {social.map((s) =>
                s.href ? (
                  <li>
                    <a href={s.href} rel="noopener">
                      <SocialIcon icon={s.icon} class="footer-social-icon" />
                      {s.label}
                    </a>
                  </li>
                ) : (
                  /* Dev only — no account yet. Shown so the row can be laid
                     out, never built into the live site. */
                  <li>
                    <span class="footer-social-todo" title="No URL set in config/contact.ts">
                      <SocialIcon icon={s.icon} class="footer-social-icon" />
                      {s.label}
                    </span>
                  </li>
                )
              )}
            </ul>
          </div>
        )
      }
    </nav>
  </div>

  <div class="footer-base">
    <span>© {year} {legalName}. All rights reserved.</span>
    <nav class="footer-legal" aria-label="Legal">
      {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-ground);
  }

  .footer-inner {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) var(--gutter) clamp(2rem, 5vw, 4rem);
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .footer-inner {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .footer-eyebrow {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-accent);
    margin: 0 0 1.25rem;
  }
  .footer-mail {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.03em;
    font-size: clamp(1.6rem, 5vw, 3rem);
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-mail:hover {
    color: var(--color-accent);
  }
  .footer-note {
    margin: 1.25rem 0 0;
    max-width: 40ch;
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .footer-cta {
    display: inline-flex;
    margin-top: 2rem;
    padding: 0.8rem 1.35rem;
    border-radius: 0.3rem;
    background: var(--color-cta);
    color: var(--color-cta-ink);
    font-family: var(--font-label);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .footer-cta:hover {
    background: var(--color-cta-hover);
  }

  /* --- Office address --------------------------------------------------- */
  .footer-address {
    display: block;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    font-style: normal;
  }
  .footer-address-label {
    display: block;
    margin-bottom: 0.7rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    color: var(--color-ink-faint);
  }
  .footer-address a {
    display: block;
    max-width: 34ch;
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-address a:hover {
    color: var(--color-accent);
  }
  /* Each line breaks where the address should break, rather than wherever
     the column width happens to land. */
  .footer-address-line {
    display: block;
  }

  .footer-cols {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    align-content: start;
  }
  .footer-col-title {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    color: var(--color-ink-faint);
    margin: 0 0 1rem;
  }
  /* Only the Services heading is a link — it stands in for the row the column
     used to carry for its own parent page. */
  .footer-col-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-col-title-link:hover {
    color: var(--color-accent);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer-col a {
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.15s ease;
  }
  .footer-col a:hover {
    color: var(--color-accent);
  }

  /* --- Social ----------------------------------------------------------- */
  .footer-social a,
  .footer-social-todo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
  }
  /* Only ever visible under `astro dev`: an account with no URL yet. Dimmed
     and plainly not a link, so it cannot be mistaken for a working one. */
  .footer-social-todo {
    color: var(--color-ink-faint);
    opacity: 0.45;
    cursor: help;
  }

  .footer-base {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 2.5rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    color: var(--color-ink-faint);
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .footer-legal a {
    color: var(--color-ink-faint);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-legal a:hover {
    color: var(--color-accent);
  }
</style>
