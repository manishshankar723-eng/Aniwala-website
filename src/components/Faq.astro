---
import type { Faq } from '../lib/studio';
import { getUiCopy } from '../lib/studio';

interface Props {
  items: Faq[];
  eyebrow?: string;
  title?: string;
  /**
   * Groups the accordion so only one answer is open at a time. Must be unique
   * per page. Browsers without exclusive-accordion support simply allow
   * several open at once, which is a perfectly fine fallback.
   */
  name?: string;
  /** Emit FAQPage structured data. Only ever true once per page. */
  schema?: boolean;
}

const ui = await getUiCopy();

const {
  items,
  eyebrow = ui.faqEyebrow,
  title = ui.faqTitle,
  name = 'faq',
  schema = true,
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

{
  items.length > 0 && (
    <section class="section section--bordered" id="faq">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">{eyebrow}</p>
        <h2 class="section-title">{title}</h2>
      </div>

      <div class="faq">
        {items.map((f) => (
          <details class="faq-item" name={name} data-reveal>
            <summary class="faq-q">
              <span>{f.q}</span>
              <span class="faq-mark" aria-hidden="true" />
            </summary>
            <div class="faq-a">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>

      {schema && (
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
      )}
    </section>
  )
}

<style>
  .faq {
    max-width: 62rem;
    border-top: 1px solid var(--color-line);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }

  .faq-q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.02rem, 2vw, 1.2rem);
    font-weight: 700;
    font-stretch: 106%;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q:hover,
  .faq-item[open] .faq-q {
    color: var(--color-accent);
  }

  /* Plus that becomes a minus. Two bars, one rotated — cheaper than an icon
     swap and it animates instead of popping. */
  .faq-mark {
    position: relative;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.35rem;
  }
  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s ease;
  }
  .faq-mark::after {
    transform: rotate(90deg);
  }
  .faq-item[open] .faq-mark::after {
    transform: rotate(0deg);
  }

  .faq-a {
    padding: 0 0 1.5rem;
    max-width: 68ch;
  }
  .faq-a p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  /* Slides open where supported; a hard cut everywhere else. */
  @supports (interpolate-size: allow-keywords) {
    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 0.3s ease,
        content-visibility 0.3s allow-discrete,
        opacity 0.3s ease;
    }
    .faq-item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }
</style>
