---
/* The timezone stays in code. IST observes no daylight saving, so a fixed
   offset is exact — and that is precisely why it must not be editable: point
   it at a timezone that does observe DST and every slot the widget offers is
   an hour wrong for half the year, silently. */
import { studioUtcOffsetMinutes, studioTimezone } from '../config/site';

import { supabaseConfigured } from '../lib/supabase';
import { getContactDetails, getBookingSettings } from '../lib/studio';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../config/site';

const { email } = await getContactDetails();

/* The wording rides on the same document as the settings: an editor
   changing the call lengths and an editor changing the button that confirms
   them are the same person doing the same job. */
const booking = await getBookingSettings();

const {
  hostName,
  hostRole,
  hostPhoto,
  callDurations,
  dayStart,
  dayEnd,
  stepMinutes,
  closedDays,
  bookingWindowDays,
  whatToExpect,
  enquiryTypes,
  weekdayLabels,
} = booking;

/* The shape the client script already expects, rebuilt from the flat fields
   the CMS stores. Keeping the old shape means the script below did not have
   to change. */
const workingHours = { start: dayStart, end: dayEnd, stepMinutes };

const configured = supabaseConfigured;
/* The middle option is preselected, which is why the Studio tells an editor
   to order them shortest to longest. */
const defaultDuration = callDurations[Math.floor(callDurations.length / 2)];
const initials = hostName
  .split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---

<section class="section section--bordered" id="book">
  <div class="section-head section-head--center" data-reveal>
    <p class="section-eyebrow">{booking.sectionEyebrow}</p>
    <h2 class="section-title">{booking.sectionTitle}</h2>
  </div>

  <div class="bk" id="bk" data-reveal>
    <!-- ── Panel 1: who and what ─────────────────────────────────── -->
    <aside class="bk-info">
      <div class="bk-avatar" aria-hidden="true">
        {
          hostPhoto ? (
            <img src={hostPhoto} alt="" />
          ) : (
            <span class="bk-initials">{initials}</span>
          )
        }
      </div>

      <p class="bk-host">{hostName}</p>
      <p class="bk-role">{hostRole}</p>

      <h3 class="bk-title">{booking.panelTitle}</h3>

      <div class="bk-meta">
        <div class="bk-row">
          <svg class="bk-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
            <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          <div class="bk-durations" role="radiogroup" aria-label={booking.a11yDurations}>
            {
              callDurations.map((d) => (
                <button
                  type="button"
                  class:list={['bk-dur', d === defaultDuration && 'is-on']}
                  data-duration={d}
                  role="radio"
                  aria-checked={d === defaultDuration ? 'true' : 'false'}
                >
                  {d} {booking.durationUnit}
                </button>
              ))
            }
          </div>
        </div>

        <div class="bk-row">
          <svg class="bk-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 14.5S13 10.4 13 6.6A5 5 0 0 0 3 6.6C3 10.4 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.4" />
          </svg>
          <span>{booking.meetingKind}</span>
        </div>

        <div class="bk-row bk-row--when" id="bk-when" hidden>
          <svg class="bk-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="2.25" y="3.25" width="11.5" height="10.5" rx="1.5" stroke="currentColor" stroke-width="1.4" />
            <path d="M2.25 6.5h11.5M5.5 2v2.5M10.5 2v2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          <span id="bk-when-text"></span>
        </div>

        <div class="bk-row bk-row--tz" id="bk-tzrow" hidden>
          <svg class="bk-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.4" />
            <path d="M8 1.75c1.7 1.8 2.6 4 2.6 6.25S9.7 12.45 8 14.25C6.3 12.45 5.4 10.25 5.4 8S6.3 3.55 8 1.75Z" stroke="currentColor" stroke-width="1.4" />
            <path d="M2.1 8h11.8" stroke="currentColor" stroke-width="1.4" />
          </svg>
          <span id="bk-tztext"></span>
        </div>
      </div>

      <p class="bk-expect-title">{booking.expectTitle}</p>
      <ol class="bk-expect">
        {whatToExpect.map((item) => <li>{item}</li>)}
      </ol>
    </aside>

    <!-- ── Panel 2: calendar ─────────────────────────────────────── -->
    <div class="bk-cal" id="bk-cal">
      <div class="bk-cal-head">
        <span class="bk-month" id="bk-month" aria-live="polite"></span>
        <div class="bk-cal-nav">
          <button type="button" class="bk-nav" id="bk-prev" aria-label={booking.a11yPrevMonth}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="bk-nav" id="bk-next" aria-label={booking.a11yNextMonth}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>

      {/* Sunday first, because the grid below is laid out Sunday-first.
          The Studio validates the list at exactly seven for that reason. */}
      <div class="bk-dow" aria-hidden="true">
        {weekdayLabels.map((d) => <span>{d}</span>)}
      </div>
      <div class="bk-grid" id="bk-grid" role="grid" aria-label={booking.a11yGrid}></div>

      <label class="bk-tz">
        <span class="bk-tz-label">{booking.timezoneLabel}</span>
        <select id="bk-tz" aria-label={booking.timezoneLabel}></select>
      </label>
    </div>

    <!-- ── Panel 3: slots ────────────────────────────────────────── -->
    <div class="bk-slots" id="bk-slots" hidden>
      <div class="bk-slots-head">
        <span class="bk-day" id="bk-day"></span>
        <div class="bk-hr" role="radiogroup" aria-label={booking.a11yTimeFormat}>
          <button type="button" class="bk-hr-btn is-on" data-hr="12" role="radio" aria-checked="true">12h</button>
          <button type="button" class="bk-hr-btn" data-hr="24" role="radio" aria-checked="false">24h</button>
        </div>
      </div>
      <div class="bk-slot-scroll" data-lenis-prevent>
        <div class="bk-slot-list" id="bk-slot-list" role="listbox" aria-label={booking.a11ySlots}></div>
      </div>
    </div>

    <!-- ── Step 2: details ───────────────────────────────────────── -->
    <div class="bk-details" id="bk-details" hidden>
      <div class="bk-details-head">
        <button type="button" class="bk-back" id="bk-back" aria-label={booking.a11yBack}>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <h3 class="bk-details-title">{booking.detailsTitle}</h3>
      </div>

      <form class="bk-form" id="bk-form" novalidate>
        <label class="bk-field">
          <span class="bk-label">{booking.nameLabel} *</span>
          <input
            type="text"
            name="Name"
            id="bk-name"
            placeholder={booking.namePlaceholder}
            required
            autocomplete="name"
          />
        </label>

        <label class="bk-field">
          <span class="bk-label">{booking.emailLabel} *</span>
          <input
            type="email"
            name="Email"
            id="bk-email"
            placeholder={booking.emailPlaceholder}
            required
            autocomplete="email"
          />
        </label>

        <label class="bk-field">
          <span class="bk-label">{booking.enquiryLabel}</span>
          <select name="Enquiry type">
            {enquiryTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>

        <label class="bk-field">
          <span class="bk-label">{booking.messageLabel}</span>
          <textarea name="Message" rows="4" placeholder={booking.messagePlaceholder}></textarea>
        </label>

        <!-- Bots fill hidden fields; humans never see this one. -->
        <input type="checkbox" name="botcheck" class="bk-hp" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="When" id="bk-f-when" />
        <input type="hidden" name="Duration" id="bk-f-duration" />
        <input type="hidden" name="Timezone" id="bk-f-tz" />
        <input type="hidden" name="subject" value="New call request — aniwala.com" />
        <input type="hidden" name="from_name" value="Aniwala website" />

        <p class="bk-msg" id="bk-msg" role="status" aria-live="polite"></p>

        <div class="bk-actions">
          <button type="submit" class="bk-submit" id="bk-submit">{booking.submitLabel}</button>
        </div>

        {
          !configured && (
            <p class="bk-warn">
              <strong>Not connected yet.</strong> Add your Supabase project URL and anon
              key to <code>src/config/site.ts</code>, and run{' '}
              <code>supabase/schema.sql</code> in the Supabase SQL editor. Until then
              this will not submit, so no enquiry is silently lost.
            </p>
          )
        }
      </form>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    cfg: {
      configured,
      // Passed through rather than imported: define:vars makes this script
      // inline, and inline scripts are not bundled, so `import` would not
      // resolve at runtime. The anon key is public by design — see
      // supabase/schema.sql for why that is safe.
      supabaseUrl: SUPABASE_URL,
      supabaseKey: SUPABASE_ANON_KEY,
      durations: callDurations,
      defaultDuration,
      hours: workingHours,
      studioOffset: studioUtcOffsetMinutes,
      studioTz: studioTimezone,
      closedDays,
      windowDays: bookingWindowDays,
      // The inline script cannot import, so the address is passed through.
      email,
      /* Everything the script writes into the page after load. Passed
         through for the same reason: an inline script is not bundled, so
         `import` would not resolve at runtime. */
      copy: {
        slotNext: booking.slotNextLabel,
        noSlots: booking.noSlots,
        submitLabel: booking.submitLabel,
        submitBusy: booking.submitBusy,
        errName: booking.errName,
        errEmail: booking.errEmail,
        errNotConfigured: booking.errNotConfigured,
        errSendFailed: booking.errSendFailed,
        errUnreachable: booking.errUnreachable,
        doneTitle: booking.doneTitle,
        doneBody: booking.doneBody,
      },
    },
  }}
>
  window.__aniwalaBooking = cfg;
</script>

<script>
  import { fill, fillHtml } from '../lib/copy';

  function initBooking() {
    const found = document.getElementById('bk');
    if (!found) return;
    /* Bound to its own const because the hoisted `function` declarations
       further down defeat TypeScript's narrowing of `found` — it cannot prove
       a hoisted function is not called before the guard above ran. */
    const root: HTMLElement = found;
    const cfg = (window as any).__aniwalaBooking;
    const copy = cfg.copy;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const grid = $('bk-grid');
    const monthEl = $('bk-month');
    const prev = $<HTMLButtonElement>('bk-prev');
    const next = $<HTMLButtonElement>('bk-next');
    const tzSel = $<HTMLSelectElement>('bk-tz');
    const slotsPanel = $('bk-slots');
    const slotList = $('bk-slot-list');
    const dayEl = $('bk-day');
    const calPanel = $('bk-cal');
    const details = $('bk-details');
    const form = $<HTMLFormElement>('bk-form');
    const msg = $('bk-msg');
    const submit = $<HTMLButtonElement>('bk-submit');

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const maxDate = new Date(today);
    maxDate.setDate(maxDate.getDate() + cfg.windowDays);

    let view = new Date(today.getFullYear(), today.getMonth(), 1);
    let chosenDate: Date | null = null;
    let chosenSlot: Date | null = null;
    let duration: number = cfg.defaultDuration;
    let hour12 = true;
    let tz = Intl.DateTimeFormat().resolvedOptions().timeZone || cfg.studioTz;

    const iso = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    const openDay = (d: Date) =>
      d >= today && d <= maxDate && !cfg.closedDays.includes(d.getDay());

    /**
     * Turn "09:00 studio time on this date" into a real instant.
     * The studio offset is fixed (IST never shifts for DST), so subtracting
     * it from a UTC construction is exact. A DST timezone would need a
     * proper library here.
     */
    function slotInstant(date: Date, hhmm: string) {
      const [h, m] = hhmm.split(':').map(Number);
      return new Date(
        Date.UTC(date.getFullYear(), date.getMonth(), date.getDate(), h, m) -
          cfg.studioOffset * 60000
      );
    }

    function slotsFor(date: Date) {
      const out: Date[] = [];
      const [sh, sm] = cfg.hours.start.split(':').map(Number);
      const [eh, em] = cfg.hours.end.split(':').map(Number);
      const startMin = sh * 60 + sm;
      const endMin = eh * 60 + em;
      const now = Date.now();

      for (let t = startMin; t + duration <= endMin; t += cfg.hours.stepMinutes) {
        const hhmm = `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;
        const inst = slotInstant(date, hhmm);
        // Never offer a slot that has already passed today.
        if (inst.getTime() > now) out.push(inst);
      }
      return out;
    }

    const fmtTime = (d: Date) =>
      d.toLocaleTimeString('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12 });

    const fmtDayShort = (d: Date) =>
      d.toLocaleDateString('en-GB', { timeZone: tz, weekday: 'short', day: 'numeric' });

    const fmtLongDate = (d: Date) =>
      d.toLocaleDateString('en-GB', { timeZone: tz, day: 'numeric', month: 'long', year: 'numeric' });

    // ---------- timezone picker ----------
    function buildTimezones() {
      let zones: string[] = [];
      try {
        zones = (Intl as any).supportedValuesOf?.('timeZone') ?? [];
      } catch {
        /* older browser */
      }
      if (!zones.length) zones = [cfg.studioTz, 'UTC', 'Europe/London', 'America/New_York', 'Asia/Tokyo'];
      if (!zones.includes(tz)) zones.unshift(tz);
      tzSel.innerHTML = zones
        .map((z) => `<option value="${z}"${z === tz ? ' selected' : ''}>${z.replace(/_/g, ' ')}</option>`)
        .join('');
    }

    tzSel.addEventListener('change', () => {
      tz = tzSel.value;
      if (chosenDate) renderSlots();
      renderWhen();
    });

    // ---------- calendar ----------
    function renderCal() {
      monthEl.innerHTML = `${view.toLocaleDateString('en-GB', { month: 'long' })} <span>${view.getFullYear()}</span>`;

      const firstDow = new Date(view.getFullYear(), view.getMonth(), 1).getDay(); // Sunday-first
      const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();

      let html = '';
      for (let i = 0; i < firstDow; i++) html += '<span class="bk-pad"></span>';
      for (let day = 1; day <= days; day++) {
        const d = new Date(view.getFullYear(), view.getMonth(), day);
        const ok = openDay(d) && slotsFor(d).length > 0;
        const on = chosenDate && iso(chosenDate) === iso(d);
        html += `<button type="button" class="bk-day-btn${on ? ' is-on' : ''}${ok ? ' is-open' : ''}"
                   data-date="${iso(d)}" ${ok ? '' : 'disabled'} aria-pressed="${on ? 'true' : 'false'}"
                   aria-label="${d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' })}">
                   ${day}${ok ? '<i class="bk-dot" aria-hidden="true"></i>' : ''}</button>`;
      }
      grid.innerHTML = html;

      prev.disabled = view.getFullYear() === today.getFullYear() && view.getMonth() === today.getMonth();
      next.disabled = view.getFullYear() === maxDate.getFullYear() && view.getMonth() === maxDate.getMonth();
    }

    grid.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.bk-day-btn');
      if (!btn || btn.disabled) return;
      const [y, m, d] = btn.dataset.date!.split('-').map(Number);
      chosenDate = new Date(y, m - 1, d);
      chosenSlot = null;
      renderCal();
      renderSlots();
      renderWhen();
    });

    prev.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      renderCal();
    });
    next.addEventListener('click', () => {
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      renderCal();
    });

    // ---------- slots ----------
    function renderSlots() {
      if (!chosenDate) {
        slotsPanel.hidden = true;
        root.classList.remove('has-slots');
        return;
      }
      slotsPanel.hidden = false;
      root.classList.add('has-slots');
      dayEl.textContent = fmtDayShort(slotInstant(chosenDate, cfg.hours.start));

      const list = slotsFor(chosenDate);
      slotList.innerHTML = list.length
        ? list
            .map((inst) => {
              const on = chosenSlot && chosenSlot.getTime() === inst.getTime();
              return `<div class="bk-slot${on ? ' is-on' : ''}" data-ts="${inst.getTime()}">
                        <button type="button" class="bk-slot-time" role="option" aria-selected="${on ? 'true' : 'false'}">${fmtTime(inst)}</button>
                        <button type="button" class="bk-slot-next">${fillHtml(copy.slotNext)}</button>
                      </div>`;
            })
            .join('')
        : `<p class="bk-none">${fillHtml(copy.noSlots)}</p>`;
    }

    slotList.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const row = target.closest<HTMLElement>('.bk-slot');
      if (!row) return;

      if (target.closest('.bk-slot-next')) {
        goToDetails();
        return;
      }
      chosenSlot = new Date(Number(row.dataset.ts));
      renderSlots();
      renderWhen();
    });

    // ---------- left panel summary ----------
    function renderWhen() {
      const whenRow = $('bk-when');
      const whenText = $('bk-when-text');
      const tzRow = $('bk-tzrow');
      const tzText = $('bk-tztext');

      tzRow.hidden = false;
      tzText.textContent = tz.replace(/_/g, ' ');

      if (!chosenSlot) {
        whenRow.hidden = true;
        return;
      }
      const end = new Date(chosenSlot.getTime() + duration * 60000);
      whenRow.hidden = false;
      whenText.textContent = `${fmtTime(chosenSlot)} - ${fmtTime(end)}, ${fmtLongDate(chosenSlot)}`;
    }

    // ---------- duration ----------
    document.querySelectorAll<HTMLButtonElement>('.bk-dur').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.bk-dur').forEach((b) => {
          b.classList.remove('is-on');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('is-on');
        btn.setAttribute('aria-checked', 'true');
        duration = Number(btn.dataset.duration);
        // A longer call can push the last slot past closing time.
        chosenSlot = null;
        renderCal();
        renderSlots();
        renderWhen();
      });
    });

    // ---------- 12h / 24h ----------
    document.querySelectorAll<HTMLButtonElement>('.bk-hr-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.bk-hr-btn').forEach((b) => {
          b.classList.remove('is-on');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('is-on');
        btn.setAttribute('aria-checked', 'true');
        hour12 = btn.dataset.hr === '12';
        renderSlots();
        renderWhen();
      });
    });

    // ---------- step switching ----------
    function goToDetails() {
      if (!chosenSlot) return;
      calPanel.hidden = true;
      slotsPanel.hidden = true;
      details.hidden = false;
      root.classList.add('is-details');
      root.classList.remove('has-slots');

      const end = new Date(chosenSlot.getTime() + duration * 60000);
      $<HTMLInputElement>('bk-f-when').value =
        `${fmtTime(chosenSlot)} - ${fmtTime(end)}, ${fmtLongDate(chosenSlot)}`;
      $<HTMLInputElement>('bk-f-duration').value = `${duration} minutes`;
      $<HTMLInputElement>('bk-f-tz').value = tz;
      $<HTMLInputElement>('bk-name').focus();
    }

    $('bk-back').addEventListener('click', () => {
      details.hidden = true;
      calPanel.hidden = false;
      slotsPanel.hidden = false;
      root.classList.remove('is-details');
      root.classList.add('has-slots');
    });

    // ---------- submit ----------
    const fail = (t: string) => {
      msg.textContent = t;
      msg.className = 'bk-msg is-error';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.textContent = '';
      msg.className = 'bk-msg';

      const name = $<HTMLInputElement>('bk-name').value.trim();
      const email = $<HTMLInputElement>('bk-email').value.trim();
      if (!name) return fail(copy.errName);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail(copy.errEmail);
      if (!cfg.configured) return fail(copy.errNotConfigured);

      submit.disabled = true;
      submit.textContent = copy.submitBusy;
      try {
        const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

        // Column names, not form field names. Anything not in the table is
        // dropped rather than sent, so a stray hidden input cannot make
        // PostgREST reject the whole insert.
        const res = await fetch(`${cfg.supabaseUrl.replace(/\/$/, '')}/rest/v1/enquiries`, {
          method: 'POST',
          headers: {
            apikey: cfg.supabaseKey,
            Authorization: `Bearer ${cfg.supabaseKey}`,
            'Content-Type': 'application/json',
            // Anon has no SELECT policy on enquiries, so asking PostgREST to
            // echo the row back would fail the request after a successful
            // insert. Minimal returns nothing but the status.
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({
            name,
            email,
            company: data.company || null,
            enquiry_type: data.enquiry_type || null,
            message: data.message || null,
            duration_mins: Number(data.duration) || null,
            slot_label: $<HTMLInputElement>('bk-f-when').value || null,
            visitor_tz: data.timezone || null,
            source_path: location.pathname,
          }),
        });

        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const j = await res.json();
            if (j?.message) detail = j.message;
          } catch {
            /* non-JSON error body — the status is all we have */
          }
          throw new Error(detail);
        }

        /* Both values came out of a form, so the sentence and everything
           filled into it are escaped. `{{when}}` is left for the bold below,
           substituted from a string already put through the same escaping. */
        const slot = `<strong>${fillHtml('{{v}}', { v: $<HTMLInputElement>('bk-f-when').value })}</strong>`;

        details.innerHTML = `<div class="bk-done">
            <h3>${fillHtml(copy.doneTitle)}</h3>
            <p>${fillHtml(copy.doneBody, { name }).replace('{{when}}', () => slot)}</p>
          </div>`;
      } catch (err) {
        fail(
          err instanceof Error && err.message
            ? fill(copy.errSendFailed, { error: err.message, email: cfg.email })
            : fill(copy.errUnreachable, { email: cfg.email })
        );
      } finally {
        if (submit.isConnected) {
          submit.disabled = false;
          submit.textContent = copy.submitLabel;
        }
      }
    });

    buildTimezones();
    renderCal();
    renderWhen();
  }

