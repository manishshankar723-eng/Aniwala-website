---
import { getWorkCategories, categoryHref } from '../lib/workCategories';
import { pieceCounts } from '../lib/pieces';
import { getUiCopy } from '../lib/studio';

/**
 * The discipline filter on the portfolio.
 *
 * Real links to real pages rather than a JavaScript filter — the same choice
 * `CategoryBar` makes on the blog, and for the same reasons: every discipline
 * stays crawlable, linkable and working before the bundle loads. It also
 * matters here specifically, because the homepage work tiles already point
 * straight at these URLs.
 */
interface Props {
  /** Category slug currently being viewed, or undefined on the index. */
  active?: string;
}

const { active } = Astro.props;

const ui = await getUiCopy();
const workCategories = await getWorkCategories();
const counts = await pieceCounts();
const total = Object.values(counts).reduce((n, c) => n + c, 0);
---

<nav class="chip-row filter-row" aria-label={ui.filterByDiscipline} data-reveal>
  <a
    href="/portfolio/"
    class:list={['chip chip--filter', !active && 'is-active']}
    aria-current={!active ? 'page' : undefined}
  >
    {ui.barAllWork} <span class="chip-n">{total}</span>
  </a>

  {
    workCategories.map((c) => {
      const n = counts[c.slug] ?? 0;
      const isActive = active === c.slug;

      /*
        An empty discipline still renders, AND STILL LINKS. It used to render
        as a plain <span>, on the reasoning that there is nothing to show yet
        — but the category page is not a gallery, it is a page about a craft
        we offer, with its own intro copy, its own hero and its own entry in
        the sitemap. Making it unreachable from here did not hide an empty
        gallery; it stranded a real page.

        The damage was measurable. With three disciplines unpublished, this
        bar dropped /portfolio/character-design/, /portfolio/concept-art/ and
        /portfolio/motion-graphics/ to exactly ONE inbound internal link each
        on the whole site — the homepage grid, which links all six — while
        the three with pieces had seven. The portfolio index did not link to
        half its own children, and neither did any sibling category page.

        So the count is still shown, `is-empty` still dims it, and the link is
        still a link. A visitor who clicks one gets a page that explains the
        discipline and says the gallery is coming, which is a better answer
        than a chip that does not respond to a click.
      */
      return (
        <a
          href={isActive ? '/portfolio/' : categoryHref(c.slug)}
          class:list={['chip chip--filter', isActive && 'is-active', n === 0 && 'is-empty']}
          aria-current={isActive ? 'page' : undefined}
          title={isActive ? ui.barClearFilter : undefined}
        >
          {c.title} <span class="chip-n">{n}</span>
          {isActive && <span class="chip-clear" aria-hidden="true" />}
        </a>
      );
    })
  }
</nav>

<style>
  /* Chip, row and the × on a selected one are all in global.css — this
     bar and the one on the other side of the site are the same object.
     Only the space under the row is local. */
  .filter-row {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
</style>
