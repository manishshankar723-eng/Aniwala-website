---
import { getPostCategories } from '../lib/posts';
import { getUiCopy } from '../lib/studio';

/**
 * The filter row on the blog. Real links to real pages rather than a
 * JavaScript filter, so every category is crawlable, linkable and works
 * before the bundle loads.
 */
interface Props {
  /** Category name currently being viewed, or undefined on the index. */
  active?: string;
  /** Post count per category, so an empty one can be dimmed rather than lie. */
  counts: Record<string, number>;
  /**
   * A filter that is not a category — a tag or an archive month. Rendered as
   * one extra selected chip so those pages show what is filtering them and
   * can clear it, exactly like a category can.
   */
  extraActive?: string;
}

const ui = await getUiCopy();
const categories = await getPostCategories();

const { active, counts, extraActive } = Astro.props;
const total = Object.values(counts).reduce((n, c) => n + c, 0);

/*
  "All" is only the current view on /blog/ itself. Deriving it from the path
  rather than from `active` being undefined matters on the tag and archive
  pages: something IS filtered there, just not a category, and lighting up
  "All" would tell the visitor the opposite.
*/
const isUnfiltered = Astro.url.pathname === '/blog/';
---

<nav class="chip-row filter-row" aria-label={ui.filterByCategory} data-reveal>
  <a
    href="/blog/"
    class:list={['chip chip--filter', isUnfiltered && 'is-active']}
    aria-current={isUnfiltered ? 'page' : undefined}
  >
    {ui.barAllCategories} <span class="chip-n">{total}</span>
  </a>

  {
    categories.map(({ title: c, slug }) => {
      const n = counts[c] ?? 0;
      return n === 0 ? (
        <span class="chip chip--filter is-empty" aria-disabled="true">
          {c} <span class="chip-n">0</span>
        </span>
      ) : (
        <a
          href={active === c ? '/blog/' : `/blog/category/${slug}/`}
          class:list={['chip chip--filter', active === c && 'is-active']}
          aria-current={active === c ? 'page' : undefined}
          title={active === c ? ui.barClearFilter : undefined}
        >
          {c} <span class="chip-n">{n}</span>
          {active === c && <span class="chip-clear" aria-hidden="true" />}
        </a>
      );
    })
  }

  {
    extraActive && (
      <a href="/blog/" class="chip chip--filter is-active" title={ui.barClearFilter}>
        {extraActive} <span class="chip-clear" aria-hidden="true" />
      </a>
    )
  }
</nav>

<style>
  /* Chip, row and the × on a selected one are all in global.css — this
     bar and the one on the other side of the site are the same object.
     Only the space under the row is local. */
  .filter-row {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
</style>
