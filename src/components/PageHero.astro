---
/**
 * The hero for inner pages — services, blog, anything that is not the
 * homepage. Deliberately NOT the full-bleed video hero: that one fills the
 * window and is an arrival. This is a band, and it carries the top offset for
 * the fixed header and the announcement strip itself.
 *
 * ONE SHAPE, EVERY PAGE. There used to be two: a `compact` flag cut the title
 * from 6.5rem to 4rem on the pages that lead into a grid, and a per-page
 * `tint` gave each its own colour. Between them, `/about` and `/blog` looked
 * like they came off different sites — same font, forty percent apart in size,
 * one blue and one teal. A house style that every page opts out of is not a
 * house style, so both knobs are gone and the size and wash below are the
 * whole vocabulary.
 *
 * Unlike VideoHero it follows the theme tokens rather than pinning to
 * light-on-dark. There is no dark video underneath to force the issue, and a
 * black band across the top of every page fights light mode. The header sits
 * transparently on top of this and follows the theme for the same reason —
 * see `is-overlay--page` in Header.astro.
 */
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  /** One or two sentences. Longer than that belongs in the page body. */
  lead?: string;
  /** Trail shown above the title. The last item renders as plain text. */
  crumbs?: Crumb[];
  /** Small caps row under the lead — dates, categories, reading time. */
  meta?: string[];
  /**
   * Optional background artwork, from the CMS. Resolve it with
   * `heroArtwork()` in `lib/artwork.ts` rather than reading a field directly:
   * that is what falls back to the site-wide picture when a page has none.
   *
   * Layered UNDER the tint wash rather than replacing it, so the heading
   * keeps its contrast over whatever gets uploaded. Without that the page
   * would be one bright still away from unreadable white-on-white, decided by
   * whoever last dragged a file in.
   */
  image?: { src: string; srcset: string; alt: string };
}

import { getUiCopy } from '../lib/studio';
import { ldJson } from '../lib/copy';
import { displayWidth } from '../config/displayMetrics';

const ui = await getUiCopy();

const { eyebrow, title, lead, crumbs = [], meta = [], image } = Astro.props;

/**
 * How wide this headline is at 1em, so CSS can pick a size that fits it on
 * one line. See `config/displayMetrics.ts`, and the note on `.page-hero-title`
 * for what the size ends up being.
 */
const titleWidth = displayWidth(title).toFixed(3);

/**
 * The same trail, as structured data.
 *
 * The visible crumbs told a reader where they were and told a search engine
 * nothing — so results for an inner page showed a bare URL where they could
 * have shown "Home › Services › 3D Art". This is the one piece of structured
 * data that is pure duplication of visible markup, which is exactly the
 * condition Google asks for: the trail it describes is the trail on the page.
 *
 * Only when there is a trail worth describing. A single crumb is not a path,
 * and `position` is 1-based because the vocabulary says so.
 */
const crumbSchema =
  crumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.label,
          /* The last crumb is the page you are on. Omitting its `item` is
             what marks it as the current page rather than a link to
             somewhere else. */
          ...(crumb.href && i < crumbs.length - 1
            ? { item: new URL(crumb.href, Astro.site).href }
            : {}),
        })),
      }
    : null;
---

<section class:list={['page-hero', image && 'page-hero--art']}>
  {
    /* Decorative: the heading beside it already says what the page is, so an
       alt here would only make a screen reader read the page twice. The alt
       an editor writes is used where the same image is content. */
    image && (
      <img
        class="page-hero-img"
        src={image.src}
        srcset={image.srcset}
        sizes="100vw"
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        decoding="async"
      />
    )
  }
  <div class="page-hero-wash" aria-hidden="true"></div>

  {crumbSchema && (
    <script type="application/ld+json" set:html={ldJson(crumbSchema)} is:inline />
  )}

  <div class="page-hero-inner">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label={ui.navBreadcrumb} data-reveal>
          <ol>
            {crumbs.map((c, i) => (
              <li>
                {c.href && i < crumbs.length - 1 ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  <span aria-current="page">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {eyebrow && <p class="page-hero-eyebrow" data-reveal data-reveal-delay="0.04">{eyebrow}</p>}

    <h1
      class="page-hero-title"
      style={`--title-w:${titleWidth}`}
      data-reveal
      data-reveal-delay="0.08"
    >
      {title}
    </h1>

    {
      lead && (
        <p class="page-hero-lead" data-reveal data-reveal-delay="0.14">
          {lead}
        </p>
      )
    }

    {
      meta.length > 0 && (
        <ul class="page-hero-meta" data-reveal data-reveal-delay="0.18">
          {meta.map((m) => (
            <li>{m}</li>
          ))}
        </ul>
      )
    }

    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    /* Clears the fixed header AND the announcement strip above it. The header
       is transparent over this band, so the offset is what stops the nav
       landing on the breadcrumb rather than above it. */
    padding-top: calc(var(--announce-h) + var(--header-h));

    /* The one tint the site uses, and the two knobs light mode turns down. A
       value here rather than a prop — see the note at the top of this file
       for what the per-page version cost. */
    --tint: 210 70% 22%;
    --tint-alpha: 0.5;
    --tint-accent: 12%;

    /*
      The opaque floor, ON THE SECTION rather than inside `.page-hero-wash`.

      It used to be the bottom layer of the wash, and since the wash paints
      over `.page-hero-img` — both sit at `z-index: -1`, so DOM order decides
      — an opaque layer there covered the background picture completely. The
      picture never appeared on any page that set one. Nobody had uploaded one
      yet, so it built, shipped, and looked exactly right.

      Down here it paints first (a stacking context's own background goes
      below its negative-z-index children), which leaves the wash free to be
      what its name says: translucent, over the picture.
    */
    background: linear-gradient(to bottom, var(--color-surface), var(--color-ground) 92%);

    /* No picture, no floor — see `.page-hero--art`. */
    --floor: none;
  }

  /*
    With a picture behind it, the wash also has to carry a legibility floor.

    `--color-ground` is near-black in dark and near-white in light, so this one
    rule darkens or lightens as the theme needs, and the heading, the lead and
    the nav sitting transparently on top all get the same guarantee over
    whatever an editor uploaded.

    Three stops rather than a straight fall, because the thing most at risk is
    not the headline. That is display type at 6.5rem and survives almost
    anything; the NAV is 0.95rem and sits in the top few rem of this band, the
    weakest part of a top-to-bottom fade. So the floor starts heavy behind the
    header, thins out through the middle where the picture is actually worth
    seeing, and comes back at the foot so the section below starts on flat
    ground rather than mid-photograph.
  */
  .page-hero--art {
    --floor: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-ground) 80%, transparent) 0%,
      color-mix(in srgb, var(--color-ground) 52%, transparent) 26%,
      color-mix(in srgb, var(--color-ground) 86%, transparent) 100%
    );
  }

  /* Tint wash. Sits behind the content and fades out downward so the section
     that follows starts on flat ground rather than mid-gradient. */
  .page-hero-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        ellipse 70% 90% at 88% 0%,
        hsl(var(--tint) / var(--tint-alpha)),
        transparent 70%
      ),
      radial-gradient(
        ellipse 60% 80% at 0% 10%,
        color-mix(in srgb, var(--color-accent) var(--tint-accent), transparent),
        transparent 65%
      ),
      var(--floor);
  }

  /* Sits beneath the wash, which is what keeps the heading legible over an
     arbitrary upload. Dimmed for the same reason — a hero still is background,
     not the subject. */
  .page-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
    z-index: -1;
  }

  /* Light mode: the same tint at full strength turns the type unreadable, and
     the floor starts from the off-white rather than pure white. */
  :global(:root[data-theme='light']) .page-hero {
    --tint-alpha: 0.16;
    --tint-accent: 14%;
    background: linear-gradient(to bottom, var(--color-surface-2), var(--color-ground) 92%);
  }

  .page-hero-inner {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 7rem) var(--gutter) clamp(3rem, 6vw, 5rem);
    /* Makes `100cqw` below mean "the width this block gives its text" —
       its content box, so the gutter is already taken off. `100vw` would
       have been close but counts the scrollbar, and the headline sized
       from it would overflow by exactly that much. */
    container-type: inline-size;
  }

  /* --- Breadcrumb ---------------------------------------------------- */
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0;
    font-family: var(--font-label);
    font-size: calc(0.82rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.005em + var(--type-label-track, 0em));
    color: var(--color-ink-faint);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--color-ink-faint);
    opacity: 0.6;
  }
  .crumbs a {
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .crumbs a:hover {
    color: var(--color-accent);
  }
  .crumbs span {
    color: var(--color-ink-faint);
  }

  /* --- Type ---------------------------------------------------------- */
  .page-hero-eyebrow {
    font-family: var(--font-label);
    font-size: calc(0.95rem * var(--type-label-scale, 1));
    font-weight: calc(600 + var(--type-label-weight, 0));
    letter-spacing: calc(0.005em + var(--type-label-track, 0em));
    color: var(--color-accent);
    margin: 0 0 1.25rem;
  }

  /*
    ONE LINE, on every page.
  
    The old rule capped the headline at `max-width: 18ch` — about 1030px at
    full size — so a title wrapped when it passed that, regardless of how much
    room the page actually had. On a 1900px screen the hero offers 1819px, and
    "Notes from inside the pipeline." needs 1314px: it fit comfortably and
    broke anyway, while the shorter contact headline squeaked under the cap
    and did not. Two pages, same component, different shape, for no reason a
    reader could see.
  
    So the cap is gone and the SIZE gives way instead. `--title-w` is this
    headline's width at 1em (`config/displayMetrics.ts`), so `100cqw /
    var(--title-w)` is the exact size at which it fills the measure on one
    line. Take whichever is smaller, that or the normal size, and a short
    headline is unaffected while a long one shrinks just enough to fit.
  
    The `max()` is the floor. Below roughly 590px there is no size that both
    fits a long headline on one line and is still a heading, so the floor wins
    and it wraps — with `text-wrap: balance` to break it evenly when it does.
  
    `font-optical-sizing: none` is load bearing, not a detail. On `auto`, opsz
    follows font-size and the face draws up to 12.8% wider as text gets
    smaller — so shrinking to fit would widen the text it was fitting, and the
    calculation would be chasing itself. Pinned, the metrics table is exact.
  
    (`font-stretch: 115%` used to be here and did nothing: Bricolage's width
    axis stops at 100, so the browser clamped it and drew the default.)
  */
  .page-hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: calc(800 + var(--type-display-weight, 0));
    font-optical-sizing: none;
    letter-spacing: calc(-0.03em + var(--type-display-track, 0em));
    line-height: 1;
    font-size: max(
      calc(2.4rem * var(--type-display-scale, 1)),
      min(
        calc(clamp(2.4rem, 6.5vw, 6.5rem) * var(--type-display-scale, 1)),
        calc(100cqw / var(--title-w, 12))
      )
    );
    text-wrap: balance;
    color: var(--color-ink);
  }

  .page-hero-lead {
    margin: 1.75rem 0 0;
    max-width: 52ch;
    font-size: calc(clamp(1rem, 1.6vw, 1.15rem) * var(--type-heading-scale, 1));
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .page-hero-meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 1.75rem 0 0;
    padding: 0;
    font-family: var(--font-label);
    font-size: calc(0.82rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.005em + var(--type-label-track, 0em));
    color: var(--color-ink-faint);
  }
  .page-hero-meta li + li::before {
    content: '·';
    margin-right: 1rem;
    opacity: 0.6;
  }
</style>
