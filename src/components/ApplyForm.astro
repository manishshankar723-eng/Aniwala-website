---
/* The disciplines still come from code: the same list validates every role
   document, so one that stopped existing would leave live listings pointing
   at nothing. The bands, the notice periods and the "none of these" option
   are copy, and come from the CMS with the rest of the form's wording. */
import { DISCIPLINES } from '../config/disciplines';
import { getFlatRoles, type Role } from '../lib/roles';
import { getContactDetails, getCareersContent } from '../lib/studio';
import { fill, fillHtml, plural } from '../lib/copy';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../config/site';
import { supabaseConfigured } from '../lib/supabase';

/**
 * The application form. One form, two jobs.
 *
 * Most studio sites make you choose between an "Apply" button bolted to each
 * listing and a separate "we're not hiring but send something anyway" mailto.
 * The second one always looks like an afterthought, which is a shame, because
 * a speculative application from the right person is worth more than ten
 * against a listing — a seat here opens when a project lands, not when a plan
 * says it should, so the good ones nearly always arrive before the listing.
 *
 * So this is a single form with a mode switch. The fields that differ are the
 * ones that genuinely differ: applying to a listing needs to know WHICH
 * listing; applying without one needs to know what you would want to be doing
 * instead. Everything else — who you are, the link to the work, when you are
 * free — is identical and is asked once.
 *
 * Both modes land in the same `applications` table with a `kind` column, so
 * there is one place to read and one export to take.
 *
 * NO FILE UPLOAD, deliberately. Accepting a CV would mean a public-insert
 * Storage bucket sitting behind an anon key that ships in the bundle, which is
 * an open door for anyone who finds it. Links cost the applicant nothing —
 * everyone in this industry already keeps a reel on a URL — and the offer to
 * email an attachment is right there for anyone who would rather.
 */
interface Props {
  /**
   * Set on a role page: locks the form to that role, drops the mode switch
   * and skips straight to the details. On the listing page it is left off and
   * the applicant chooses.
   */
  role?: Role;
  /** Overrides the section heading. */
  eyebrow?: string;
  title?: string;
  lead?: string;
}

/*
 * The wording lives on `careersContent`, beside the rest of the careers page.
 *
 * Not on a document of its own, because this form renders in two places — the
 * listing page and the foot of every role page — and two copies of "we reply
 * within five working days" is how those two pages end up promising an
 * applicant two different things.
 */
const copy = await getCareersContent();

const { role, eyebrow = copy.applyEyebrow, title, lead } = Astro.props;

const openRoles = await getFlatRoles();
const { careersEmail } = await getContactDetails();

const locked = Boolean(role);
const configured = supabaseConfigured;

const heading =
  title ?? (locked ? fill(copy.applyTitleRole, { role: role!.title }) : copy.applyTitleOpen);
const intro = lead ?? (locked ? copy.applyLeadRole : copy.applyLeadOpen);

/* The studio inbox is a token rather than typed into the sentence, so the
   note here and the address in the footer cannot drift apart. */
const areas = [...DISCIPLINES, copy.applyAreaOther];

const mailLink = { careersEmail: { href: `mailto:${careersEmail}`, label: careersEmail } };
const altNote = fillHtml(copy.applyAltNote, {}, mailLink);

/* Per-role portfolio guidance, keyed by slug so the client script can swap
   the hint under the portfolio field the moment a role is chosen. It is the
   most useful sentence on any of these listings, and it should not be
   something you only find by opening the full page. */
const reelNotes = Object.fromEntries(openRoles.map((r) => [r.slug, r.reelNote]));
---

<section class="section section--bordered" id="apply">
  <div class="section-head" data-reveal>
    <p class="section-eyebrow">{eyebrow}</p>
    <h2 class="section-title">{heading}</h2>
  </div>

  <div class="ap" id="ap" data-reveal data-locked={locked ? 'true' : 'false'}>
    <!-- ── Left rail: what happens after you press send ──────────── -->
    <aside class="ap-side">
      <p class="ap-lead">{intro}</p>

      <ul class="ap-promise">
        {
          copy.applyPromises.map((p) => (
            <li>
              <span class="ap-promise-k">{p.label}</span>
              <span class="ap-promise-v">
                {p.body}
                {p.linkLabel && p.linkHref && (
                  <>
                    {' '}
                    <a href={p.linkHref}>{p.linkLabel}</a>
                  </>
                )}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="ap-alt" set:html={altNote} />
    </aside>

    <!-- ── The form ──────────────────────────────────────────────── -->
    <div class="ap-main" id="ap-main">
      {
        /* The mode switch. Hidden on a role page, where the answer is already
           known — asking somebody who clicked "Apply for 3D Animator" which
           role they want is the kind of question that loses applicants. */
        !locked && (
          /* Deliberately NOT role="tablist". Tab semantics promise a
             tabpanel, and what changes here is two fields inside a form whose
             other fifteen stay put — announcing that as a panel swap would
             describe something that is not happening. Two pressed-state
             buttons say exactly what this is. */
          <div class="ap-modes" role="group" aria-label={copy.applyA11yModes}>
            <button
              type="button"
              class="ap-mode is-on"
              id="ap-mode-role"
              aria-pressed="true"
              data-mode="role"
            >
              <span class="ap-mode-t">{copy.applyModeRoleTitle}</span>
              <span class="ap-mode-s">
                {plural(
                  openRoles.length,
                  copy.applyModeRoleCountOne,
                  copy.applyModeRoleCountMany
                )}
              </span>
            </button>
            <button
              type="button"
              class="ap-mode"
              id="ap-mode-open"
              aria-pressed="false"
              data-mode="open"
            >
              <span class="ap-mode-t">{copy.applyModeOpenTitle}</span>
              <span class="ap-mode-s">{copy.applyModeOpenSub}</span>
            </button>
          </div>
        )
      }

      <form class="ap-form" id="ap-form" novalidate>
        {
          /* Mode A — which listing. */
          !locked && (
            <div class="ap-block" id="ap-block-role">
              <label class="ap-field ap-field--wide">
                <span class="ap-label">
                  {copy.applyRoleLabel} <em>*</em>
                </span>
                <select name="role_slug" id="ap-role" required>
                  <option value="">{copy.applyRolePlaceholder}</option>
                  {openRoles.map((r) => (
                    <option value={r.slug} data-title={r.title}>
                      {r.title} — {r.kind}
                    </option>
                  ))}
                </select>
                <span class="ap-hint" id="ap-role-hint" hidden />
              </label>
            </div>
          )
        }

        {
          /* Mode B — no listing fits. Two questions, because "what would you
             want to do" and "what area is it in" are not the same answer, and
             a filing system needs the second while a human wants the first. */
          !locked && (
            <div class="ap-block" id="ap-block-open" hidden>
              <div class="ap-pair">
                <label class="ap-field">
                  <span class="ap-label">
                    {copy.applyAreaLabel} <em>*</em>
                  </span>
                  <select name="discipline" id="ap-discipline">
                    <option value="">{copy.applyAreaPlaceholder}</option>
                    {areas.map((d) => (
                      <option value={d}>{d}</option>
                    ))}
                  </select>
                </label>

                <label class="ap-field">
                  <span class="ap-label">
                    {copy.applyDesiredLabel} <em>*</em>
                  </span>
                  <input
                    type="text"
                    name="desired_role"
                    id="ap-desired"
                    placeholder={copy.applyDesiredPlaceholder}
                  />
                </label>
              </div>
              <p class="ap-note">{copy.applyOpenNote}</p>
            </div>
          )
        }

        {
          /* Locked mode: the role is stated as a fact rather than as a field,
             so it is visible in the form without being a question. */
          locked && (
            <div class="ap-locked">
              <span class="ap-locked-k">{copy.applyLockedLabel}</span>
              <span class="ap-locked-v">{role!.title}</span>
              <span class="ap-locked-m">
                {role!.kind} · {role!.location}
              </span>
            </div>
          )
        }

        <!-- ── Who you are ──────────────────────────────────────── -->
        <div class="ap-pair">
          <label class="ap-field">
            <span class="ap-label">{copy.applyNameLabel} <em>*</em></span>
            <input
              type="text"
              name="name"
              id="ap-name"
              required
              autocomplete="name"
              placeholder={copy.applyNamePlaceholder}
            />
          </label>

          <label class="ap-field">
            <span class="ap-label">{copy.applyEmailLabel} <em>*</em></span>
            <input
              type="email"
              name="email"
              id="ap-email"
              required
              autocomplete="email"
              placeholder={copy.applyEmailPlaceholder}
            />
          </label>
        </div>

        <div class="ap-pair">
          <label class="ap-field">
            <span class="ap-label">{copy.applyPhoneLabel}</span>
            <input
              type="tel"
              name="phone"
              id="ap-phone"
              autocomplete="tel"
              placeholder={copy.applyPhonePlaceholder}
            />
          </label>

          <label class="ap-field">
            <span class="ap-label">{copy.applyLocationLabel} <em>*</em></span>
            <input
              type="text"
              name="location"
              id="ap-location"
              required
              autocomplete="address-level2"
              placeholder={copy.applyLocationPlaceholder}
            />
          </label>
        </div>

        <div class="ap-pair">
          <label class="ap-field">
            <span class="ap-label">{copy.applyExperienceLabel} <em>*</em></span>
            <select name="experience" id="ap-experience" required>
              <option value="">{copy.applyChoosePlaceholder}</option>
              {copy.experienceBands.map((b) => <option value={b}>{b}</option>)}
            </select>
          </label>

          <label class="ap-field">
            <span class="ap-label">{copy.applyAvailabilityLabel}</span>
            <select name="availability" id="ap-availability">
              <option value="">{copy.applyChoosePlaceholder}</option>
              {copy.availabilityOptions.map((a) => <option value={a}>{a}</option>)}
            </select>
          </label>
        </div>

        <!-- ── The work. The only part we genuinely cannot do without. ── -->
        <label class="ap-field ap-field--wide">
          <span class="ap-label">{copy.applyPortfolioLabel} <em>*</em></span>
          <input
            type="url"
            name="portfolio_url"
            id="ap-portfolio"
            required
            inputmode="url"
            placeholder={copy.applyPortfolioPlaceholder}
          />
          <span class="ap-hint" id="ap-portfolio-hint">{copy.applyPortfolioHint}</span>
        </label>

        <label class="ap-field ap-field--wide">
          <span class="ap-label">{copy.applyCvLabel}</span>
          <input
            type="url"
            name="cv_url"
            id="ap-cv"
            inputmode="url"
            placeholder={copy.applyCvPlaceholder}
          />
        </label>

        <label class="ap-field ap-field--wide">
          <span class="ap-label" id="ap-message-label">
            {copy.applyMessageLabelRole} <em>*</em>
          </span>
          <textarea
            name="message"
            id="ap-message"
            rows="5"
            required
            placeholder={copy.applyMessagePlaceholder}></textarea>
          <span class="ap-hint">{copy.applyMessageHint}</span>
        </label>

        <!-- Bots fill hidden fields; humans never see this one. -->
        <input type="checkbox" name="botcheck" class="ap-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <p class="ap-msg" id="ap-msg" role="status" aria-live="polite"></p>

        <div class="ap-actions">
          <button type="submit" class="ap-submit" id="ap-submit">
            {locked ? copy.applySubmitRole : copy.applySubmitOpen}
          </button>
          <p class="ap-consent">{copy.applyConsent}</p>
        </div>

        {
          !configured && (
            <p class="ap-warn">
              <strong>Not connected yet.</strong> Add your Supabase project URL and anon
              key to <code>src/config/site.ts</code>, and run <code>supabase/schema.sql</code>{' '}
              in the Supabase SQL editor so the <code>applications</code> table exists.
              Until then this will refuse to submit rather than dropping somebody's
              application into a void.
            </p>
          )
        }
      </form>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    apCfg: {
      configured,
      /* Passed through rather than imported: define:vars makes this script
         inline, and inline scripts are not bundled, so `import` would not
         resolve at runtime. The anon key is public by design — see
         supabase/schema.sql for why that is safe. */
      supabaseUrl: SUPABASE_URL,
      supabaseKey: SUPABASE_ANON_KEY,
      careersEmail,
      locked,
      lockedSlug: role?.slug ?? null,
      lockedTitle: role?.title ?? null,
      lockedDiscipline: role?.discipline ?? null,
      reelNotes,
      /* Everything the script writes into the page after load. Handed over
         here rather than imported, for the reason above: an inline script is
         not bundled, so `import` would not resolve at runtime. */
      copy: {
        roleHint: copy.applyRoleHint,
        messageLabelRole: copy.applyMessageLabelRole,
        messageLabelOpen: copy.applyMessageLabelOpen,
        submitRole: copy.applySubmitRole,
        submitOpen: copy.applySubmitOpen,
        submitBusy: copy.applySubmitBusy,
        errRole: copy.applyErrRole,
        errArea: copy.applyErrArea,
        errDesired: copy.applyErrDesired,
        errName: copy.applyErrName,
        errEmail: copy.applyErrEmail,
        errLocation: copy.applyErrLocation,
        errExperience: copy.applyErrExperience,
        errPortfolio: copy.applyErrPortfolio,
        errPortfolioUrl: copy.applyErrPortfolioUrl,
        errCvUrl: copy.applyErrCvUrl,
        errMessage: copy.applyErrMessage,
        errGeneric: copy.applyErrGeneric,
        errTooFast: copy.applyErrTooFast,
        errNotConfigured: copy.applyErrNotConfigured,
        errSendFailed: copy.applyErrSendFailed,
        errUnreachable: copy.applyErrUnreachable,
        doneTitle: copy.applyDoneTitle,
        doneWhatRole: copy.applyDoneWhatRole,
        doneWhatOpen: copy.applyDoneWhatOpen,
        doneBody: copy.applyDoneBody,
        doneNote: copy.applyDoneNote,
      },
    },
  }}
>
  window.__aniwalaApply = apCfg;
</script>

<script>
  import { fill, fillHtml, esc } from '../lib/copy';

  function initApply() {
    const root = document.getElementById('ap');
    if (!root) return;
    const cfg = (window as any).__aniwalaApply;
    const copy = cfg.copy;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const form = $<HTMLFormElement>('ap-form');
    const main = $('ap-main');
    const msg = $('ap-msg');
    const submit = $<HTMLButtonElement>('ap-submit');

    /* Loaded-at time. Anything submitted inside three seconds of the page
       painting was not typed by a person — nobody fills six fields that fast.
       A speed bump, not a security control; the real one is that anon can
       only INSERT into this table and can never read it back. */
    const openedAt = Date.now();

    /* ---------- mode switching ---------- */
    let mode: 'role' | 'open' = 'role';

    const roleBlock = document.getElementById('ap-block-role');
    const openBlock = document.getElementById('ap-block-open');
    const roleSel = document.getElementById('ap-role') as HTMLSelectElement | null;
    const discSel = document.getElementById('ap-discipline') as HTMLSelectElement | null;
    const desired = document.getElementById('ap-desired') as HTMLInputElement | null;
    const roleHint = document.getElementById('ap-role-hint');
    const messageLabel = document.getElementById('ap-message-label');

    const setMode = (next: 'role' | 'open') => {
      mode = next;
      if (roleBlock) roleBlock.hidden = next !== 'role';
      if (openBlock) openBlock.hidden = next !== 'open';

      /* `required` is moved rather than left on both blocks. A required field
         inside a hidden block blocks submission with a validation bubble the
         browser cannot point at, which reads to the applicant as a form that
         is simply broken. */
      if (roleSel) roleSel.required = next === 'role';
      if (discSel) discSel.required = next === 'open';
      if (desired) desired.required = next === 'open';

      /* The message field is asking for two different things depending on the
         mode, so it says so. */
      if (messageLabel) {
        const label = next === 'open' ? copy.messageLabelOpen : copy.messageLabelRole;
        messageLabel.innerHTML = `${esc(label)} <em>*</em>`;
      }

      document.querySelectorAll<HTMLButtonElement>('.ap-mode').forEach((b) => {
        const on = b.dataset.mode === next;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });

      clearError();
    };

    document.querySelectorAll<HTMLButtonElement>('.ap-mode').forEach((b) => {
      b.addEventListener('click', () => setMode((b.dataset.mode as 'role' | 'open') ?? 'role'));
    });

    /* Deep link: /careers/#apply?role=3d-animator, and the Apply button on
       every listing row uses it. Landing on a form with your role already
       chosen is the difference between applying now and applying later. */
    if (roleSel) {
      const wanted = new URLSearchParams(location.search).get('role');
      if (wanted && roleSel.querySelector(`option[value="${CSS.escape(wanted)}"]`)) {
        roleSel.value = wanted;
      }
      roleSel.addEventListener('change', showReelNote);
      showReelNote();
    }

    function showReelNote() {
      if (!roleSel || !roleHint) return;
      const note = cfg.reelNotes[roleSel.value];
      if (note) {
        roleHint.textContent = fill(copy.roleHint, { note });
        roleHint.hidden = false;
      } else {
        roleHint.hidden = true;
      }
    }

    /* ---------- validation ---------- */
    const clearError = () => {
      msg.textContent = '';
      msg.className = 'ap-msg';
      form.querySelectorAll('.is-invalid').forEach((el) => {
        el.classList.remove('is-invalid');
        el.removeAttribute('aria-invalid');
      });
    };

    const fail = (text: string, field?: HTMLElement | null) => {
      msg.textContent = text;
      msg.className = 'ap-msg is-error';
      if (field) {
        field.classList.add('is-invalid');
        field.setAttribute('aria-invalid', 'true');
        field.focus({ preventScroll: true });
        field.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
      return false;
    };

    const isEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

    /* Accepts a bare domain and repairs it. Half of all portfolio links are
       typed as "artstation.com/name", and rejecting those on a technicality
       would lose real applicants over a missing "https://". */
    const tidyUrl = (raw: string) => {
      const v = raw.trim();
      if (!v) return '';
      if (/^https?:\/\//i.test(v)) return v;
      if (/^[\w.-]+\.[a-z]{2,}(\/|$)/i.test(v)) return `https://${v}`;
      return v;
    };
    const isUrl = (v: string) => {
      try {
        const u = new URL(v);
        return (u.protocol === 'http:' || u.protocol === 'https:') && u.hostname.includes('.');
      } catch {
        return false;
      }
    };

    /* ---------- submit ---------- */
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      const val = (id: string) => ($<HTMLInputElement>(id)?.value ?? '').trim();

      const name = val('ap-name');
      const email = val('ap-email');
      const location_ = val('ap-location');
      const experience = val('ap-experience');
      const message = val('ap-message');

      const portfolioEl = $<HTMLInputElement>('ap-portfolio');
      const cvEl = $<HTMLInputElement>('ap-cv');
      portfolioEl.value = tidyUrl(portfolioEl.value);
      cvEl.value = tidyUrl(cvEl.value);
      const portfolio = portfolioEl.value;
      const cv = cvEl.value;

      /* Mode-specific fields first: they are at the top of the form, so an
         error there should be the one reported. */
      let roleSlug: string | null = cfg.lockedSlug;
      let roleTitle: string | null = cfg.lockedTitle;
      let discipline: string | null = cfg.lockedDiscipline;
      let desiredRole: string | null = null;

      if (!cfg.locked) {
        if (mode === 'role') {
          if (!roleSel?.value) return fail(copy.errRole, roleSel);
          roleSlug = roleSel.value;
          roleTitle = roleSel.selectedOptions[0]?.dataset.title ?? roleSel.value;
          discipline = null;
        } else {
          if (!discSel?.value) return fail(copy.errArea, discSel);
          if (!desired?.value.trim()) return fail(copy.errDesired, desired);
          discipline = discSel.value;
          desiredRole = desired.value.trim();
          roleSlug = null;
          roleTitle = null;
        }
      }

      if (!name) return fail(copy.errName, $('ap-name'));
      if (!isEmail(email)) return fail(copy.errEmail, $('ap-email'));
      if (!location_) return fail(copy.errLocation, $('ap-location'));
      if (!experience) return fail(copy.errExperience, $('ap-experience'));
      if (!portfolio) return fail(copy.errPortfolio, portfolioEl);
      if (!isUrl(portfolio)) return fail(copy.errPortfolioUrl, portfolioEl);
      if (cv && !isUrl(cv)) return fail(copy.errCvUrl, cvEl);
      if (message.length < 20) return fail(copy.errMessage, $('ap-message'));

      /* Bot gates. Both fail silently-ish: a real person never sees either. */
      const hp = form.querySelector<HTMLInputElement>('.ap-hp');
      if (hp?.checked) return fail(copy.errGeneric);
      if (Date.now() - openedAt < 3000) return fail(copy.errTooFast);

      if (!cfg.configured)
        return fail(fill(copy.errNotConfigured, { careersEmail: cfg.careersEmail }));

      submit.disabled = true;
      submit.textContent = copy.submitBusy;

      try {
        const res = await fetch(`${cfg.supabaseUrl.replace(/\/$/, '')}/rest/v1/applications`, {
          method: 'POST',
          headers: {
            apikey: cfg.supabaseKey,
            Authorization: `Bearer ${cfg.supabaseKey}`,
            'Content-Type': 'application/json',
            /* Anon has no SELECT policy on applications, so asking PostgREST
               to echo the row back would fail the request after a perfectly
               good insert. Minimal returns nothing but the status. */
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({
            kind: cfg.locked ? 'role' : mode,
            role_slug: roleSlug,
            role_title: roleTitle,
            discipline,
            desired_role: desiredRole,
            name,
            email,
            phone: val('ap-phone') || null,
            location: location_,
            experience,
            availability: val('ap-availability') || null,
            portfolio_url: portfolio,
            cv_url: cv || null,
            message,
            source_path: location.pathname,
          }),
        });

        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const j = await res.json();
            if (j?.message) detail = j.message;
          } catch {
            /* non-JSON error body — the status is all we have */
          }
          throw new Error(detail);
        }

        /*
         * Everything below goes into innerHTML, and every value in it came
         * out of a form field, so nothing is interpolated raw.
         *
         * `fillHtml` escapes the stored sentence AND the values it fills in,
         * which leaves the two `{{...}}` holes that want real markup — the
         * bolded job title, and the finished clause dropped into the body —
         * untouched by it. Those are substituted afterwards, from strings
         * that have already been through the same escaping.
         */
        const forRole = cfg.locked || mode === 'role';
        const job = `<strong>${esc((forRole ? roleTitle : desiredRole) ?? '')}</strong>`;
        const what = fillHtml(forRole ? copy.doneWhatRole : copy.doneWhatOpen).replace(
          '{{role}}',
          () => job
        );

        main.innerHTML = `<div class="ap-done">
            <p class="ap-done-mark" aria-hidden="true">✓</p>
            <h3>${fillHtml(copy.doneTitle, { name: name.split(' ')[0] })}</h3>
            <p>${fillHtml(copy.doneBody).replace('{{what}}', () => what)}</p>
            <p class="ap-done-note">${fillHtml(copy.doneNote, {}, {
              careersEmail: { href: `mailto:${cfg.careersEmail}`, label: cfg.careersEmail },
            })}</p>
          </div>`;
        main.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } catch (err) {
        fail(
          err instanceof Error && err.message
            ? fill(copy.errSendFailed, {
                error: err.message,
                careersEmail: cfg.careersEmail,
              })
            : fill(copy.errUnreachable, { careersEmail: cfg.careersEmail })
        );
      } finally {
        if (submit.isConnected) {
          submit.disabled = false;
          submit.textContent = cfg.locked ? copy.submitRole : copy.submitOpen;
        }
      }
    });

    /* Clearing the error the moment somebody starts fixing it, rather than
       leaving a red line sitting under a field they have already corrected. */
    form.addEventListener('input', (e) => {
      const t = e.target as HTMLElement;
      if (t.classList?.contains('is-invalid')) {
        t.classList.remove('is-invalid');
        t.removeAttribute('aria-invalid');
        msg.textContent = '';
        msg.className = 'ap-msg';
      }
    });

    if (!cfg.locked) setMode('role');
  }

  document.addEventListener('astro:page-load', initApply);
</script>

