---
/**
 * First-load screen.
 *
 * Just the mark, filling gold from the baseline, then the panel lifts away.
 *
 * It carried a frame counter and a progress hairline as well, on the theory
 * that a film-leader readout suited an animation studio. It did not: three
 * things competing on an otherwise empty screen made a one-second moment look
 * busy, and a progress number that is really just a timer is a small lie.
 * The mark alone says the same thing and says it quietly.
 *
 * Three rules it obeys:
 *
 *   1. It shows on a full page load and never on an internal link. That
 *      distinction is free here: ClientRouter swaps pages client-side, so
 *      moving around the site does not reload and does not see this. What is
 *      left is arriving, refreshing, or opening a tab — a loader on every
 *      page *view* would be a toll, but on an actual page load it is not.
 *   2. It never outlives the page. It lifts on `load`, or on a hard 2.2s
 *      ceiling if something on the network hangs, whichever comes first. A
 *      loader that can strand a visitor behind a blank screen is worse than
 *      no loader.
 *   3. It does not exist without JavaScript, and it does not exist for anyone
 *      who asked for reduced motion. Both cases skip it entirely rather than
 *      degrading to a static black rectangle.
 *
 * MARKUP ORDER MATTERS. This renders first in <body> and is `position: fixed`,
 * so the page underneath is fully parsed and laid out behind it. Content is
 * never hidden from a crawler — the overlay is a paint-time cover, not a
 * gate, and the HTML below it is complete whether or not the script runs.
 */

import { getLoaderSettings } from '../lib/loader';

const { enabled, imageUrl, alt, maxDuration } = await getLoaderSettings();

/* One copy of the mark, drawn twice: a ghost, and the gold fill revealed
   behind a growing window. Held here so the two can never drift apart.

   Used when no mark has been uploaded, which is the default — the built-in
   one is the studio's own, so the CMS field is for a rebrand rather than for
   getting the site working. */
const MARK =
  'M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z';
---

{/*
  `transition:persist` is what makes this usable on internal navigation.
  ClientRouter replaces the whole body on a swap, so without it the curtain
  raised at the start of a navigation would be destroyed halfway through it —
  the visitor would see it flash and vanish mid-transition. Persisted, the one
  element outlives the swap and can be lowered again on the other side.
*/}
{ enabled && (
<div
  id="loader"
  class="ld"
  role="presentation"
  aria-hidden="true"
  transition:persist="loader"
  data-max={String(maxDuration)}
>
  {/*
    The gold mark is revealed by a window that grows upward from the baseline
    — the mark resolving the way an animator watches a render come in.

    A plain <span> with `overflow: hidden` and an animated height, rather than
    an SVG <clipPath> or `clip-path: inset()`. Both of those would read more
    elegantly, and both put the effect at the mercy of how a given engine
    animates SVG geometry and basic shapes. Animating the height of a block
    box is the dullest possible construction and the one with no edge cases.
  */}
  {/*
    An uploaded mark is drawn as two copies of the same image — a faded ghost
    and a full-strength one revealed by the growing window — which is exactly
    what the built-in SVG does with its two fills. The reveal animates the
    height of a block box, so it does not care whether that box holds an SVG
    path or a PNG.
  */}
  <div class="ld-mark">
    {
      imageUrl ? (
        <Fragment>
          <img class="ld-svg ld-img ld-img--ghost" src={imageUrl} alt="" aria-hidden="true" />
          <span class="ld-reveal">
            <img class="ld-svg ld-img" src={imageUrl} alt={alt} aria-hidden="true" />
          </span>
        </Fragment>
      ) : (
        <Fragment>
          <svg class="ld-svg ld-svg--ghost" viewBox="0 0 128 128" aria-hidden="true">
            <path d={MARK} />
          </svg>
          <span class="ld-reveal">
            <svg class="ld-svg ld-svg--fill" viewBox="0 0 128 128" aria-hidden="true">
              <path d={MARK} />
            </svg>
          </span>
        </Fragment>
      )
    }
  </div>
</div>
) }

<style>
  /*
    Hidden unless the head script opts in. Anyone without JavaScript and
    anyone with reduced motion never sees this element at all — it stays
    display:none and never paints.
  */
  .ld {
    display: none;
  }

  :global(html[data-loader='on']) .ld,
  :global(html[data-loader='nav']) .ld,
  :global(html[data-loader='done']) .ld {
    display: grid;
    position: fixed;
    inset: 0;
    z-index: 200;
    place-items: center;
    background: var(--color-ground);
    /* Opacity only, which the compositor handles on its own thread — so the
       curtain clearing cannot jank the first frame of the page underneath. */
    transition: opacity 0.45s ease;
  }

  /*
    Arrival used to LIFT: the curtain slid up and off the top of the screen.
    It now fades where it stands, the same as it does between pages.

    The argument for lifting was that a panel pulling away reads as the site
    opening. The argument against it won: the mark finishes, then travels
    upward, and the eye follows it off the screen instead of landing on the
    page that just arrived — which is the exact objection the note below
    already made about doing it during navigation. It was no more true on the
    first load; it was simply the first thing anybody saw, so it read as
    intentional.

    One behaviour, one place, and a reader who is looking at the page rather
    than at the ceiling.
  */
  :global(html[data-loader='done']) .ld {
    opacity: 0;
    pointer-events: none;
  }

  /*
    Navigation is not arrival.

    A client-side swap takes tens of milliseconds, so replaying the full 1.15s
    fill on every internal link would make a fast site feel slow — the "toll"
    this component's own notes warn about. Same curtain, same mark, roughly a
    third of the running time.

    Both states fade now; this one just fades FASTER, because there is less to
    hand over between two pages of a site somebody is already reading.
  */
  :global(html[data-loader='nav']) .ld {
    transition: opacity 0.28s ease;
  }
  :global(html[data-loader='nav'][data-loader-exit]) .ld {
    opacity: 0;
  }
  :global(html[data-loader='nav']) .ld-reveal {
    /* Kept in step with NAV_MIN in the script below, which must outlast it.
       At 0.42s against a 380ms floor the mark was still filling when the
       curtain lifted, so the gold never reached the top — the same trap the
       first-load MIN comment warns about. */
    animation-duration: 0.4s;
  }

  /*
    Astro's own cross-fade, turned off.

    ClientRouter animates the page swap with the View Transitions API, and
    those `::view-transition` snapshots are composited ABOVE the real
    document — above a `position: fixed; z-index: 200` curtain included. So
    the outgoing page was visibly fading over the top of the loader on every
    internal link, which is the "page comes in front" of it.

    There is no z-index that wins this; the fix is to stop having two
    transitions for one navigation. The curtain IS the transition now, so the
    snapshot layer is told not to animate at all.
  */
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }

  /* While the curtain is up the page behind must not scroll. Set here rather
     than on body from script, so it cannot be left behind if the script dies
     between the two. */
  :global(html[data-loader='on']),
  :global(html[data-loader='nav']) {
    overflow: hidden;
  }
  :global(html[data-loader='done']) {
    overflow: auto;
  }

  /* --- Mark ------------------------------------------------------------- */
  .ld-mark {
    /*
      Width and height both come from --mark rather than from a width plus
      `aspect-ratio`, and the reveal window animates to that same value rather
      than to 100%. Percentage heights need a definite height on the parent to
      resolve against, and one derived from aspect-ratio is not reliably that
      — so the animation is given a length it can always interpolate.

      Larger than it was: the mark is carrying the whole screen now that the
      counter and the progress rule are gone.
    */
    --mark: clamp(5.5rem, 15vw, 8.5rem);
    position: relative;
    width: var(--mark);
    height: var(--mark);
  }
  .ld-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ld-svg--ghost path {
    fill: var(--color-ink);
    opacity: 0.14;
  }
  .ld-svg--fill path {
    fill: var(--color-accent);
  }

  /* An uploaded mark cannot be recoloured the way an SVG path can, so the
     ghost is the same picture at low opacity rather than a different fill.
     `object-fit: contain` letterboxes a non-square upload instead of
     stretching it. */
  .ld-img {
    object-fit: contain;
  }
  .ld-img--ghost {
    opacity: 0.14;
  }

  /*
    The window. Anchored to the bottom and grown to full height, so the mark
    is uncovered from the baseline up. The inner SVG is pinned to the bottom
    at the full mark size, or it would squash as the window grows instead of
    being revealed by it.
  */
  .ld-reveal {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    overflow: hidden;
    animation: ld-rise 1.15s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .ld-reveal .ld-svg {
    inset: auto 0 0 0;
    height: var(--mark);
  }
  @keyframes ld-rise {
    to {
      height: var(--mark);
    }
  }

  /*
    Belt and braces. The head script already skips the loader entirely for
    reduced motion, but if it is ever shown some other way, nothing here
    should move.
  */
  @media (prefers-reduced-motion: reduce) {
    .ld-reveal {
      animation: none;
      height: var(--mark);
    }
    :global(html[data-loader='on']) .ld {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Lifts the curtain.
   *
   * The decision to show at all was already made by the inline script in
   * Base.astro's <head>, before first paint — it has to be, or the page
   * flashes before the loader covers it. This module only runs the exit.
   */
  function initLoader() {
    const root = document.documentElement;
    if (root.dataset.loader !== 'on') return;

    const started = performance.now();

    /* Long enough for the fill to complete and read, short enough not to be
       a toll. Must outlast the 1.15s fill or the mark is cut off mid-rise. */
    const MIN = 1400;
    /* Hard ceiling. If `load` has not fired by now something on the network
       is hanging, and that is not the visitor's problem to wait out.

       Read off the element rather than inlined, so this stays a module script
       and keeps its TypeScript — `define:vars` would force it inline. Falls
       back to the old constant when the attribute is missing or unparseable:
       a decorative curtain should never be the thing that throws. */
    const MAX = Number(document.getElementById('loader')?.dataset.max) || 2200;

    let done = false;

    const finish = () => {
      if (done) return;
      done = true;

      root.dataset.loader = 'done';

      /* Motion boot waits on this — see Base.astro. Without it the hero
         reveals play behind the curtain and are over by the time it lifts. */
      window.dispatchEvent(new CustomEvent('aniwala:loader-done'));

      /* Parked, not removed.
         It used to be removed here, so a fixed full-screen div was not left
         sitting over the document. It now has a second job — the curtain for
         internal navigation — and an element that deleted itself after the
         first page could not do it. `idle` drops it back to `display: none`
         via the base rule, which achieves the same thing and keeps it
         reusable. */
      setTimeout(() => {
        if (root.dataset.loader === 'done') root.dataset.loader = 'idle';
      }, 900);
    };

    const elapsed = () => performance.now() - started;
    const afterMin = (fn: () => void) => setTimeout(fn, Math.max(0, MIN - elapsed()));

    if (document.readyState === 'complete') afterMin(finish);
    else window.addEventListener('load', () => afterMin(finish), { once: true });

    /* The ceiling runs regardless of `load`. */
    setTimeout(finish, MAX);
  }

  initLoader();

  /* ------------------------------------------------------------------
     Internal navigation.

     ClientRouter swaps pages without a reload, so none of the above runs
     again. These two events are the swap's own start and end, which is what
     the curtain hangs off.

     The element is persisted (`transition:persist`), so the SAME node is
     raised before the swap and lowered after it — it is never mid-flight
     when the body is replaced.
     ------------------------------------------------------------------ */
  const root = document.documentElement;

  /*
    Timing is measured from when the MARK starts, not from when the navigation
    starts, because those are not the same moment — see the `after-swap`
    handler below for why.
  */
  let markStarted = 0;
  let curtainUp = false;

  document.addEventListener('astro:before-preparation', () => {
    /* Same exemption as the first load: someone who asked for reduced motion
       gets no curtain, here or anywhere. */
    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;

    curtainUp = true;
    root.dataset.loader = 'nav';

    /* The same flag the first load uses. `bootMotion` in Base.astro reads it
       on `astro:page-load` and, when set, holds the reveals until
       `aniwala:loader-done`. Without this the entrance animations play behind
       the curtain on every internal link and are over before it lifts —
       precisely the failure the first-load path already guards against. */
    (window as any).__aniwalaLoaderPending = true;
  });

  /*
    Start the fill AFTER the swap, not before it.

    The first version restarted the animation in `before-preparation`, and it
    never played: `transition:persist` carries this element across the swap by
    MOVING the node into the newly built document, and moving a node cancels
    the CSS animations running on it. The curtain went up, the animation was
    killed a few milliseconds later, and the mark sat as a grey ghost with no
    gold in it for the whole navigation.

    `astro:after-swap` is the first moment the node is in its final home, so
    the restart survives.
  */
  document.addEventListener('astro:after-swap', () => {
    if (!curtainUp) return;

    /* The swap rebuilds the document, so re-assert the state on the new
       <html> element — the attribute set before the swap is not carried. */
    root.dataset.loader = 'nav';

    const reveal = document.querySelector<HTMLElement>('#loader .ld-reveal');
    if (reveal) {
      reveal.style.animation = 'none';
      /* Forcing layout is the reliable way to restart a CSS animation. */
      void reveal.offsetHeight;
      reveal.style.animation = '';
    }

    markStarted = performance.now();
  });

  document.addEventListener('astro:page-load', () => {
    if (!curtainUp) return;
    curtainUp = false;

    /* Must outlast the 0.4s fill, or the mark is cut off partway up and the
       gold never completes — the constraint the first-load MIN documents.
       Measured from the swap, which is when the fill actually starts. */
    const NAV_MIN = 520;
    const elapsed = markStarted ? performance.now() - markStarted : 0;

    setTimeout(
      () => {
        /* Stays in the `nav` state and fades, rather than switching to `done`
           and sliding up — see the CSS above for why the two exits differ. */
        root.dataset.loaderExit = '';

        /* Releases the reveals held above. Same event the first load fires,
           so Base.astro needs no second code path. Dispatched as the fade
           STARTS, so the page is already animating in behind the curtain and
           is settled by the time it clears, rather than beginning from
           nothing on a page the reader is already looking at. */
        window.dispatchEvent(new CustomEvent('aniwala:loader-done'));

        setTimeout(() => {
          delete root.dataset.loaderExit;
          root.dataset.loader = 'idle';
        }, 300);
      },
      Math.max(0, NAV_MIN - elapsed)
    );
  });
</script>
