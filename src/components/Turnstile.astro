---
/**
 * The Cloudflare Turnstile widget.
 *
 * Drop it inside a <form>. The widget injects a hidden `cf-turnstile-response`
 * input into the enclosing form, which is where `lib/submit.ts` reads the
 * token from — so nothing has to be wired up by hand at the call site.
 *
 * RENDERS NOTHING when TURNSTILE_SITE_KEY is unset, which is the supported
 * "not configured yet" state described in lib/submit.ts. The forms then take
 * their original path and this component is invisible.
 *
 * Turnstile is used rather than reCAPTCHA because it does not show puzzles to
 * people, does not profile them across sites, and does not send anything to an
 * advertising company — which matters for a form that a privacy policy has to
 * describe honestly.
 */
import { TURNSTILE_SITE_KEY } from '../config/site';

interface Props {
  /** Extra classes for spacing at the call site. */
  class?: string;
}
const { class: className } = Astro.props;
---

{
  TURNSTILE_SITE_KEY && (
    <div class:list={['turnstile', className]}>
      {/*
        `data-appearance="interaction-only"` keeps the widget out of the way
        until Cloudflare actually wants something from the visitor. For the
        overwhelming majority it never renders at all, so a contact form does
        not grow a compliance box for no reason.
      */}
      <div
        class="cf-turnstile"
        data-sitekey={TURNSTILE_SITE_KEY}
        data-theme="auto"
        data-appearance="interaction-only"
        data-error-callback="aniwalaTurnstileError"
      />
      <noscript>
        <p class="turnstile-noscript">
          This form needs JavaScript to verify you are human. Please email us instead.
        </p>
      </noscript>
    </div>
  )
}

{
  /*
    WHY AN ERROR CALLBACK IS NOT OPTIONAL HERE.

    `interaction-only` means the widget renders NOTHING when Cloudflare is
    satisfied — which is the pleasant case and the whole reason to use it. It
    also means the widget renders nothing when it FAILS. A site key whose
    hostname list does not include this domain produces no widget, no token
    and no visible error, so the form says "please complete the check below"
    while there is demonstrably nothing below to complete. That is a dead end
    for whoever is trying to leave a comment, and an unfalsifiable bug report
    for whoever has to fix it.

    So the error code is captured and the form reports it. Turnstile's codes
    are documented, and 110200 in particular means "this domain is not on the
    widget's hostname list" — the single most likely misconfiguration, and
    now a legible one.
  */
  TURNSTILE_SITE_KEY && (
    <script is:inline>
      window.aniwalaTurnstileError = function (code) {
        window.__aniwalaTurnstileErr = String(code || 'unknown');
        try {
          console.error('[turnstile] failed to issue a token, code ' + code);
        } catch (e) {}
        return true;
      };

      /*
       * EXPLICIT RENDER, AND WHY AUTO-RENDER WAS BROKEN FOR ALMOST EVERYONE.
       *
       * api.js in its default mode scans the document for `.cf-turnstile`
       * elements exactly once, when the script first loads. This site runs
       * Astro's ClientRouter, so every internal link is a client-side swap
       * rather than a page load — the DOM is replaced and api.js never runs
       * again.
       *
       * The result: landing directly on a blog post worked, and reaching the
       * same post by clicking it from the blog index produced a widget div
       * that nothing ever rendered. No widget, no token, and the form failed
       * after waiting for one that was never coming. Since most visitors
       * arrive by clicking a link rather than typing a URL, the broken path
       * was the common one — and it looked intermittent, which is the worst
       * way for a bug like this to present.
       *
       * So rendering is done by hand, here, on every `astro:page-load` — the
       * event Astro fires both on first load and after each swap. The
       * `render=explicit` parameter on the script URL stops api.js also
       * auto-rendering, which would otherwise produce two widgets on the
       * first page.
       */
      window.aniwalaTurnstileInit = function () {
        if (!window.turnstile || !window.turnstile.render) return;
        var nodes = document.querySelectorAll('.cf-turnstile');
        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];
          if (el.dataset.aniwalaRendered === '1') continue;
          try {
            window.turnstile.render(el, {
              sitekey: el.dataset.sitekey,
              theme: el.dataset.theme || 'auto',
              appearance: el.dataset.appearance || 'interaction-only',
              'error-callback': window.aniwalaTurnstileError,
            });
            el.dataset.aniwalaRendered = '1';
            /* A fresh widget must not inherit a failure recorded on the
               previous page, or the form gives up before this one has had a
               chance to issue anything. */
            window.__aniwalaTurnstileErr = undefined;
          } catch (e) {
            try {
              console.error('[turnstile] render failed', e);
            } catch (e2) {}
          }
        }
      };

      /* Guarded: ClientRouter re-runs inline scripts from swapped documents,
         and a listener added on every navigation would render the same widget
         several times over. */
      if (!window.__aniwalaTurnstileBound) {
        window.__aniwalaTurnstileBound = true;
        document.addEventListener('astro:page-load', function () {
          window.aniwalaTurnstileInit();
        });
      }
    </script>
  )
}

{
  /*
    `render=explicit` hands rendering to `aniwalaTurnstileInit` above, and
    `onload` is how api.js reports that it is ready on the very first load —
    which can happen either side of `astro:page-load`, so both call the same
    idempotent function and whichever arrives second does nothing.

    The `id` makes a repeat of this tag a no-op if several forms are on one
    page.
  */
  TURNSTILE_SITE_KEY && (
    <script
      is:inline
      id="cf-turnstile-api"
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=aniwalaTurnstileInit"
      async
      defer
    />
  )
}

<style>
  .turnstile {
    margin: 0 0 1rem;
  }
  /* The widget renders nothing at all in the common case, so it must not
     leave a gap where it would have been. */
  .turnstile:empty {
    display: none;
  }
  .turnstile-noscript {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-ink-faint);
  }
</style>
