---
/**
 * The scrolling strip.
 *
 * Defaults to the shared studio list rather than storing its own copy, so the
 * marquee on a new landing page cannot drift out of step with the homepage.
 * A custom list is available for a page that genuinely needs its own.
 */
import Marquee from '../Marquee.astro';
import { getSiteCopy } from '../../lib/studio';

interface Props {
  block: {
    source?: 'marquee' | 'custom';
    items?: string[];
    speed?: number;
    reverse?: boolean;
  };
}
const { block } = Astro.props;

const items =
  block.source === 'custom' ? (block.items ?? []) : (await getSiteCopy()).marqueeItems;
---

{/* Speed and direction fall through to the component's own defaults when the
    block leaves them unset, so an existing marquee keeps behaving exactly as
    it did before these two fields existed. */}
{items.length > 0 && <Marquee items={items} speed={block.speed} reverse={block.reverse} />}
