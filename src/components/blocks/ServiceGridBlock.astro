---
/**
 * The services, as a grid of tiles or a list of numbered rows.
 *
 * `grid` is the homepage's six-up tile grid, read from the nav's services
 * dropdown so the two can never list different services. `rows` is the
 * services page: numbered, full-width, with each service's tagline and its
 * first three offerings — read from `config/services.ts`, which is the only
 * place that has those.
 *
 * Two sources for one block looks wrong until you notice they are two
 * different amounts of information about the same six things. The grid needs a
 * label and a blurb; the rows need the tagline and the offering names. Reading
 * each from where it lives beats duplicating either.
 */
import SectionHead from './SectionHead.astro';
import { nav } from '../../config/nav';
import { services } from '../../config/services';

interface Props {
  block: { eyebrow?: string; title?: string; anchor?: string; layout?: 'grid' | 'rows' };
}
const { block } = Astro.props;
const rows = block.layout === 'rows';

const navServices = nav.find((i) => i.children)?.children ?? [];
---

<section class="section" class:list={[!rows && 'section--bordered']} id={block.anchor ?? (rows ? 'disciplines' : 'services')}>
  <SectionHead eyebrow={block.eyebrow} title={block.title} />

  {
    rows ? (
      <ol class="svc-list">
        {services.map((s, i) => (
          <li class="svc-row" style={`--tint:${s.tint}`} data-reveal>
            <a href={`/services/${s.slug}/`} class="svc-link">
              <span class="svc-wash" aria-hidden="true" />

              <span class="svc-n">{String(i + 1).padStart(2, '0')}</span>

              <span class="svc-main">
                <h2 class="svc-title">{s.title}</h2>
                <span class="svc-tagline">{s.tagline}</span>
                <span class="svc-tags">
                  {s.offerings.slice(0, 3).map((o) => (
                    <span class="svc-tag">{o.title}</span>
                  ))}
                </span>
              </span>

              <span class="svc-go" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <div class="service-grid">
        {navServices.map((s) => (
          <a href={s.href} class="service" data-reveal>
            <h3 class="service-name">{s.label}</h3>
            <p class="service-blurb">{s.blurb}</p>
            <span class="service-arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ))}
        <a href="/contact/" class="service service--cta" data-reveal>
          <h3 class="service-name">Something else?</h3>
          <p class="service-blurb">Tell us what you need and we'll scope it honestly.</p>
          <span class="service-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    )
  }
</section>

<style>
  /* --- Grid ------------------------------------------------------------- */
  .service-grid {
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    overflow: hidden;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service {
    background: var(--color-ground);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.25s ease;
  }
  .service:hover {
    background: var(--color-surface);
  }
  .service-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    font-stretch: 108%;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .service-blurb {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .service-arrow {
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 1.2rem;
    color: var(--color-accent);
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .service:hover .service-arrow {
    transform: translateX(4px);
  }
  .service--cta .service-name {
    color: var(--color-accent);
  }

  /* --- Rows ------------------------------------------------------------- */
  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .svc-row {
    border-bottom: 1px solid var(--color-line);
  }

  .svc-link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 1rem 1.5rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) clamp(0.75rem, 2vw, 1.5rem);
    text-decoration: none;
    color: inherit;
  }
  @media (min-width: 700px) {
    .svc-link {
      gap: 1rem 3rem;
      align-items: center;
    }
  }

  /* Tint sweeps in from the left on hover — the row equivalent of a tile
     lighting up, and cheap because it only animates transform and opacity. */
  .svc-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: linear-gradient(90deg, hsl(var(--tint) / 0.35), transparent 65%);
    transform: translateX(-1.5rem);
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .svc-link:hover .svc-wash,
  .svc-link:focus-visible .svc-wash {
    opacity: 1;
    transform: translateX(0);
  }

  .svc-n {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-accent);
    padding-top: 0.4rem;
  }

  .svc-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .svc-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 780;
    font-stretch: 110%;
    letter-spacing: -0.028em;
    line-height: 1.05;
    font-size: clamp(1.6rem, 4.2vw, 3rem);
    color: var(--color-ink);
    transition: color 0.2s ease;
  }
  .svc-link:hover .svc-title {
    color: var(--color-accent);
  }

  .svc-tagline {
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 46ch;
  }

  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }
  .svc-tag {
    padding: 0.32rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  .svc-go {
    font-size: 1.4rem;
    color: var(--color-accent);
    padding-top: 0.2rem;
    transition: transform 0.25s ease;
  }
  .svc-link:hover .svc-go {
    transform: translateX(6px);
  }
</style>
