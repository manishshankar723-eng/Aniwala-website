---
/**
 * The studio timeline. Hidden until something has genuinely happened — a
 * two-entry timeline is more honest than a padded twelve-entry one.
 */
import SectionHead from './SectionHead.astro';
import { getMilestones } from '../../lib/studio';

interface Props {
  block: { eyebrow?: string; title?: string; anchor?: string };
}
const { block } = Astro.props;
const milestones = await getMilestones();
---

{
  milestones.length > 0 && (
    <section class="section section--bordered" id={block.anchor || "history"}>
      <SectionHead eyebrow={block.eyebrow} title={block.title} />
      <ol class="timeline">
        {milestones.map((m) => (
          <li class="milestone" data-reveal>
            <span class="milestone-when">{m.when}</span>
            <h3 class="milestone-title">{m.title}</h3>
            <p class="milestone-body">{m.body}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .milestone {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-strong);
  }
  .milestone-when {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-accent);
  }
  .milestone-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    font-stretch: 106%;
  }
  .milestone-body {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
</style>
