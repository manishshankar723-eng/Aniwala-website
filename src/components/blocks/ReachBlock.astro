---
/**
 * The direct routes to the studio: inbox, address, social accounts.
 *
 * A page that opens with a form asks the visitor to do the work. This opens
 * with the address and lets them choose.
 *
 * A data block, and firmly so — every value comes from the `contactDetails`
 * singleton. The one thing an editor writes here is the note and the three
 * hints beside the email address, because those are advice about how to write
 * a good brief rather than contact information.
 *
 * THE SOCIAL ACCOUNTS ARE OFF BY DEFAULT — `showSocial` in the Studio turns
 * them on. Every page already ends with the same list in the footer, so a
 * second copy near the top of the contact page was the same six links twice
 * on one screen, offering somebody who came here to describe a job six ways
 * to leave instead. The inbox and the address are what this panel is for.
 *
 * When it IS switched on, the list drops accounts with no URL in a production
 * build and shows them greyed under `astro dev`, so the row can be laid out
 * before the accounts exist without ever shipping a link to nowhere.
 */
import SectionHead from './SectionHead.astro';
import SocialIcon from '../SocialIcon.astro';
import { getContactDetails } from '../../lib/studio';

interface Props {
  block: {
    eyebrow?: string;
    title?: string;
    anchor?: string;
    emailLabel?: string;
    note?: string;
    hints?: string[];
    studioLabel?: string;
    mapsLabel?: string;
    socialLabel?: string;
    showSocial?: boolean;
  };
}
const { block } = Astro.props;

const { email, addressLines, country, mapsUrl, publishedSocials: socials } =
  await getContactDetails();
---

<section class="section" id={block.anchor ?? 'reach'}>
  <SectionHead eyebrow={block.eyebrow} title={block.title} />

  <div class="reach">
    <div class="reach-card reach-card--mail" data-reveal>
      <p class="reach-label">{block.emailLabel ?? 'Email'}</p>
      <a href={`mailto:${email}`} class="reach-mail">{email}</a>
      {block.note && <p class="reach-note">{block.note}</p>}

      {
        block.hints && block.hints.length > 0 && (
          <ul class="reach-hint">
            {block.hints.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="reach-side">
      <div class="reach-card" data-reveal>
        <p class="reach-label">{block.studioLabel ?? 'Studio'}</p>
        <address class="reach-address">
          {addressLines.map((line) => <span>{line}</span>)}
          <span>{country}</span>
        </address>
        <a href={mapsUrl} class="reach-link" rel="noopener">
          {block.mapsLabel ?? 'Open in Maps'} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      {
        block.showSocial && socials.length > 0 && (
          <div class="reach-card" data-reveal>
            <p class="reach-label">{block.socialLabel ?? 'Elsewhere'}</p>
            <ul class="reach-social">
              {socials.map((s) =>
                s.href ? (
                  <li>
                    <a href={s.href} rel="noopener">
                      <SocialIcon icon={s.icon} class="reach-social-icon" />
                      {s.label}
                    </a>
                  </li>
                ) : (
                  /* Dev only — an account that has no URL in the CMS yet. */
                  <li>
                    <span class="reach-social-todo" title="No URL set in Contact details">
                      <SocialIcon icon={s.icon} class="reach-social-icon" />
                      {s.label}
                    </span>
                  </li>
                )
              )}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .reach {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .reach {
      grid-template-columns: 1.35fr 1fr;
    }
  }

  .reach-side {
    display: grid;
    gap: 1.25rem;
  }

  .reach-card {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
  }

  .reach-label {
    margin: 0 0 1rem;
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    font-weight: calc(700 + var(--type-label-weight, 0));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: var(--color-accent);
  }

  .reach-mail {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: calc(800 + var(--type-display-weight, 0));
    font-stretch: 112%;
    letter-spacing: calc(-0.03em + var(--type-display-track, 0em));
    /* Sized to fill its card without ever outgrowing it — the address is
       long, and at a fixed size it wraps mid-word on a phone. */
    font-size: calc(clamp(1.35rem, 4vw, 2.6rem) * var(--type-display-scale, 1));
    line-height: 1.1;
    color: var(--color-ink);
    text-decoration: none;
    word-break: break-word;
    transition: color 0.2s ease;
  }
  .reach-mail:hover {
    color: var(--color-accent);
  }

  .reach-note {
    margin: 1.5rem 0 0;
    max-width: 54ch;
    font-size: calc(0.97rem * var(--type-label-scale, 1));
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .reach-hint {
    margin: 1.5rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .reach-hint li {
    position: relative;
    padding-left: 1.4rem;
    font-size: calc(0.9rem * var(--type-body-scale, 1));
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .reach-hint li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 100px;
    background: var(--color-accent);
  }

  /* --- Address ---------------------------------------------------------- */
  .reach-address {
    display: grid;
    gap: 0.15rem;
    font-style: normal;
    font-size: calc(0.95rem * var(--type-body-scale, 1));
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .reach-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: var(--color-accent);
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid currentColor;
  }
  .reach-link span {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .reach-link:hover span {
    transform: translateX(4px);
  }

  /* --- Social ----------------------------------------------------------- */
  .reach-social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .reach-social a,
  .reach-social-todo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: calc(0.93rem * var(--type-body-scale, 1));
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .reach-social a:hover {
    color: var(--color-accent);
  }
  /* Dev only: an account with no URL yet. */
  .reach-social-todo {
    color: var(--color-ink-faint);
    opacity: 0.45;
    cursor: help;
  }
</style>
