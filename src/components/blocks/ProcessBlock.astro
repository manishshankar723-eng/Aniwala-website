---
/**
 * The numbered "how we work" sequence.
 *
 * A real sequence, so it is genuinely an `<ol>` and genuinely numbered. The
 * steps are the shared list on Site copy, so the homepage and the services
 * page can never describe two different processes.
 */
import SectionHead from './SectionHead.astro';
import { getSiteCopy } from '../../lib/studio';
import { imageUrl, imageSrcSet } from '../../lib/sanity/client';

interface Props {
  block: { eyebrow?: string; title?: string; anchor?: string };
}
const { block } = Astro.props;

/* One list, shared with the homepage — see the note on the Studio field. */
const { processSteps } = await getSiteCopy();
---

<section class="section section--bordered" id={block.anchor || "process"}>
  <SectionHead eyebrow={block.eyebrow} title={block.title} />

  <ol class="process">
    {
      processSteps.map((step, i) => (
        <li class="step" data-reveal>
          {step.image && (
            <img
              class="step-art"
              src={imageUrl(step.image, 600)}
              srcset={imageSrcSet(step.image, [300, 450, 600, 900])}
              sizes="(min-width: 1100px) 22vw, (min-width: 700px) 45vw, calc(100vw - 2 * var(--gutter))"
              alt={step.image.alt ?? ''}
              loading="lazy"
              decoding="async"
            />
          )}
          <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-body">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .process {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .process {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-strong);
  }
  /*
    Optional, one per step, and the column is built to survive it being
    absent: the picture is the first thing in a flex column, so a step
    without one simply starts at its number and sits level with the rest.
  
    Fixed `aspect-ratio` with `object-fit: cover` for the same reason the
    pipeline's are — four pictures uploaded separately, each picking its own
    height, read as an accident rather than a row.
  */
  .step-art {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0.6rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    margin-bottom: 0.3rem;
  }
  .step-n {
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: var(--color-accent);
  }
  .step-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(1.15rem * var(--type-heading-scale, 1));
    font-weight: calc(700 + var(--type-heading-weight, 0));
    font-stretch: 106%;
  }
  .step-body {
    margin: 0;
    font-size: calc(0.92rem * var(--type-body-scale, 1));
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
</style>
