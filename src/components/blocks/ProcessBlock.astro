---
/**
 * The numbered "how we work" sequence.
 *
 * A real sequence, so it is genuinely an `<ol>` and genuinely numbered. The
 * steps are the shared list on Site copy, so the homepage and the services
 * page can never describe two different processes.
 */
import SectionHead from './SectionHead.astro';
import { getSiteCopy } from '../../lib/studio';

interface Props {
  block: { eyebrow?: string; title?: string; anchor?: string };
}
const { block } = Astro.props;

/* One list, shared with the homepage — see the note on the Studio field. */
const { processSteps } = await getSiteCopy();
---

<section class="section section--bordered" id={block.anchor || "process"}>
  <SectionHead eyebrow={block.eyebrow} title={block.title} />

  <ol class="process">
    {
      processSteps.map((step, i) => (
        <li class="step" data-reveal>
          <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-body">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .process {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .process {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-strong);
  }
  .step-n {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-accent);
  }
  .step-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    font-stretch: 106%;
  }
  .step-body {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
</style>
