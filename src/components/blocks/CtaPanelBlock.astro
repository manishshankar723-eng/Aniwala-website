---
/**
 * A bordered panel: heading and paragraph on the left, one button on the
 * right. The homepage's careers panel is this block.
 */
interface Props {
  block: {
    eyebrow?: string;
    title?: string;
    anchor?: string;
    body?: string;
    linkLabel?: string;
    linkHref?: string;
    measure?: 'short' | 'long';
  };
}
const { block } = Astro.props;
const hasLink = Boolean(block.linkLabel && block.linkHref);
---

<section class="section section--bordered" id={block.anchor}>
  <div class="panel-inner" data-reveal>
    <div>
      {block.eyebrow && <p class="section-eyebrow">{block.eyebrow}</p>}
      {block.title && <h2 class="section-title">{block.title}</h2>}
      {block.body && (
        <p class:list={['panel-body', block.measure === 'long' && 'panel-body--long']}>
          {block.body}
        </p>
      )}
    </div>
    {
      hasLink && (
        <a href={block.linkHref} class="btn btn--ghost">
          {block.linkLabel} <span aria-hidden="true">&rarr;</span>
        </a>
      )
    }
  </div>
</section>

<style>
  .panel-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  /* Two measures, because the two panels on this site hold different
     amounts of text: a one-line blurb reads better narrow, a three-sentence
     explanation needs the extra characters or it becomes a column. This is
     the one place a block exposes a layout choice, and it is bounded to two
     options rather than a free-form width for that reason. */
  .panel-body {
    margin: 1.25rem 0 0;
    max-width: 44ch;
    color: var(--color-ink-muted);
    line-height: 1.6;
  }
  .panel-body--long {
    max-width: 54ch;
    line-height: 1.65;
  }
</style>
