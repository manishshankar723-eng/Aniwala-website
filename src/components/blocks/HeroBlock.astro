---
/**
 * The hero, in both flavours.
 *
 * `VideoHero` and `PageHero` already existed and are unchanged — this block
 * only chooses between them and passes the editor's words through. Keeping the
 * two components rather than merging them matters: the video hero is a
 * full-screen arrival with a poster fallback and its own scrim, the page hero
 * is a compact band, and folding both into one component with a `variant` flag
 * would mean every future change to either having to reason about the other.
 *
 * The CTA is rendered here rather than inside `VideoHero` because it belongs
 * to the block's fields, not to the hero's chrome. It carries `.btn--on-dark`:
 * the scrim under it is dark in BOTH themes, so it is the one button on the
 * site that cannot follow the theme tokens. See global.css.
 */
import VideoHero from '../VideoHero.astro';
import PageHero from '../PageHero.astro';
import { getArtwork, heroArtwork } from '../../lib/artwork';
import type { SanityImage } from '../../lib/sanity/client';

interface Props {
  block: {
    variant?: 'video' | 'page';
    eyebrow?: string;
    headline: string;
    sub?: string;
    ctaLabel?: string;
    ctaHref?: string;
    crumbLabel?: string;
    videoUrl?: string;
    posterSlot?: string;
    /** Background picture for a standard hero. The video variant uses `posterSlot`. */
    image?: SanityImage;
  };
}

const { block } = Astro.props;
const isVideo = block.variant === 'video';

/* Only looked up for a video hero, and only when a slot was picked. The still
   is shown before the video paints and whenever it cannot play at all, so on a
   slow connection it may be the only thing a visitor sees. */
const poster = isVideo && block.posterSlot ? await getArtwork(block.posterSlot) : undefined;

/* The band's backdrop: this page's own picture, or the site-wide one when the
   editor has not set one here. `heroArtwork` owns that fallback so the eleven
   other `PageHero` call sites do not each re-decide it. */
const art = isVideo ? undefined : await heroArtwork(block.image);

/* Every inner page's trail is "Home / <this page>", so it is built here
   rather than typed into each document — one fewer thing to get wrong, and
   the Home link can never point somewhere else on one page only. */
const crumbs = block.crumbLabel
  ? [{ label: 'Home', href: '/' }, { label: block.crumbLabel }]
  : undefined;

const hasCta = Boolean(block.ctaLabel && block.ctaHref);
---

{
  isVideo ? (
    <VideoHero
      src={isVideo ? block.videoUrl : undefined}
      poster={poster?.src}
      eyebrow={block.eyebrow}
      headline={block.headline}
      sub={block.sub}
    >
      {hasCta && (
        <a href={block.ctaHref} class="btn btn--on-dark" data-reveal data-reveal-delay="0.24">
          {block.ctaLabel}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      )}
    </VideoHero>
  ) : (
    <PageHero
      eyebrow={block.eyebrow}
      title={block.headline}
      lead={block.sub}
      crumbs={crumbs}
      image={art}
    />
  )
}
