---
/**
 * The logo wall. Renders nothing while no clients are published — an empty
 * logo wall reads as a new studio pretending, which is worse than no wall.
 */
import SectionHead from './SectionHead.astro';
import { getClients } from '../../lib/studio';

interface Props {
  block: { eyebrow?: string; title?: string; anchor?: string };
}
const { block } = Astro.props;
const clients = await getClients();
---

{
  clients.length > 0 && (
    <section class="section section--bordered" id={block.anchor}>
      <SectionHead eyebrow={block.eyebrow} title={block.title} />
      <ul class="clients" data-reveal>
        {clients.map((c) => (
          <li class="client">
            {/* The name is a perfectly good logo wall on its own, and a real
                fallback rather than a placeholder box — a client added before
                their logo arrives still reads correctly. */}
            {c.logo ? <img class="client-logo" src={c.logo} alt={c.name} loading="lazy" /> : c.name}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /*
    Wrapping flex rather than `auto-fit`. `auto-fit` collapses a track only
    when nothing at all lands in it, so it covers a wall shorter than one row
    and nothing else — the eleventh logo starts a second row and the nine
    cells beside it become slabs of `--color-line` showing through the 1px
    gap. A flex line holds only real logos and grows them to fill it.
  */
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    overflow: hidden;
  }
  /* Height-capped rather than width-capped: logos arrive at wildly different
     aspect ratios and matching their heights is what makes a row of them look
     like a set instead of a pile. */
  .client-logo {
    display: block;
    max-height: 2rem;
    width: auto;
    object-fit: contain;
  }
  .client {
    flex: 1 1 10rem;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-ground);
    padding: 2rem 1rem;
    text-align: center;
    font-family: var(--font-label);
    font-size: calc(0.8rem * var(--type-label-scale, 1));
    color: var(--color-ink-muted);
  }
</style>
