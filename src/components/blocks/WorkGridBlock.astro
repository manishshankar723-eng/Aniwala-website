---
/**
 * The discipline tiles.
 *
 * A data block: the categories come from `workCategory` documents, which drive
 * the /portfolio/ URLs and so are structure. The editor supplies only the
 * heading — which is the point, since the alternative is a second list of
 * disciplines that immediately disagrees with the one the routes are built
 * from.
 *
 * The pictures come off those same documents. They used to be looked up by
 * the slot name `portfolio-<slug>` against a hardcoded list of six, which
 * meant a seventh discipline created in the Studio could never have one —
 * see `config/imageSlots.ts` for the whole argument.
 */
import SectionHead from './SectionHead.astro';
import { getWorkCategories, categoryHref } from '../../lib/workCategories';
import { isSafeMediaSrc } from '../../config/urls';
import { getServices } from '../../lib/services';
import { toArtwork } from '../../lib/artwork';

interface Props {
  block: {
    eyebrow?: string;
    title?: string;
    anchor?: string;
    linkLabel?: string;
    linkHref?: string;
    showFilter?: boolean;
  };
}
const { block } = Astro.props;

/*
 * The kicker over each tile's name is the FIRST service the discipline is
 * hired as — "3D Art" over "Character Design".
 *
 * Read off `services` rather than stored as its own field, because a second
 * field would be a second answer to a question the discipline already
 * answers, and the two would disagree the first time somebody edited one. It
 * is also the more useful of the two lines to a visitor who arrived knowing
 * what they want to buy rather than what it is called.
 *
 * A discipline with no service listed simply has no kicker; the name stands
 * on its own, which is what the tile did before this existed.
 */
const serviceTitle = new Map((await getServices()).map((s) => [s.slug, s.title]));

/* Sized once per category here rather than inside the template, where the
   guard and the two attributes that use it would each rebuild the same URLs. */
const tiles = (await getWorkCategories()).map((w) => {
  const art = toArtwork(w.image);
  return {
    ...w,
    art,
    /*
     * The same field that plays behind the discipline's own page band plays
     * here, in its tile. ONE upload, both places — exactly as `image` already
     * works, which is the whole reason this is not a second field.
     *
     * Gated on the picture for the same reason as the band: the still is this
     * video's poster, so without one the tile is a bare tint until the first
     * frame decodes. Scheme-checked because it is a CMS string reaching a
     * `src` — see `isSafeMediaSrc` in config/urls.ts.
     */
    loop: art && isSafeMediaSrc(w.video) ? w.video!.trim() : undefined,
    kicker: w.services.map((slug) => serviceTitle.get(slug)).find(Boolean),
  };
});

/*
 * The filter's options are DERIVED from the tiles, not from the full service
 * list. A chip that hides every tile is worse than no chip, and a service
 * nothing is filed under would do exactly that.
 */
const filters = block.showFilter
  ? [...new Set(tiles.flatMap((w) => w.services))]
      .map((slug) => ({ slug, title: serviceTitle.get(slug) }))
      .filter((f): f is { slug: string; title: string } => Boolean(f.title))
  : [];
---

<section class="section" id={block.anchor || "work"}>
  <SectionHead
    eyebrow={block.eyebrow}
    title={block.title}
    linkLabel={block.linkLabel}
    linkHref={block.linkHref}
  />

  {
    filters.length > 1 && (
      /*
        `hidden` until the script runs. These are buttons, not links — there
        is no per-service portfolio URL for them to point at — so without
        JavaScript they would be a row of controls that do nothing. Shipped
        hidden and revealed by the script, a reader without it sees the full
        grid and no dead furniture above it.
      */
      <nav class="chip-row work-filter" aria-label="Filter by service" hidden data-reveal>
        <button type="button" class="chip chip--filter is-active" data-filter="all" aria-pressed="true">
          All work
        </button>
        {filters.map((f) => (
          <button type="button" class="chip chip--filter" data-filter={f.slug} aria-pressed="false">
            {f.title}
          </button>
        ))}
      </nav>
    )
  }

  <div class="work-grid">
    {
      tiles.map((w) => (
        <a
          href={categoryHref(w.slug)}
          class="work-tile"
          style={`--tint:${w.tint}`}
          data-services={w.services.join(' ')}
          data-reveal
        >
          {/*
            The tint gradient stays underneath the image rather than being
            replaced by it, so the tile holds its colour while the picture
            loads and still looks deliberate if a slot is empty.

            `aria-hidden` and an empty alt: the tile's own title and blurb sit
            right beside this, so announcing the image as well would make a
            screen reader read every card twice.
          */}
          <span class="work-media" aria-hidden="true">
            {w.art && (
              <img
                class="work-img"
                src={w.art.src}
                srcset={w.art.srcset}
                sizes="(min-width: 1050px) 33vw, (min-width: 700px) 50vw, 100vw"
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            {w.loop && (
              /*
                Over the still, which stays as the poster. Muted and
                playsinline are not preferences: without both, iOS declines to
                autoplay and paints its own play button over the tile, turning
                a wall of moving work into a grid of paused videos.
              */
              /*
                `data-src`, not `src`. This is a GRID of background loops, so
                it is the worst case for parse-time fetching on the site: a
                browser handed six of these starts six of them, in parallel,
                against the same connection the page is still using. `attach`
                in lib/video.ts hands out the URLs after `load` and only to the
                tiles the viewport gate has reached — see the note beside the
                same attribute in VideoHero. The art is the poster and is
                already required here, so a tile that is waiting shows its
                picture rather than a hole.
              */
              <video
                class="work-video"
                data-video="silent"
                data-src={w.loop}
                poster={w.art!.src}
                autoplay
                muted
                loop
                playsinline
                preload="none"
                tabindex="-1"
              />
            )}
          </span>
          <span class="work-body">
            {w.kicker && <span class="work-kicker">{w.kicker}</span>}
            <span class="work-title">{w.title}</span>
            {/*
              Held back until hover. The tile reads as two lines at rest,
              which is what stops a wall of them turning into a wall of
              paragraphs — but the blurb is the only place a visitor is told
              what the discipline actually covers, so it is revealed rather
              than dropped. `max-height` and opacity only; no layout property
              animates, and the text is in the DOM for a crawler either way.
            */}
            <span class="work-blurb">{w.blurb}</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

{
  filters.length > 1 && (
    <script>
      /*
        Scoped to each grid by walking up from the nav, so two of these on one
        page filter their own tiles rather than each other's.

        `hidden` on the tile, not `display:none` in a class: the attribute is
        what assistive tech reads, and the grid is flex, so a hidden tile
        leaves the line rather than collapsing to a zero-width one.
      */
      for (const nav of document.querySelectorAll<HTMLElement>('.work-filter')) {
        const section = nav.closest('section');
        const tiles = section ? [...section.querySelectorAll('.work-tile')] : [];
        if (!tiles.length) continue;

        nav.hidden = false;
        nav.addEventListener('click', (event) => {
          const btn = (event.target as HTMLElement).closest('button[data-filter]');
          if (!btn) return;
          const want = btn.getAttribute('data-filter');

          for (const chip of nav.querySelectorAll('button[data-filter]')) {
            const on = chip === btn;
            chip.classList.toggle('is-active', on);
            chip.setAttribute('aria-pressed', String(on));
          }

          for (const tile of tiles) {
            const has = (tile.getAttribute('data-services') || '').split(' ');
            (tile as HTMLElement).hidden = want !== 'all' && !has.includes(want || '');
          }
        });
      }
    </script>
  )
}

<style>
  /*
   * SIX EQUAL TILES, and the count is the reason.
   *
   * These used to run three across with a `wide` tile spanning two columns.
   * Six tiles with two of them wide is eight column-units in a three-column
   * grid, which cannot fill three rows — so the last row came up one short
   * and the section ended on a hole. Worse, the tiles are a SET: six
   * disciplines, equal in standing, and sizing two of them larger read as a
   * layout fault rather than as emphasis. (Portfolio PIECES are a different
   * case and still use their wide modifier — an uneven gallery of stills
   * reads as rhythm. A menu of what the studio does does not.)
   *
   * Both column counts divide six exactly: two across gives three rows,
   * three across gives two. Whatever the screen, the grid comes out square.
   */
  /* Sits between the heading and the grid, so the space under the heading
     is already there — only the gap down to the tiles is needed. */
  .work-filter {
    margin-bottom: 1.5rem;
  }

  .work-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1050px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .work-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /*
     * PROPORTIONAL, not a fixed height. At a fixed 20rem a tile in a
     * three-column grid on a large monitor is 740px wide and 320 tall — a
     * letterbox slot that crops the picture to a strip. The ratio holds the
     * shape at every width; the floor keeps a narrow tile tall enough for the
     * title and blurb to sit in.
     */
    aspect-ratio: 16 / 10;
    min-height: 16rem;
    /*
     * Load bearing with the two lines above it. `min-height` wins over the
     * ratio, and a ratio box whose height is forced then derives its WIDTH
     * from it — so on a phone the 16rem floor made every tile 410px wide in a
     * 358px column and the whole page scrolled sideways. Pinning the width
     * makes the floor do only what it says: make a narrow tile taller.
     */
    width: 100%;
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    isolation: isolate;
  }

  /* The colour placeholder. Visible when a slot has no image filed against
     it, and behind one while it loads. */
  .work-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 90% 70% at 30% 20%, hsl(var(--tint) / 0.85), transparent 70%),
      linear-gradient(160deg, hsl(var(--tint) / 0.55), #0b0c10 75%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Sits on the tint. `object-fit: cover` plus the tile's own aspect ratio
     means a portrait upload crops rather than letterboxes; Sanity's hotspot
     decides which part survives. */
  .work-img,
  .work-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Faded in over the tile image rather than cutting to it, so a loop whose
     first frame is not the still does not snap when it starts. Neither
     attribute exists without JavaScript. See lib/video.ts. */
  .work-video[data-fade] {
    opacity: 0;
  }
  .work-video[data-fade][data-ready] {
    opacity: 1;
    transition: opacity 0.5s ease;
  }

  /* A tile that cannot move still shows its still — the same picture, holding
     still, which is the whole of what the setting asks for here. */
  @media (prefers-reduced-motion: reduce) {
    .work-video {
      display: none;
    }
  }

  .work-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 60%);
  }
  .work-tile:hover .work-media {
    transform: scale(1.06);
  }

  .work-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  /* The service over the name. Accent-on-dark rather than the theme accent:
     this sits on a photograph in both themes, so it cannot follow the page. */
  .work-kicker {
    font-family: var(--font-label);
    font-size: calc(0.8rem * var(--type-label-scale, 1));
    font-weight: calc(600 + var(--type-label-weight, 0));
    letter-spacing: calc(0.005em + var(--type-label-track, 0em));
    color: var(--color-accent-on-dark);
  }

  .work-title {
    font-family: var(--font-display);
    font-weight: calc(750 + var(--type-heading-weight, 0));
    font-stretch: 108%;
    letter-spacing: calc(-0.015em + var(--type-heading-track, 0em));
    font-size: calc(1.35rem * var(--type-heading-scale, 1));
    line-height: 1.2;
    color: #f4f4f2;
  }

  /*
   * Revealed on hover and on keyboard focus, never on touch — `hover: hover`
   * keeps it collapsed on a phone, where there is no hover to trigger it and
   * a tile that opened on tap would fight the link it is wrapped in.
   *
   * `max-height` to a fixed ceiling rather than `auto`: `auto` does not
   * animate, and `interpolate-size` is not broad enough to rely on for
   * something this small. 6em clears three lines at this size.
   */
  .work-blurb {
    font-size: calc(0.88rem * var(--type-label-scale, 1));
    line-height: 1.45;
    color: rgb(255 255 255 / 0.78);
  }
  @media (hover: hover) {
    .work-blurb {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition:
        max-height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.25s ease,
        margin-top 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .work-tile:hover .work-blurb,
    .work-tile:focus-visible .work-blurb {
      max-height: 6em;
      opacity: 1;
      margin-top: 0.4rem;
    }
  }
</style>
