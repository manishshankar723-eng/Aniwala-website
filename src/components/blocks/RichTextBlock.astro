---
/**
 * A rich-text passage: headings, paragraphs, lists and links.
 *
 * Rendered through the same `renderBody` the blog uses, so a link, a list or a
 * code span looks identical wherever it appears. `set:html` is safe here in
 * the sense that matters: the HTML is generated by our own Portable Text
 * renderer from a constrained block schema, not passed through from an
 * editor's raw input.
 */
import SectionHead from './SectionHead.astro';
import { renderBody } from '../../lib/sanity/portableText';

interface Props {
  block: { eyebrow?: string; title?: string; anchor?: string; body?: unknown[] };
}
const { block } = Astro.props;

const { html } = renderBody((block.body ?? []) as never[]);
---

<section class="section section--bordered" id={block.anchor}>
  <SectionHead eyebrow={block.eyebrow} title={block.title} />
  <div class="prose" data-reveal set:html={html} />
</section>

<style>
  /* `.prose` is styled globally — the blog and case studies use the same
     class, so a paragraph reads the same width and rhythm everywhere. */
  .prose {
    max-width: 68ch;
  }
</style>
