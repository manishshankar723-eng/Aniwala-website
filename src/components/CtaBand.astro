---

import { getContactDetails, getNavigation } from '../lib/studio';

/**
 * The closing panel every inner page ends on. One primary action, one quiet
 * one — a page that ends in six equal links ends in none of them.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  /** Overrides the site-wide CTA from nav.ts when a page needs its own. */
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

/* The studio inbox now comes from the CMS, so the address in the footer and
   the one on every CTA band cannot drift apart. */
const { email } = await getContactDetails();
const { ctaLabel, ctaHref } = await getNavigation();
const cta = { label: ctaLabel, href: ctaHref };

const {
  eyebrow = 'Next step',
  title = 'Tell us the deadline first.',
  body = 'We\'ll tell you straight whether we can hit it, and what it would take if we can. No deck, no discovery phase. Just an answer within two working days.',
  primary = cta,
  secondary = { label: 'Email the studio', href: `mailto:${email}` },
} = Astro.props;
---

<section class="cta-band">
  <div class="cta-band-inner" data-reveal>
    <div class="cta-band-copy">
      <p class="section-eyebrow">{eyebrow}</p>
      <h2 class="cta-band-title">{title}</h2>
      <p class="cta-band-body">{body}</p>
    </div>

    <div class="cta-band-actions">
      <a href={primary.href} class="cta-band-primary">{primary.label}</a>
      {secondary && <a href={secondary.href} class="cta-band-secondary">{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    border-top: 1px solid var(--color-line);
    background:
      radial-gradient(
        ellipse 60% 120% at 85% 50%,
        color-mix(in srgb, var(--color-accent) 10%, transparent),
        transparent 70%
      ),
      var(--color-surface);
  }

  .cta-band-inner {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6.5rem) var(--gutter);
    display: grid;
    gap: 2.5rem;
    align-items: end;
    grid-template-columns: 1fr;
  }
  @media (min-width: 950px) {
    .cta-band-inner {
      grid-template-columns: 1.6fr 1fr;
      gap: 4rem;
    }
  }

  .cta-band-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 780;
    font-stretch: 110%;
    letter-spacing: -0.028em;
    line-height: 1.05;
    font-size: clamp(1.9rem, 4.6vw, 4.2rem);
    text-wrap: balance;
    max-width: 20ch;
  }
  .cta-band-body {
    margin: 1.25rem 0 0;
    max-width: 50ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .cta-band-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  @media (min-width: 950px) {
    .cta-band-actions {
      justify-content: flex-end;
    }
  }

  .cta-band-primary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.75rem;
    border-radius: 0.3rem;
    background: var(--color-cta);
    color: var(--color-cta-ink);
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }
  .cta-band-primary:hover {
    background: var(--color-cta-hover);
  }

  .cta-band-secondary {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.015em;
    color: var(--color-ink-muted);
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-line-strong);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .cta-band-secondary:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
