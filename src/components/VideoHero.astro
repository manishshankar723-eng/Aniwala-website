---
import { getUiCopy } from '../lib/studio';
import { inlineHtml } from '../lib/copy';
import { isSafeMediaSrc } from '../config/urls';

const ui = await getUiCopy();

interface Props {
  eyebrow?: string;
  headline: string;
  sub?: string;
  /**
   * The background loop. A full https:// URL to a video host, or a path under
   * `public/`. Omit for poster only, which is what this renders when nobody
   * has set one — see the note on `videoUrl` in the Studio for why it is a
   * link rather than an upload.
   */
  src?: string;
  /** Still frame shown before the video paints, and the fallback if it can't play. */
  poster?: string;
  /**
   * Offer the sound.
   *
   * The hero is muted either way — no browser autoplays audio on a video
   * nobody has touched. This only decides whether a visitor gets a control to
   * turn it on.
   */
  sound?: boolean;
}

const { eyebrow, headline, sub, src: rawSrc, poster, sound = false } = Astro.props;

/**
 * The background loop, refused unless it points somewhere a video may live.
 *
 * `src` arrives from the `videoUrl` field on a hero block, which is inside the
 * `.passthrough()` block array — so unlike every href on the site it passed
 * through no schema on the way here. See `isSafeMediaSrc` in config/urls.ts
 * for why that gap existed and why the CSP alone was not the answer.
 *
 * A refused value degrades to the POSTER, which is exactly what `resolveVideo`
 * in lib/pieces.ts does with a malformed piece video: show the still rather
 * than an empty player. Visible, harmless, and obvious enough that whoever
 * pasted it will report it.
 */
const src = isSafeMediaSrc(rawSrc) ? rawSrc!.trim() : undefined;

/* Nothing to unmute without a video. */
const offerSound = sound && Boolean(src);

/**
 * The MIME type, from the extension.
 *
 * `<source>` was hardcoded to `video/mp4`. That is a promise to the browser
 * about what it is being handed, and Safari in particular refuses a source
 * whose declared type does not match — so a WebM pasted into the URL field
 * would silently show the poster and nothing else, with no error anywhere.
 * The query string is stripped first, because a CDN link routinely carries one.
 */
const videoType = (() => {
  const ext = (src ?? '').split(/[?#]/)[0].split('.').pop()?.toLowerCase();
  if (ext === 'webm') return 'video/webm';
  if (ext === 'ogv' || ext === 'ogg') return 'video/ogg';
  return 'video/mp4';
})();

/**
 * Honour "reduce motion".
 *
 * A full-screen video playing on its own behind the headline is the clearest
 * case there is for that setting, and CSS cannot help: `autoplay` has already
 * fired by the time a media query could apply. Pausing leaves the poster
 * showing — the same picture, holding still.
 *
 * Inline and unbundled, because it has to run before the first frame paints
 * and a module script is deferred until the document is parsed — long enough
 * to show the motion somebody asked not to see.
 *
 * Passed through `set:html` rather than written between the script tags.
 * Astro treats a script's children as raw text, so an expression written
 * there is emitted with its braces and backticks intact and the browser gets
 * a syntax error. That shipped once; it builds perfectly and breaks only in a
 * browser, which is the worst combination.
 */
const REDUCED_MOTION_SCRIPT = `(() => {
  const q = matchMedia('(prefers-reduced-motion: reduce)');
  const v = document.currentScript.closest('.hero').querySelector('video.hero-video');
  const apply = () => {
    if (!v) return;
    if (q.matches) { v.pause(); v.removeAttribute('autoplay'); }
    else { v.play().catch(() => {}); }
  };
  apply();
  q.addEventListener('change', apply);
})();`;
---

<section class="hero">
  <div class="hero-media">
    {
      src ? (
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster}
          aria-hidden="true"
          tabindex="-1"
        >
          <source src={src} type={videoType} />
        </video>
      ) : poster ? (
        <img class="hero-video" src={poster} alt="" aria-hidden="true" />
      ) : null
    }
    <!-- Scrim: without it, white type over a bright frame is unreadable. -->
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    {eyebrow && <p class="hero-eyebrow" data-reveal>{eyebrow}</p>}
    {/*
      `inlineHtml`, never a bare `set:html`. The headline is a free-text CMS
      field, so passing it through raw made the Headline box a script console
      for anyone with a Studio login. `inlineHtml` escapes the whole string and
      then re-permits only attribute-free `<br>` / `<em>` / `<strong>`-shaped
      tags, which is all a headline ever wanted. See src/lib/copy.ts.
    */}
    <h1
      class="hero-headline"
      data-reveal
      data-reveal-delay="0.08"
      set:html={inlineHtml(headline)}
    />
    {
      sub && (
        <p class="hero-sub" data-reveal data-reveal-delay="0.16">
          {sub}
        </p>
      )
    }
    {/*
      Wrapped, so the slotted CTA gets air above it. It used to sit straight
      after the sub-paragraph with nothing but line-box spacing between them,
      which read as the button being stuck to the text. The page hero's
      buttons already had `.hero-actions` at this spacing; the video hero's
      never did because the CTA is slotted in from the block, and a parent's
      scoped styles do not reach slotted content.

      Guarded, or an empty wrapper would add the margin on a hero with no CTA.
    */}
    {(Astro.slots.has('default') || offerSound) && (
      <div class="hero-actions">
        <slot />
        {offerSound && (
          /*
            HIDDEN UNTIL THE SOUND IS ACTUALLY ON. Whether the hero has audio
            is an editorial decision and it lives in the Studio; putting a
            control for it on the page as well says "here is a setting" to
            every visitor, on a hero whose job is to say one thing.

            It appears only once audio is playing, and then it is the way to
            stop it. That part is not decoration: audio a visitor cannot
            silence is what makes people close the tab, and WCAG 1.4.2 asks
            for a way to stop anything that plays for more than three seconds.

            Beside the call to action rather than in a corner, so when it does
            appear it is where the other choice already is.
          */
          <button class="hero-sound" type="button" data-hero-sound aria-pressed="false" hidden>
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
              <path d="M8 2.5 4.8 5.2H2.4v5.6h2.4L8 13.5V2.5Z" />
              <path class="hero-sound-off" d="M10.4 6.1 12 7.7l1.6-1.6.9.9L12.9 8.6l1.6 1.6-.9.9L12 9.5l-1.6 1.6-.9-.9 1.6-1.6-1.6-1.6.9-.9Z" />
              <path class="hero-sound-on" d="M10.6 5.6a3.4 3.4 0 0 1 0 4.8l-.9-.9a2.1 2.1 0 0 0 0-3l.9-.9Zm1.8-1.8a6 6 0 0 1 0 8.4l-.9-.9a4.7 4.7 0 0 0 0-6.6l.9-.9Z" />
            </svg>
            <span class="hero-sound-label">Mute</span>
          </button>
        )}
      </div>
    )}
  </div>

  {src && <script is:inline set:html={REDUCED_MOTION_SCRIPT} />}

  {
    offerSound && (
      <script>
        {/*
          THE SETTING DECIDES, NOT THE VISITOR. When the hero is marked as
          having sound, the audio comes on by itself — the button is left as
          the way to turn it OFF again, not as the way to turn it on.

          It cannot come on at load, and that is not a choice made here: a
          browser mutes any video that plays before the visitor has touched
          the page, and there is no flag, policy or permission that changes
          it. The first real interaction — a click, a key, a scroll — is the
          earliest moment the sound is allowed to exist, so that is when it
          starts. Anything else on the page still works normally; the gesture
          is only listened for, never swallowed.

          A press of the button itself is excluded, or the pointer event would
          unmute a moment before the click handler muted it again.

          `volume` is raised from 0 rather than set once, so sound fades in
          over a moment instead of arriving at full level — a hero is the
          whole screen, and a showreel that shouts is the thing people reach
          for the tab close on.
        */}
        const btn = document.querySelector<HTMLButtonElement>('.hero-sound[data-hero-sound]');
        const video = document.querySelector('video.hero-video') as HTMLVideoElement | null;

        if (video) {
          const label = btn?.querySelector('.hero-sound-label');

          const show = (on: boolean) => {
            if (btn) {
              /* Revealed the first time sound starts and left in place after
                 that. Taking it away again when muted would strand anybody
                 who pressed it by accident. */
              btn.hidden = false;
              btn.setAttribute('aria-pressed', String(on));
            }
            if (label) label.textContent = on ? 'Mute' : 'Sound on';
          };

          const unmute = () => {
            video.volume = 0;
            video.muted = false;
            let v = 0;
            const fade = setInterval(() => {
              v = Math.min(1, v + 0.08);
              video.volume = v;
              if (v >= 1) clearInterval(fade);
            }, 40);
            show(true);
          };

          /* The earliest gesture the browser will accept. Passive, so none of
             these are slowed down by being watched. */
          const GESTURES = ['pointerdown', 'keydown', 'touchstart', 'wheel'];
          const take = (event: Event) => {
            if ((event.target as HTMLElement)?.closest?.('[data-hero-sound]')) return;
            stop();
            if (video.muted) unmute();
          };
          const stop = () => GESTURES.forEach((g) => document.removeEventListener(g, take));
          GESTURES.forEach((g) => document.addEventListener(g, take, { passive: true }));

          btn?.addEventListener('click', () => {
            /* Whichever way this goes, the visitor has now decided — so the
               automatic one must not fire later and override them. */
            stop();
            if (video.muted) unmute();
            else {
              video.muted = true;
              show(false);
            }
          });
        }
      </script>
    )
  }

  <a class="hero-scroll" href="#main" data-reveal data-reveal-delay="0.3">
    <span class="hero-scroll-label">{ui.heroScrollLabel}</span>
    <span class="hero-scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Shows through before the video paints, and if there is no media at all,
       so the hero never renders as a flat empty rectangle. */
    background:
      radial-gradient(
        ellipse 80% 60% at 70% 20%,
        color-mix(in srgb, var(--color-accent) 18%, transparent),
        transparent 70%
      ),
      linear-gradient(160deg, var(--color-surface), var(--color-ground) 60%);
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.25) 45%, rgb(0 0 0 / 0.55) 100%);
  }

  .hero-content {
    padding: 0 var(--gutter) clamp(4.5rem, 7vw, 6rem);
    max-width: var(--shell-max);
    margin: 0 auto;
    width: 100%;
  }

  /* The hero always sits on a dark scrim over video, in BOTH themes, so its
     type is pinned to light-on-dark rather than following the theme tokens.
     Using --color-ink here would render near-black on the scrim in light mode. */
  .hero-eyebrow {
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: var(--color-accent-on-dark);
    margin: 0 0 1.25rem;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-weight: calc(800 + var(--type-display-weight, 0));
    font-stretch: 118%;
    letter-spacing: calc(-0.03em + var(--type-display-track, 0em));
    line-height: 0.95;
    font-size: calc(clamp(2.75rem, 7vw, 8rem) * var(--type-display-scale, 1));
    text-wrap: balance;
    margin: 0;
    max-width: 16ch;
    color: #f4f4f2;
  }

  .hero-sub {
    margin: 1.75rem 0 0;
    max-width: 46ch;
    font-size: calc(1.05rem * var(--type-body-scale, 1));
    line-height: 1.6;
    color: rgb(255 255 255 / 0.72);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    /* Matches the page hero's actions, so the two heroes space the same. */
    margin-top: 2.25rem;
  }

  /*
    Sits in the actions row, so it inherits the spacing the CTA already has.
    Deliberately quieter than the CTA next to it: this is a choice offered, not
    the thing the page is asking anybody to do.
  */
  .hero-sound {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.1rem;
    height: 2.9rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.28);
    background: rgb(0 0 0 / 0.35);
    color: #f4f4f2;
    cursor: pointer;
    font-family: var(--font-label);
    font-size: calc(0.85rem * var(--type-label-scale, 1));
    font-weight: calc(600 + var(--type-label-weight, 0));
    backdrop-filter: blur(6px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .hero-sound:hover,
  .hero-sound:focus-visible {
    background: rgb(0 0 0 / 0.6);
    border-color: rgb(255 255 255 / 0.55);
  }
  .hero-sound svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  /* The icon states the ACTION: crossed speaker means press to hear. */
  .hero-sound .hero-sound-on {
    display: none;
  }
  .hero-sound[aria-pressed='true'] .hero-sound-off {
    display: none;
  }
  .hero-sound[aria-pressed='true'] .hero-sound-on {
    display: inline;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: rgb(255 255 255 / 0.6);
  }
  @media (min-width: 640px) {
    .hero-scroll {
      display: flex;
    }
  }
  .hero-scroll-label {
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    writing-mode: vertical-rl;
  }
  .hero-scroll-line {
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.35), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero-scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent-on-dark);
    animation: scroll-cue 2s ease-in-out infinite;
  }
  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line::after {
      animation: none;
      opacity: 0.4;
    }
  }
</style>
