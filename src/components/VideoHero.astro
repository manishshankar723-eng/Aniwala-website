---
import { getUiCopy } from '../lib/studio';
import { inlineHtml } from '../lib/copy';
import { isSafeMediaSrc } from '../config/urls';

const ui = await getUiCopy();

interface Props {
  eyebrow?: string;
  headline: string;
  sub?: string;
  /**
   * The background loop. A full https:// URL to a video host, or a path under
   * `public/`. Omit for poster only, which is what this renders when nobody
   * has set one — see the note on `videoUrl` in the Studio for why it is a
   * link rather than an upload.
   */
  src?: string;
  /** Still frame shown before the video paints, and the fallback if it can't play. */
  poster?: string;
}

const { eyebrow, headline, sub, src: rawSrc, poster } = Astro.props;

/**
 * The background loop, refused unless it points somewhere a video may live.
 *
 * `src` arrives from the `videoUrl` field on a hero block, which is inside the
 * `.passthrough()` block array — so unlike every href on the site it passed
 * through no schema on the way here. See `isSafeMediaSrc` in config/urls.ts
 * for why that gap existed and why the CSP alone was not the answer.
 *
 * A refused value degrades to the POSTER, which is exactly what `resolveVideo`
 * in lib/pieces.ts does with a malformed piece video: show the still rather
 * than an empty player. Visible, harmless, and obvious enough that whoever
 * pasted it will report it.
 */
const src = isSafeMediaSrc(rawSrc) ? rawSrc!.trim() : undefined;

/**
 * The MIME type, from the extension.
 *
 * `<source>` was hardcoded to `video/mp4`. That is a promise to the browser
 * about what it is being handed, and Safari in particular refuses a source
 * whose declared type does not match — so a WebM pasted into the URL field
 * would silently show the poster and nothing else, with no error anywhere.
 * The query string is stripped first, because a CDN link routinely carries one.
 */
const videoType = (() => {
  const ext = (src ?? '').split(/[?#]/)[0].split('.').pop()?.toLowerCase();
  if (ext === 'webm') return 'video/webm';
  if (ext === 'ogv' || ext === 'ogg') return 'video/ogg';
  return 'video/mp4';
})();

/*
 * THE HERO IS SILENT. Not "muted until someone asks" — silent.
 *
 * There used to be a `sound` field on the hero block and a script under it
 * that waited for the visitor's first click, scroll or keypress and used it as
 * the gesture a browser requires before audio may start. It worked, which was
 * the problem: arriving at a site and having a full-screen showreel start
 * talking at you on the first scroll is the thing people close the tab over,
 * and the field made it one checkbox away on every hero on the site.
 *
 * So the decision is no longer an editor's to make. `data-video="silent"` is
 * the contract with `lib/video.ts`, which re-asserts `muted` on every event
 * that could have changed it — the attribute alone is a starting state, not a
 * guarantee. The same module keeps the loop running; the inline reduced-motion
 * snippet that used to live here has moved there too, because `ClientRouter`
 * never re-ran it after the first page and the hero came back from other pages
 * frozen on its poster.
 */
---

<section class="hero">
  <div class="hero-media">
    {
      /*
        The still as a real element, UNDER the video, whenever there is both.
        It duplicates the `poster` attribute on purpose: the attribute is what
        a page with no JavaScript uses, and this is what the video fades in
        over when there is JavaScript. Same URL, so the browser fetches it once
        and the two can never disagree.
      */
      src && poster && (
        /*
          THE LARGEST ELEMENT ON THE HOMEPAGE, so it is told so. With the loop
          deferred to `lib/video.ts` this still is not a placeholder any more —
          it is what the hero IS for the first second or two of every visit,
          and on a metered connection it is what the hero stays. `high` moves
          it ahead of the forty tiles below the fold that the preload scanner
          finds in the same pass; `eager` says out loud what its position
          already implies, so it cannot be lost to a lazy-by-default heuristic.
        */
        <img
          class="hero-still"
          src={poster}
          alt=""
          aria-hidden="true"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      )
    }
    {
      src ? (
        <video
          class="hero-video"
          data-video="silent"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster={poster}
          aria-hidden="true"
          tabindex="-1"
        >
          {/*
            `data-src`, not `src`, and that one letter is the difference
            between a hero that decorates the page and one that blocks it.

            With a real `src` the browser begins pulling the file the moment
            the parser reaches this tag — competing with the stylesheet, the
            preloaded faces and the still right above it, on a phone's one
            shared connection, at a priority nothing in the page can lower. The
            loop is decoration; the headline is the page. Deferred, the still
            paints immediately and `lib/video.ts` attaches this after `load`,
            crossfading in over it exactly as `fadeIn` was built to.

            See `attach` in lib/video.ts, which is the only thing that ever
            reads this. Without JavaScript the poster stands, which is already
            what a refused `src` degrades to above.
          */}
          <source data-src={src} type={videoType} />
        </video>
      ) : poster ? (
        <img class="hero-video" src={poster} alt="" aria-hidden="true" />
      ) : null
    }
    <!-- Scrim: without it, white type over a bright frame is unreadable. -->
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    {eyebrow && <p class="hero-eyebrow" data-reveal>{eyebrow}</p>}
    {/*
      `inlineHtml`, never a bare `set:html`. The headline is a free-text CMS
      field, so passing it through raw made the Headline box a script console
      for anyone with a Studio login. `inlineHtml` escapes the whole string and
      then re-permits only attribute-free `<br>` / `<em>` / `<strong>`-shaped
      tags, which is all a headline ever wanted. See src/lib/copy.ts.
    */}
    <h1
      class="hero-headline"
      data-reveal
      data-reveal-delay="0.08"
      set:html={inlineHtml(headline)}
    />
    {
      sub && (
        <p class="hero-sub" data-reveal data-reveal-delay="0.16">
          {sub}
        </p>
      )
    }
    {/*
      Wrapped, so the slotted CTA gets air above it. It used to sit straight
      after the sub-paragraph with nothing but line-box spacing between them,
      which read as the button being stuck to the text. The page hero's
      buttons already had `.hero-actions` at this spacing; the video hero's
      never did because the CTA is slotted in from the block, and a parent's
      scoped styles do not reach slotted content.

      Guarded, or an empty wrapper would add the margin on a hero with no CTA.
    */}
    {Astro.slots.has('default') && (
      <div class="hero-actions">
        <slot />
      </div>
    )}
  </div>

  <a class="hero-scroll" href="#main" data-reveal data-reveal-delay="0.3">
    <span class="hero-scroll-label">{ui.heroScrollLabel}</span>
    <span class="hero-scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Shows through before the video paints, and if there is no media at all,
       so the hero never renders as a flat empty rectangle. */
    background:
      radial-gradient(
        ellipse 80% 60% at 70% 20%,
        color-mix(in srgb, var(--color-accent) 18%, transparent),
        transparent 70%
      ),
      linear-gradient(160deg, var(--color-surface), var(--color-ground) 60%);
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Behind the video, filling the same box with the same crop — anything else
     and the fade would also be a shift. */
  .hero-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-video[data-fade] {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  /* `data-ready` is set two painted frames after playback actually starts, so
     this crossfades from the still rather than from a blank box. See the note
     on `fadeIn` in lib/video.ts for why neither attribute exists without
     JavaScript. */
  .hero-video[data-fade][data-ready] {
    opacity: 1;
    transition: opacity 0.7s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video[data-fade][data-ready] {
      transition: none;
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.25) 45%, rgb(0 0 0 / 0.55) 100%);
  }

  .hero-content {
    padding: 0 var(--gutter) clamp(4.5rem, 7vw, 6rem);
    max-width: var(--shell-max);
    margin: 0 auto;
    width: 100%;
  }

  /* The hero always sits on a dark scrim over video, in BOTH themes, so its
     type is pinned to light-on-dark rather than following the theme tokens.
     Using --color-ink here would render near-black on the scrim in light mode. */
  .hero-eyebrow {
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: var(--color-accent-on-dark);
    margin: 0 0 1.25rem;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-weight: calc(800 + var(--type-display-weight, 0));
    font-stretch: 118%;
    letter-spacing: calc(-0.03em + var(--type-display-track, 0em));
    line-height: 0.95;
    font-size: calc(clamp(2.75rem, 7vw, 8rem) * var(--type-display-scale, 1));
    text-wrap: balance;
    margin: 0;
    max-width: 16ch;
    color: #f4f4f2;
  }

  .hero-sub {
    margin: 1.75rem 0 0;
    max-width: 46ch;
    font-size: calc(1.05rem * var(--type-body-scale, 1));
    line-height: 1.6;
    color: rgb(255 255 255 / 0.72);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    /* Matches the page hero's actions, so the two heroes space the same. */
    margin-top: 2.25rem;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: rgb(255 255 255 / 0.6);
  }
  @media (min-width: 640px) {
    .hero-scroll {
      display: flex;
    }
  }
  .hero-scroll-label {
    font-family: var(--font-label);
    font-size: calc(0.72rem * var(--type-label-scale, 1));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    writing-mode: vertical-rl;
  }
  .hero-scroll-line {
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.35), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero-scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent-on-dark);
    animation: scroll-cue 2s ease-in-out infinite;
  }
  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line::after {
      animation: none;
      opacity: 0.4;
    }
  }
</style>
