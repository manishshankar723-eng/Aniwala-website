---
import { getUiCopy } from '../lib/studio';

const ui = await getUiCopy();

interface Props {
  eyebrow?: string;
  headline: string;
  sub?: string;
  /**
   * The background loop. A full https:// URL to a video host, or a path under
   * `public/`. Omit for poster only, which is what this renders when nobody
   * has set one — see the note on `videoUrl` in the Studio for why it is a
   * link rather than an upload.
   */
  src?: string;
  /** Still frame shown before the video paints, and the fallback if it can't play. */
  poster?: string;
}

const { eyebrow, headline, sub, src, poster } = Astro.props;

/**
 * The MIME type, from the extension.
 *
 * `<source>` was hardcoded to `video/mp4`. That is a promise to the browser
 * about what it is being handed, and Safari in particular refuses a source
 * whose declared type does not match — so a WebM pasted into the URL field
 * would silently show the poster and nothing else, with no error anywhere.
 * The query string is stripped first, because a CDN link routinely carries one.
 */
const videoType = (() => {
  const ext = (src ?? '').split(/[?#]/)[0].split('.').pop()?.toLowerCase();
  if (ext === 'webm') return 'video/webm';
  if (ext === 'ogv' || ext === 'ogg') return 'video/ogg';
  return 'video/mp4';
})();

/**
 * Honour "reduce motion".
 *
 * A full-screen video playing on its own behind the headline is the clearest
 * case there is for that setting, and CSS cannot help: `autoplay` has already
 * fired by the time a media query could apply. Pausing leaves the poster
 * showing — the same picture, holding still.
 *
 * Inline and unbundled, because it has to run before the first frame paints
 * and a module script is deferred until the document is parsed — long enough
 * to show the motion somebody asked not to see.
 *
 * Passed through `set:html` rather than written between the script tags.
 * Astro treats a script's children as raw text, so an expression written
 * there is emitted with its braces and backticks intact and the browser gets
 * a syntax error. That shipped once; it builds perfectly and breaks only in a
 * browser, which is the worst combination.
 */
const REDUCED_MOTION_SCRIPT = `(() => {
  const q = matchMedia('(prefers-reduced-motion: reduce)');
  const v = document.currentScript.closest('.hero').querySelector('video.hero-video');
  const apply = () => {
    if (!v) return;
    if (q.matches) { v.pause(); v.removeAttribute('autoplay'); }
    else { v.play().catch(() => {}); }
  };
  apply();
  q.addEventListener('change', apply);
})();`;
---

<section class="hero">
  <div class="hero-media">
    {
      src ? (
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster}
          aria-hidden="true"
          tabindex="-1"
        >
          <source src={src} type={videoType} />
        </video>
      ) : poster ? (
        <img class="hero-video" src={poster} alt="" aria-hidden="true" />
      ) : null
    }
    <!-- Scrim: without it, white type over a bright frame is unreadable. -->
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    {eyebrow && <p class="hero-eyebrow" data-reveal>{eyebrow}</p>}
    <h1 class="hero-headline" data-reveal data-reveal-delay="0.08" set:html={headline} />
    {
      sub && (
        <p class="hero-sub" data-reveal data-reveal-delay="0.16">
          {sub}
        </p>
      )
    }
    <slot />
  </div>

  {src && <script is:inline set:html={REDUCED_MOTION_SCRIPT} />}

  <a class="hero-scroll" href="#main" data-reveal data-reveal-delay="0.3">
    <span class="hero-scroll-label">{ui.heroScrollLabel}</span>
    <span class="hero-scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Shows through before the video paints, and if there is no media at all,
       so the hero never renders as a flat empty rectangle. */
    background:
      radial-gradient(
        ellipse 80% 60% at 70% 20%,
        color-mix(in srgb, var(--color-accent) 18%, transparent),
        transparent 70%
      ),
      linear-gradient(160deg, var(--color-surface), var(--color-ground) 60%);
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.25) 45%, rgb(0 0 0 / 0.55) 100%);
  }

  .hero-content {
    padding: 0 var(--gutter) clamp(4.5rem, 7vw, 6rem);
    max-width: var(--shell-max);
    margin: 0 auto;
    width: 100%;
  }

  /* The hero always sits on a dark scrim over video, in BOTH themes, so its
     type is pinned to light-on-dark rather than following the theme tokens.
     Using --color-ink here would render near-black on the scrim in light mode. */
  .hero-eyebrow {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-accent-on-dark);
    margin: 0 0 1.25rem;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 0.95;
    font-size: clamp(2.75rem, 7vw, 8rem);
    text-wrap: balance;
    margin: 0;
    max-width: 16ch;
    color: #f4f4f2;
  }

  .hero-sub {
    margin: 1.75rem 0 0;
    max-width: 46ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.72);
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    right: var(--gutter);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: rgb(255 255 255 / 0.6);
  }
  @media (min-width: 640px) {
    .hero-scroll {
      display: flex;
    }
  }
  .hero-scroll-label {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    writing-mode: vertical-rl;
  }
  .hero-scroll-line {
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.35), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero-scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent-on-dark);
    animation: scroll-cue 2s ease-in-out infinite;
  }
  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line::after {
      animation: none;
      opacity: 0.4;
    }
  }
</style>
