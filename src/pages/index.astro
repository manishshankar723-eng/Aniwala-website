---
import Base from '../layouts/Base.astro';
import VideoHero from '../components/VideoHero.astro';
import BookCall from '../components/BookCall.astro';
import Footer from '../components/Footer.astro';
import { nav } from '../config/nav';
import {
  workCategories,
  processSteps,
  capabilities,
  testimonials,
  clients,
  featuredPosts,
} from '../config/site';

const services = nav.find((i) => i.children)?.children ?? [];
---

<Base
  title="Aniwala Studios — Animation & Game Art"
  description="Aniwala Studios produces 2D and 3D animation, VFX and game art for games, film and brands."
  transparentHeader
>
  <VideoHero
    eyebrow="Animation & Game Art Studio"
    headline="We make things&nbsp;move."
    sub="2D, 3D, VFX and game art for games, film and brands — built by artists who tell you the truth about the schedule."
  >
    <a href="/portfolio/" class="hero-cta" data-reveal data-reveal-delay="0.24">
      See the work
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </VideoHero>

  <main id="main">
    <!-- Positioning. Deliberately short: the hero already showed the work. -->
    <section class="section section--intro">
      <p class="statement" data-reveal>
        A new studio, built by artists who have shipped for games and screen. We
        take a brief, agree the look before full production, and show you the work
        every week while it is still cheap to change.
      </p>
    </section>

    <!-- WORK — by craft discipline, not by client, so an art director can go
         straight to the team they need. -->
    <section class="section" id="work">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">Selected work</p>
        <h2 class="section-title">Take a closer look at what we make</h2>
        <a href="/portfolio/" class="section-link">
          Explore the full portfolio <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="work-grid">
        {
          workCategories.map((w) => (
            <a
              href={w.href}
              class:list={['work-tile', w.wide && 'work-tile--wide']}
              style={`--tint:${w.tint}`}
              data-reveal
            >
              {/* Placeholder art until real stills are imported via astro:assets. */}
              <span class="work-media" aria-hidden="true" />
              <span class="work-body">
                <span class="work-title">{w.title}</span>
                <span class="work-blurb">{w.blurb}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- SERVICES — a grid, not the carousel Lakshya uses. Carousels hide half
         the content behind an arrow most visitors never press. -->
    <section class="section section--bordered" id="services">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">What we do</p>
        <h2 class="section-title">Six disciplines, one pipeline</h2>
      </div>

      <div class="service-grid">
        {
          services.map((s) => (
            <a href={s.href} class="service" data-reveal>
              <h3 class="service-name">{s.label}</h3>
              <p class="service-blurb">{s.blurb}</p>
              <span class="service-arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          ))
        }
        <a href="/contact/" class="service service--cta" data-reveal>
          <h3 class="service-name">Something else?</h3>
          <p class="service-blurb">Tell us what you need and we will scope it honestly.</p>
          <span class="service-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- PROCESS — a real sequence, so it is genuinely numbered. This section
         does the job a back catalogue would do for an older studio. -->
    <section class="section section--bordered" id="process">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">How we work</p>
        <h2 class="section-title">No surprises at the end</h2>
      </div>

      <ol class="process">
        {
          processSteps.map((step, i) => (
            <li class="step" data-reveal>
              <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- CAPABILITIES — the pipeline question every first client asks. -->
    <section class="section section--bordered" id="capabilities">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">Pipeline</p>
        <h2 class="section-title">What we run</h2>
      </div>
      <ul class="tools" data-reveal>
        {capabilities.map((t) => <li class="tool">{t}</li>)}
      </ul>
    </section>

    {/* Proof sections render only when they hold something real. An empty logo
        wall or a zeroed stat counter reads as a new studio pretending. */}
    {
      clients.length > 0 && (
        <section class="section section--bordered">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">Clients</p>
            <h2 class="section-title">Studios we work with</h2>
          </div>
          <ul class="clients" data-reveal>
            {clients.map((c) => (
              <li class="client">{c.name}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      testimonials.length > 0 && (
        <section class="section section--bordered">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">Testimonials</p>
            <h2 class="section-title">What our clients say</h2>
          </div>
          <div class="quotes">
            {testimonials.map((t) => (
              <figure class="quote" data-reveal>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>
                    {t.role}, {t.company}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section class="section section--bordered" id="journal">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">Journal</p>
            <h2 class="section-title">The latest from the studio</h2>
            <a href="/blog/" class="section-link">
              All posts <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <div class="posts">
            {featuredPosts.map((p) => (
              <a href={p.href} class="post" data-reveal>
                <span class="post-meta">
                  {p.tag} · {p.readingTime}
                </span>
                <h3 class="post-title">{p.title}</h3>
                <p class="post-excerpt">{p.excerpt}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <BookCall />

    <!-- CAREERS — first-class, the way Lakshya treats Life@Lakshya. For an art
         studio hiring is existential, not a footer link. -->
    <section class="section section--bordered careers" id="careers">
      <div class="careers-inner" data-reveal>
        <div>
          <p class="section-eyebrow">Careers</p>
          <h2 class="section-title">We are looking for artists</h2>
          <p class="careers-body">
            Animators, modellers, riggers and FX artists. Send a reel — we watch
            every one, and we reply either way.
          </p>
        </div>
        <a href="/careers/" class="careers-cta">
          See open roles <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* --- Hero CTA (sits on the dark scrim, so pinned light-on-dark) ----- */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.25rem;
    padding: 0.85rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f4f4f2;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .hero-cta svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.25s ease;
  }
  .hero-cta:hover {
    background: #e4c24c;
    border-color: #e4c24c;
    color: #14161d;
  }
  .hero-cta:hover svg {
    transform: translateX(3px);
  }

  /* --- Work grid ------------------------------------------------------ */
  .work-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .work-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 16rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    isolation: isolate;
  }
  @media (min-width: 700px) {
    .work-tile {
      min-height: 20rem;
    }
    .work-tile--wide {
      grid-column: span 2;
    }
  }

  /* Placeholder art. Replace .work-media with a real <Image /> and this
     gradient simply stops being visible. */
  .work-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 90% 70% at 30% 20%, hsl(var(--tint) / 0.85), transparent 70%),
      linear-gradient(160deg, hsl(var(--tint) / 0.55), #0b0c10 75%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 60%);
  }
  .work-tile:hover .work-media {
    transform: scale(1.06);
  }

  .work-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.015em;
    font-size: 1.35rem;
    color: #f4f4f2;
  }
  .work-blurb {
    font-size: 0.88rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.72);
  }

  /* --- Services -------------------------------------------------------- */
  .service-grid {
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    overflow: hidden;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service {
    background: var(--color-ground);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.25s ease;
  }
  .service:hover {
    background: var(--color-surface);
  }
  .service-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    font-stretch: 108%;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .service-blurb {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .service-arrow {
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 1.2rem;
    color: var(--color-accent);
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .service:hover .service-arrow {
    transform: translateX(4px);
  }
  .service--cta .service-name {
    color: var(--color-accent);
  }

  /* --- Process (a genuine sequence, hence the numbers) ----------------- */
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .process {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .process {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-strong);
  }
  .step-n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--color-accent);
  }
  .step-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    font-stretch: 106%;
  }
  .step-body {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* --- Tools ----------------------------------------------------------- */
  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tool {
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
  }

  /* --- Clients / quotes / posts (hidden while empty) ------------------- */
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    overflow: hidden;
  }
  .client {
    background: var(--color-ground);
    padding: 2rem 1rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  .quotes {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .quote {
    margin: 0;
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
  }
  .quote blockquote {
    margin: 0 0 1.25rem;
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .quote figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  .quote figcaption strong {
    color: var(--color-ink);
  }

  .posts {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  .post {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .post:hover {
    border-color: var(--color-accent);
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .post-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .post-excerpt {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  /* --- Careers ---------------------------------------------------------- */
  .careers-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .careers-body {
    margin: 1.25rem 0 0;
    max-width: 44ch;
    color: var(--color-ink-muted);
    line-height: 1.6;
  }
  .careers-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .careers-cta:hover {
    background: var(--color-cta);
    border-color: var(--color-cta);
    color: var(--color-cta-ink);
  }
  .careers-cta span {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .careers-cta:hover span {
    transform: translateX(4px);
  }
</style>
