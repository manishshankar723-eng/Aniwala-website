---
import Base from '../layouts/Base.astro';
import VideoHero from '../components/VideoHero.astro';
import BookCall from '../components/BookCall.astro';
import CaseCard from '../components/CaseCard.astro';
import Marquee from '../components/Marquee.astro';
import Footer from '../components/Footer.astro';
import { nav } from '../config/nav';
import { processSteps } from '../config/site';
import { getSiteCopy, getTestimonials, getClients } from '../lib/studio';
import { workCategories, categoryHref } from '../config/portfolio';
import { portfolioSlot } from '../config/imageSlots';
import { getArtworkMap, getArtwork } from '../lib/artwork';
import { getCaseStudies } from '../lib/caseStudies';

const services = nav.find((i) => i.children)?.children ?? [];

/* Three, and no more. "View all" carries the rest. */
const caseStudies = (await getCaseStudies()).slice(0, 3);

/* One lookup for the whole grid. `getArtwork` per tile inside the loop would
   read the same collection six times for one section. */
const workArt = await getArtworkMap(workCategories.map((w) => portfolioSlot(w.slug)));

/* The still behind the hero. Shown before the video paints and whenever it
   cannot play at all, so it is the one image on the site guaranteed to be
   seen — on a slow connection it may be the only one. */
const heroPoster = await getArtwork('home-hero-poster');

const { marqueeItems, capabilities } = await getSiteCopy();
/* Both sections hide themselves while empty — see the notes on the old
   config arrays, which were left deliberately empty for the same reason. */
const testimonials = await getTestimonials();
const clients = await getClients();
---

<Base
  title="Aniwala Studios — Animation & Game Art"
  description="Aniwala Studios produces 2D and 3D animation, VFX and game art for games, film and brands."
  transparentHeader
>
  <VideoHero
    poster={heroPoster?.src}
    eyebrow="Animation & Game Art Studio"
    headline="We make things&nbsp;move."
    sub="2D, 3D, VFX and game art for games, film and brands. Built by artists who will tell you the truth about your schedule."
  >
    <a href="/portfolio/" class="hero-cta" data-reveal data-reveal-delay="0.24">
      See the work
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </VideoHero>

  <main id="main">
    <!-- Straight off the hero: what is actually on the desks, before any
         section header asks the visitor to commit to reading. -->
    <Marquee items={marqueeItems} />

    <!-- Positioning. Deliberately short: the hero already showed the work. -->
    <section class="section section--intro">
      <p class="statement" data-reveal>
        A new studio, built by artists who have shipped for games and screen. We
        take a brief, settle the look before full production starts, and show you
        the work every week while it's still cheap to change.
      </p>
    </section>

    <!-- WORK — by craft discipline, not by client, so an art director can go
         straight to the team they need. -->
    <section class="section" id="work">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">Selected work</p>
        <h2 class="section-title">Take a closer look at what we make</h2>
        <a href="/portfolio/" class="section-link">
          Explore the full portfolio <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="work-grid">
        {
          workCategories.map((w) => (
            <a
              href={categoryHref(w.slug)}
              class:list={['work-tile', w.wide && 'work-tile--wide']}
              style={`--tint:${w.tint}`}
              data-reveal
            >
              {/*
                The tint gradient stays underneath the image rather than being
                replaced by it, so the tile holds its colour while the picture
                loads and still looks deliberate if a slot is empty.

                `aria-hidden` and an empty alt: the tile's own title and blurb
                sit right beside this, so announcing the image as well would
                make a screen reader read every card twice. The alt text an
                editor writes is used where the image is content, not
                decoration.
              */}
              <span class="work-media" aria-hidden="true">
                {workArt.get(portfolioSlot(w.slug)) && (
                  <img
                    class="work-img"
                    src={workArt.get(portfolioSlot(w.slug))!.src}
                    srcset={workArt.get(portfolioSlot(w.slug))!.srcset}
                    sizes={w.wide ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
              <span class="work-body">
                <span class="work-title">{w.title}</span>
                <span class="work-blurb">{w.blurb}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- CASE STUDIES — the work taken apart. Sits directly after the work
         grid because it's the only genuinely load-bearing proof on the page:
         tiles show what we make, these show how, and how is what gets a new
         studio hired. -->
    {
      caseStudies.length > 0 && (
        <section class="section section--bordered" id="case-studies">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">Case studies</p>
            <h2 class="section-title">Projects with the working shown</h2>
            <a href="/case-studies/" class="section-link">
              View all <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <div class="cases">
            {caseStudies.map((c) => (
              <CaseCard study={c} />
            ))}
          </div>
        </section>
      )
    }

    <!-- SERVICES — a grid, not the carousel Lakshya uses. Carousels hide half
         the content behind an arrow most visitors never press. -->
    <section class="section section--bordered" id="services">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">What we do</p>
        <h2 class="section-title">Six disciplines, one pipeline</h2>
      </div>

      <div class="service-grid">
        {
          services.map((s) => (
            <a href={s.href} class="service" data-reveal>
              <h3 class="service-name">{s.label}</h3>
              <p class="service-blurb">{s.blurb}</p>
              <span class="service-arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          ))
        }
        <a href="/contact/" class="service service--cta" data-reveal>
          <h3 class="service-name">Something else?</h3>
          <p class="service-blurb">Tell us what you need and we'll scope it honestly.</p>
          <span class="service-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- PROCESS — a real sequence, so it is genuinely numbered. This section
         does the job a back catalogue would do for an older studio. -->
    <section class="section section--bordered" id="process">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">How we work</p>
        <h2 class="section-title">No surprises at the end</h2>
      </div>

      <ol class="process">
        {
          processSteps.map((step, i) => (
            <li class="step" data-reveal>
              <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- CAPABILITIES — the pipeline question every first client asks. -->
    <section class="section section--bordered" id="capabilities">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">Pipeline</p>
        <h2 class="section-title">What we run</h2>
      </div>
      <ul class="tools" data-reveal>
        {capabilities.map((t) => <li class="tool">{t}</li>)}
      </ul>
    </section>

    {/* Proof sections render only when they hold something real. An empty logo
        wall or a zeroed stat counter reads as a new studio pretending. */}
    {
      clients.length > 0 && (
        <section class="section section--bordered">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">Clients</p>
            <h2 class="section-title">Studios we work with</h2>
          </div>
          <ul class="clients" data-reveal>
            {clients.map((c) => (
              <li class="client">
                {/* The name is a perfectly good logo wall on its own, and a
                    real fallback rather than a placeholder box — a client
                    added before their logo arrives still reads correctly. */}
                {c.logo ? <img class="client-logo" src={c.logo} alt={c.name} loading="lazy" /> : c.name}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      testimonials.length > 0 && (
        <section class="section section--bordered">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">Testimonials</p>
            <h2 class="section-title">What our clients say</h2>
          </div>
          <div class="quotes">
            {testimonials.map((t) => (
              <figure class="quote" data-reveal>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>
                    {t.role}, {t.company}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <BookCall />

    <!-- CAREERS — first-class, the way Lakshya treats Life@Lakshya. For an art
         studio hiring is existential, not a footer link. -->
    <section class="section section--bordered careers" id="careers">
      <div class="careers-inner" data-reveal>
        <div>
          <p class="section-eyebrow">Careers</p>
          <h2 class="section-title">We're looking for artists</h2>
          <p class="careers-body">
            Animators, modellers, riggers and FX artists. Send a reel. We watch all
            of them and reply either way.
          </p>
        </div>
        <a href="/careers/" class="careers-cta">
          See open roles <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* --- Hero CTA (sits on the dark scrim, so pinned light-on-dark) ----- */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.25rem;
    padding: 0.85rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.015em;
    color: #f4f4f2;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .hero-cta svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.25s ease;
  }
  .hero-cta:hover {
    background: #e4c24c;
    border-color: #e4c24c;
    color: #14161d;
  }
  .hero-cta:hover svg {
    transform: translateX(3px);
  }

  /* --- Work grid ------------------------------------------------------ */
  .work-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .work-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 16rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    isolation: isolate;
  }
  @media (min-width: 700px) {
    .work-tile {
      min-height: 20rem;
    }
    .work-tile--wide {
      grid-column: span 2;
    }
  }

  /* The colour placeholder. Visible when a slot has no image filed against
     it, and behind one while it loads. */
  .work-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 90% 70% at 30% 20%, hsl(var(--tint) / 0.85), transparent 70%),
      linear-gradient(160deg, hsl(var(--tint) / 0.55), #0b0c10 75%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Sits on the tint. `object-fit: cover` plus the tile's own aspect ratio
     means a portrait upload crops rather than letterboxes; Sanity's hotspot
     decides which part survives. */
  .work-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 60%);
  }
  .work-tile:hover .work-media {
    transform: scale(1.06);
  }

  .work-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.015em;
    font-size: 1.35rem;
    color: #f4f4f2;
  }
  .work-blurb {
    font-size: 0.88rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.72);
  }

  /* --- Services -------------------------------------------------------- */
  .service-grid {
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    overflow: hidden;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service {
    background: var(--color-ground);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.25s ease;
  }
  .service:hover {
    background: var(--color-surface);
  }
  .service-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    font-stretch: 108%;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .service-blurb {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .service-arrow {
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 1.2rem;
    color: var(--color-accent);
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .service:hover .service-arrow {
    transform: translateX(4px);
  }
  .service--cta .service-name {
    color: var(--color-accent);
  }

  /* --- Process (a genuine sequence, hence the numbers) ----------------- */
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .process {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .process {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-strong);
  }
  .step-n {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-accent);
  }
  .step-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    font-stretch: 106%;
  }
  .step-body {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* --- Tools ----------------------------------------------------------- */
  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tool {
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
  }

  /* --- Clients / quotes / posts (hidden while empty) ------------------- */
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    overflow: hidden;
  }
  /* Height-capped rather than width-capped: logos arrive at wildly different
     aspect ratios and matching their heights is what makes a row of them look
     like a set instead of a pile. */
  .client-logo {
    display: block;
    max-height: 2rem;
    width: auto;
    object-fit: contain;
  }

  .client {
    background: var(--color-ground);
    padding: 2rem 1rem;
    text-align: center;
    font-family: var(--font-label);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  .quotes {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .quote {
    margin: 0;
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
  }
  .quote blockquote {
    margin: 0 0 1.25rem;
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .quote figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  .quote figcaption strong {
    color: var(--color-ink);
  }

  /* Cards themselves are CaseCard.astro; this only lays them out. */
  .cases {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 800px) {
    .cases {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .cases {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- Careers ---------------------------------------------------------- */
  .careers-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .careers-body {
    margin: 1.25rem 0 0;
    max-width: 44ch;
    color: var(--color-ink-muted);
    line-height: 1.6;
  }
  .careers-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.015em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .careers-cta:hover {
    background: var(--color-cta);
    border-color: var(--color-cta);
    color: var(--color-cta-ink);
  }
  .careers-cta span {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .careers-cta:hover span {
    transform: translateX(4px);
  }
</style>
