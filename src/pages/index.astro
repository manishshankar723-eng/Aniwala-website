---
/**
 * The homepage.
 *
 * Everything that used to be typed into this file — the hero and its eight
 * sections — is now a block list on the `page` document with slug `home`, so
 * the sections can be reworded, reordered, added and removed in the Studio.
 *
 * WHY THIS FILE STILL EXISTS rather than letting `[...slug].astro` render `/`:
 * a dedicated route means the homepage cannot be deleted from the CMS, and a
 * missing document becomes a build failure with a message rather than a 404 a
 * visitor discovers. See the note in `layouts/BuiltPage.astro`.
 */
import BuiltPage from '../layouts/BuiltPage.astro';
import { HOME_SLUG } from '../config/pageSlots';
---

<BuiltPage slug={HOME_SLUG} />
