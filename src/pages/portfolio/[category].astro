---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DisciplineBar from '../../components/DisciplineBar.astro';
import PieceCard from '../../components/PieceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Footer from '../../components/Footer.astro';
import { getWorkCategories, type WorkCategory } from '../../lib/workCategories';
import { piecesIn } from '../../lib/pieces';
import { servicesBySlugs, type Service } from '../../lib/services';
import { getUiCopy } from '../../lib/studio';
import { heroArtwork } from '../../lib/artwork';
import { shareCard } from '../../lib/sanity/client';
import { fill } from '../../lib/copy';

/**
 * One page per discipline.
 *
 * These routes are not optional extras: the homepage work tiles have linked
 * straight at them since the site went up, so every category in the config
 * gets a page whether or not there is anything in it yet. A category with an
 * empty gallery says so and offers the next useful thing, rather than 404ing
 * a link the homepage is still advertising.
 */
export const getStaticPaths = (async () =>
  (await getWorkCategories()).map((category) => ({
    params: { category: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

interface Props {
  category: WorkCategory;
}

const { category } = Astro.props;
const pieces = await piecesIn(category.slug);

/* Filtered rather than mapped straight through, so a typo in the config drops
   the cross-link instead of rendering `undefined` into the page. */
const related: Service[] = await servicesBySlugs(category.services);

const ownCount = pieces.filter((p) => p.kind === 'Studio project').length;
const allOwn = pieces.length > 0 && ownCount === pieces.length;

const ui = await getUiCopy();
const art = await heroArtwork(category.image);
const words = { name: category.shortName, title: category.title };
---

<Base
  title={category.seoTitle ?? `${category.title} — ${ui.crumbPortfolio} — ${ui.siteName}`}
  description={category.seoDescription ?? category.intro}
  canonical={category.canonicalUrl ?? `/portfolio/${category.slug}/`}
  ogImage={shareCard(category.ogImage)}
  noindex={category.noindex}
  hero="page"
>
  <main id="main">
    <PageHero
      image={art}
      eyebrow={ui.portfolioEyebrow}
      title={category.title}
      lead={category.intro}
      crumbs={[
        { label: ui.crumbHome, href: '/' },
        { label: ui.crumbPortfolio, href: '/portfolio/' },
        { label: category.title },
      ]}
    />

    <section class="section" id="work">
      <DisciplineBar active={category.slug} />

      {
        pieces.length === 0 ? (
          <div class="empty" data-reveal>
            <p class="empty-title">{fill(ui.portfolioEmptyTitle, words)}</p>
            <p class="empty-body">{ui.portfolioEmptyBodyOne}</p>
            <p class="empty-body">{ui.portfolioEmptyBodyTwo}</p>
            <a href="/contact/" class="btn btn--primary">
              {fill(ui.portfolioEmptyCta, words)} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        ) : (
          <>
            {allOwn && (
              <p class="note" data-reveal>
                {ui.portfolioOwnNote}
              </p>
            )}

            <h2 class="visually-hidden">{fill(ui.portfolioWorkHeading, words)}</h2>

            <div class="grid">
              {pieces.map((piece) => (
                <PieceCard piece={piece} showCategory={false} />
              ))}
            </div>
          </>
        )
      }
    </section>

    {/* A craft and a service are not the same thing — you hire 3D art and
        animation to get a character. This is the bridge from liking a tile to
        knowing what you would actually be commissioning. */}
    {
      related.length > 0 && (
        <section class="section section--bordered" id="services">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">{ui.portfolioServicesEyebrow}</p>
            <h2 class="section-title">{ui.portfolioServicesTitle}</h2>
            <a href="/services/" class="section-link">
              {ui.portfolioServicesLink} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <div class="svc-grid">
            {related.map((s) => (
              <a href={`/services/${s.slug}/`} class="svc" data-reveal>
                <h3 class="svc-name">{s.title}</h3>
                <p class="svc-blurb">{s.tagline}</p>
                <span class="svc-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <CtaBand
      eyebrow={ui.portfolioCtaEyebrow}
      title={fill(ui.portfolioCtaTitle, words)}
      body={ui.portfolioCtaBody}
    />
  </main>

  <Footer />
</Base>

<style>
  .note {
    max-width: 62ch;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
    font-size: calc(0.95rem * var(--type-label-scale, 1));
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  /*
    A GALLERY, not a card grid — two big stills across, and a piece marked
    "wide" taking a row to itself. That alternation is what gives a wall of
    work its rhythm; three small equal tiles read as a catalogue.

    Wrapping flex rather than fixed columns, for the reason the panels
    elsewhere use it: a discipline with one published piece is the normal
    case here, not the edge case, and a lone card holding a third of the row
    with the rest of a wide screen empty beside it is the thing this page
    looked like before. A flex line holds only real pieces and grows them to
    fill it, so one piece is a full-width still and two split the row.
  */
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  /* `:global`, and it is not optional. Astro scopes every element in a
     selector to the file it is written in, so a bare `.grid > *` compiles to
     `> *[data-astro-cid-thispage]` — and a PieceCard's root carries its OWN
     component's id, not this page's. The rule matched nothing and every
     piece sat at its intrinsic width. */
  .grid > :global(*) {
    flex: 1 1 100%;
    min-width: 0;
  }
  @media (min-width: 900px) {
    .grid > :global(*) {
      flex-basis: calc(50% - 0.5rem);
    }
  }

  /* --- Related services -------------------------------------------------- */
  /*
    Wrapping flex rather than `auto-fit`. Both spread a handful of cards
    across the full width, but `auto-fit` only collapses tracks that hold
    nothing at all — once the related list is longer than one row fits, the
    leftovers on the last row become slabs of `--color-line` showing through
    the 1px gap. A flex line only ever holds real cards.
  */
  .svc-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .svc {
    flex: 1 1 100%;
    min-width: 0;
    background: var(--color-ground);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.25s ease;
  }
  @media (min-width: 700px) {
    .svc {
      flex-basis: 16rem;
    }
  }
  .svc:hover {
    background: var(--color-surface);
  }
  .svc-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(1.3rem * var(--type-heading-scale, 1));
    font-weight: calc(700 + var(--type-heading-weight, 0));
    font-stretch: 108%;
    letter-spacing: calc(-0.01em + var(--type-heading-track, 0em));
  }
  .svc-blurb {
    margin: 0;
    font-size: calc(0.93rem * var(--type-body-scale, 1));
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .svc-arrow {
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: calc(1.2rem * var(--type-heading-scale, 1));
    color: var(--color-accent);
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .svc:hover .svc-arrow {
    transform: translateX(4px);
  }

  /* --- Empty state ------------------------------------------------------ */
</style>
