---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import { getContactDetails, getPrivacyPage, getUiCopy } from '../lib/studio';
import { renderBody } from '../lib/sanity/portableText';
import { shareCard } from '../lib/sanity/client';
import { fillRendered, fillHtml } from '../lib/copy';

/**
 * Privacy policy.
 *
 * The text is no longer in this file. It is the `privacyPage` singleton in
 * Sanity, written as rich text, because a policy is prose and a solicitor
 * adding a clause should not be a deploy. What is left here is the plumbing:
 * render the body, and fill in the two facts that must not be typed into it.
 *
 * THE TWO TOKENS. `{{email}}` and `{{legalName}}` are substituted from
 * `contactDetails` after the body is rendered — see `fillRendered`. Neither
 * is stored in the policy, deliberately: the footer's copyright line and the
 * policy's first sentence name the same entity, and the studio inbox appears
 * in both the policy and every CTA band on the site. Two copies of either is
 * how they end up disagreeing, and the one that goes stale is always the one
 * inside a long document nobody re-reads.
 *
 * The postal address is not a token at all — it is rendered from
 * `contactDetails` as structured lines below the body, which is why the
 * contact heading and its lead-in are their own fields rather than the last
 * two paragraphs of the body.
 *
 * KEEP THE POLICY IN STEP WITH THE CODE. Moving it to the CMS did not change
 * what it has to be true about. If someone adds analytics, a pixel, a chat
 * widget or a new form, editing that document is part of the change — and it
 * is now an edit rather than a deploy, which removes the excuse for putting
 * it off. The claims the current text makes are listed on the Studio schema.
 *
 * NOT LEGAL ADVICE. It is an honest description of the site's behaviour
 * written by the people who built it.
 */
const policy = await getPrivacyPage();
const ui = await getUiCopy();
const { email, legalName, addressLines, country } = await getContactDetails();

/* Formatted here rather than stored, so the line cannot drift from the date
   the document actually carries by being typed twice. */
const formatted = new Date(`${policy.lastUpdated}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const links = { email: { href: `mailto:${email}`, label: email } };

const { html } = renderBody(policy.body as never[]);
const body = fillRendered(html, { legalName }, links);
const contactLead = fillHtml(policy.contactLead, { legalName }, links);
---

<Base
  title={policy.seoTitle ?? `${policy.title} — ${ui.siteName}`}
  description={policy.seoDescription ?? policy.lead}
  canonical={policy.canonicalUrl ?? '/privacy/'}
  ogImage={shareCard(policy.ogImage)}
  noindex={policy.noindex}
>
  <main id="main">
    <PageHero
      eyebrow={policy.eyebrow}
      title={policy.title}
      lead={policy.lead}
      crumbs={[{ label: ui.crumbHome, href: '/' }, { label: policy.title }]}
      tint={policy.tint}
      meta={[`${policy.lastUpdatedLabel} ${formatted}`]}
      compact
    />

    <section class="section">
      <div class="prose" data-reveal>
        {/* .prose styles bare semantic tags, which is exactly what the
            Portable Text renderer emits — see lib/sanity/portableText.ts. */}
        <Fragment set:html={body} />

        <h2>{policy.contactHeading}</h2>
        <p set:html={contactLead} />
        <p>
          <address class="addr">
            {addressLines.map((line) => <span>{line}</span>)}
            <span>{country}</span>
          </address>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .addr {
    display: grid;
    gap: 0.15rem;
    font-style: normal;
    color: var(--color-ink-muted);
  }
</style>
