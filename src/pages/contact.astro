---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BookCall from '../components/BookCall.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Footer from '../components/Footer.astro';
import { email, office, publishedSocials } from '../config/contact';
import { enquiryTypes } from '../config/site';

/**
 * Contact.
 *
 * The most linked-to page on the site — the header CTA, every CTA band and
 * the footer all point here — and until now it did not exist, so every one
 * of those was a 404.
 *
 * Two routes, deliberately in this order: write to a human, or book a slot.
 * The booking widget is the more impressive of the two and most studios lead
 * with it, but a producer who just wants to fire off a brief at 1am should
 * not have to negotiate a calendar first. The address comes before the
 * scheduler for the same reason.
 */
const socials = publishedSocials();
---

<Base
  title="Contact — Aniwala Studios"
  description="Talk to Aniwala Studios about an animation, game art or VFX brief. Email contact@aniwala.com, book a call, or visit the studio in Wakad, Pimpri-Chinchwad."
>
  <main id="main">
    <PageHero
      eyebrow="Contact"
      title="Tell us the deadline first."
      lead="We'll tell you straight whether we can hit it, and what it would take if we can. No deck, no discovery phase. Just an answer within two working days."
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
      tint="28 75% 26%"
    />

    <!-- The direct routes. A page that opens with a form asks the visitor to
         do the work; this opens with the address and lets them choose. -->
    <section class="section" id="reach">
      <div class="reach">
        <div class="reach-card reach-card--mail" data-reveal>
          <p class="reach-label">Email</p>
          <a href={`mailto:${email}`} class="reach-mail">{email}</a>
          <p class="reach-note">
            The fastest route. Send the cut, the asset list, the script, or just
            the problem. Whatever you have is enough to get a useful answer back,
            and every enquiry is read by someone who could do the work.
          </p>

          <ul class="reach-hint">
            <li>Attach or link anything: boards, refs, a rough edit, a spec.</li>
            <li>Say the date you need it by, even if it's uncomfortable.</li>
            <li>You get a scope and a straight yes or no within two working days.</li>
          </ul>
        </div>

        <div class="reach-side">
          <div class="reach-card" data-reveal>
            <p class="reach-label">Studio</p>
            <address class="reach-address">
              {office.lines.map((line) => <span>{line}</span>)}
              <span>{office.country}</span>
            </address>
            <a href={office.mapsUrl} class="reach-link" rel="noopener">
              Open in Maps <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          {
            socials.length > 0 && (
              <div class="reach-card" data-reveal>
                <p class="reach-label">Elsewhere</p>
                <ul class="reach-social">
                  {socials.map((s) =>
                    s.href ? (
                      <li>
                        <a href={s.href} rel="noopener">
                          <SocialIcon icon={s.icon} class="reach-social-icon" />
                          {s.label}
                        </a>
                      </li>
                    ) : (
                      /* Dev only — no account yet. See config/contact.ts. */
                      <li>
                        <span class="reach-social-todo" title="No URL set in config/contact.ts">
                          <SocialIcon icon={s.icon} class="reach-social-icon" />
                          {s.label}
                        </span>
                      </li>
                    )
                  )}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- What we are good at being asked about. Not a services list — those
         have their own pages — but the shape of brief that gets the most
         useful reply. -->
    {
      enquiryTypes.length > 0 && (
        <section class="section section--bordered" id="about-what">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">What to write about</p>
            <h2 class="section-title">Briefs we can scope quickly</h2>
            <a href="/services/" class="section-link">
              See the services <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul class="kinds" data-reveal>
            {enquiryTypes.map((t) => (
              <li class="kind">{t}</li>
            ))}
          </ul>
        </section>
      )
    }

    {/* The booking widget, already a full section with its own heading and
        its own Supabase submission path. */}
    <BookCall />
  </main>

  <Footer />
</Base>

<style>
  /* --- Reach ------------------------------------------------------------ */
  .reach {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .reach {
      grid-template-columns: 1.35fr 1fr;
    }
  }

  .reach-side {
    display: grid;
    gap: 1.25rem;
  }

  .reach-card {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
  }

  .reach-label {
    margin: 0 0 1rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    color: var(--color-accent);
  }

  .reach-mail {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.03em;
    /* Sized to fill its card without ever outgrowing it — the address is
       long, and at a fixed size it wraps mid-word on a phone. */
    font-size: clamp(1.35rem, 4vw, 2.6rem);
    line-height: 1.1;
    color: var(--color-ink);
    text-decoration: none;
    word-break: break-word;
    transition: color 0.2s ease;
  }
  .reach-mail:hover {
    color: var(--color-accent);
  }

  .reach-note {
    margin: 1.5rem 0 0;
    max-width: 54ch;
    font-size: 0.97rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .reach-hint {
    margin: 1.5rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .reach-hint li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .reach-hint li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 100px;
    background: var(--color-accent);
  }

  /* --- Address ---------------------------------------------------------- */
  .reach-address {
    display: grid;
    gap: 0.15rem;
    font-style: normal;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .reach-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-accent);
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid currentColor;
  }
  .reach-link span {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .reach-link:hover span {
    transform: translateX(4px);
  }

  /* --- Social ----------------------------------------------------------- */
  .reach-social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .reach-social a,
  .reach-social-todo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.93rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .reach-social a:hover {
    color: var(--color-accent);
  }
  /* Dev only: an account with no URL yet. */
  .reach-social-todo {
    color: var(--color-ink-faint);
    opacity: 0.45;
    cursor: help;
  }

  /* --- Enquiry kinds ---------------------------------------------------- */
  .kinds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .kind {
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
  }
</style>
