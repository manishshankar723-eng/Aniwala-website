---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryBar from '../../../components/CategoryBar.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Footer from '../../../components/Footer.astro';
import { getPosts, getPostCategories, type Post } from '../../../lib/posts';
import { getUiCopy } from '../../../lib/studio';
import { heroArtwork } from '../../../lib/artwork';
import { fill, plural } from '../../../lib/copy';

/**
 * One page per category that actually has posts in it. Empty categories get no
 * route at all — CategoryBar renders those as dimmed text rather than links,
 * so nothing here can 404.
 */
export async function getStaticPaths() {
  const posts = await getPosts();
  const categories = await getPostCategories();

  /* The slug comes off the category document rather than being derived from
     its title. It is the URL, and lower-casing a two-word title used to
     produce one with a space in it. */
  return categories
    .filter((c) => posts.some((p) => p.data.category === c.title))
    .map((c) => ({
      params: { category: c.slug },
      props: {
        category: c.title,
        blurb: c.blurb,
        posts: posts.filter((p) => p.data.category === c.title),
        counts: Object.fromEntries(
          categories.map((x) => [x.title, posts.filter((p) => p.data.category === x.title).length])
        ),
      },
    }));
}

interface Props {
  category: string;
  /* Carried from the category document rather than looked up again here —
     `getStaticPaths` already had it in hand. */
  blurb: string;
  posts: Post[];
  counts: Record<string, number>;
}
const { category, blurb, posts, counts } = Astro.props;

const ui = await getUiCopy();
const art = await heroArtwork();
const count = plural(posts.length, ui.postCountOne, ui.postCountMany);
---

<Base
  title={`${category} — ${ui.crumbBlog} — ${ui.siteName}`}
  description={blurb}
  canonical={`/blog/category/${Astro.params.category}/`}
  hero="page"
>
  <main id="main">
    <PageHero
      image={art}
      eyebrow={ui.blogEyebrow}
      title={category}
      lead={blurb}
      meta={[count]}
      crumbs={[
        { label: ui.crumbHome, href: '/' },
        { label: ui.crumbBlog, href: '/blog/' },
        { label: category },
      ]}
    />

    <section class="section">
      <CategoryBar active={category} counts={counts} />

      <h2 class="visually-hidden">{fill(ui.categoryHeading, { name: category })}</h2>

      <div class="blog-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <CtaBand />
  </main>

  <Footer />
</Base>

