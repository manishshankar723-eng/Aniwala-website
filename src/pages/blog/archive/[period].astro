---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryBar from '../../../components/CategoryBar.astro';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Footer from '../../../components/Footer.astro';
import { getArchive, getPostsByPeriod, getPosts, type Post, getPostCategories } from '../../../lib/posts';
import { getUiCopy } from '../../../lib/studio';
import { heroArtwork } from '../../../lib/artwork';
import { fill, plural } from '../../../lib/copy';

/**
 * One page per month that actually has posts in it — the archive list is
 * built from the post dates, so an empty month has no route and the sidebar
 * never links to one.
 */
export async function getStaticPaths() {
  const archive = await getArchive();

  const all = await getPosts();
  const counts = Object.fromEntries(
    (await getPostCategories()).map((c) => [
      c.title,
      all.filter((p) => p.data.category === c.title).length,
    ])
  );

  return Promise.all(
    archive.map(async (a) => ({
      params: { period: a.period },
      props: {
        label: a.label,
        posts: await getPostsByPeriod(a.period),
        period: a.period,
        counts,
      },
    }))
  );
}

interface Props {
  label: string;
  period: string;
  posts: Post[];
  counts: Record<string, number>;
}
const { label, period, posts, counts } = Astro.props;

const ui = await getUiCopy();
const art = await heroArtwork();
const count = plural(posts.length, ui.postCountOne, ui.postCountMany);
---

{/*
  Hidden from search, but crawled through.

  Sixteen tag pages and six monthly archives is 22 URLs for 7 posts, each
  carrying 111-174 words of its own and most of them listing a single
  article. That is not a page anybody should land on from Google, and a
  crawler spending its budget on 22 of them instead of the posts is the
  mechanism behind "Crawled - currently not indexed".

  `follow`, though, not `nofollow`: these bars are a real route from the blog
  index to the articles, and cutting the links would de-index the listing and
  strand the posts. See `follow` in layouts/Base.astro.

  The four CATEGORY pages deliberately do NOT get this. They have written
  intros, they group several posts each, and they are linked from every page
  on the blog - they are section pages, not machine-generated permutations.

  This also takes them out of the sitemap for free: the filter in
  astro.config.mjs reads `noindex` off the built HTML rather than a list.
*/}
<Base
  title={`${label} — ${ui.crumbBlog} — ${ui.siteName}`}
  description={fill(ui.archiveDescription, { name: label })}
  canonical={`/blog/archive/${period}/`}
  hero="page"
  noindex
  follow
>
  <main id="main">
    <PageHero
      image={art}
      eyebrow={ui.archiveEyebrow}
      title={label}
      lead={fill(ui.archiveLead, { name: label })}
      meta={[count]}
      crumbs={[
        { label: ui.crumbHome, href: '/' },
        { label: ui.crumbBlog, href: '/blog/' },
        { label },
      ]}
    />

    {/* The rail, same as a post page. A filtered view is exactly where a
        reader wants the other filters within reach — and a narrow filter
        used to leave most of a wide screen empty beside its results. */}
    <div class="section blog-shell">
      <div class="blog-main">
        <CategoryBar counts={counts} extraActive={label} />

        <h2 class="visually-hidden">{fill(ui.archiveHeading, { name: label })}</h2>
        <div class="blog-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>

      <BlogSidebar activePeriod={period} />
    </div>

    <CtaBand />
  </main>

  <Footer />
</Base>
