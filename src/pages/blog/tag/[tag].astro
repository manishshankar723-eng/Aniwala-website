---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryBar from '../../../components/CategoryBar.astro';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Footer from '../../../components/Footer.astro';
import { getTags, getPostsByTag, getPosts, type Post, getPostCategories } from '../../../lib/posts';
import { getUiCopy } from '../../../lib/studio';
import { heroArtwork } from '../../../lib/artwork';
import { fill, plural } from '../../../lib/copy';

/**
 * One page per tag in use. Tags come from the posts themselves, so there is
 * no list to maintain and no route for a tag nothing carries.
 */
export async function getStaticPaths() {
  const tags = await getTags();

  const all = await getPosts();
  const counts = Object.fromEntries(
    (await getPostCategories()).map((c) => [
      c.title,
      all.filter((p) => p.data.category === c.title).length,
    ])
  );

  return Promise.all(
    tags.map(async (t) => ({
      params: { tag: t.slug },
      props: { tag: t.tag, slug: t.slug, posts: await getPostsByTag(t.slug), counts },
    }))
  );
}

interface Props {
  tag: string;
  slug: string;
  posts: Post[];
  counts: Record<string, number>;
}
const { tag, slug, posts, counts } = Astro.props;

const ui = await getUiCopy();
const art = await heroArtwork();
const count = plural(posts.length, ui.postCountOne, ui.postCountMany);
---

{/*
  Hidden from search, but crawled through.

  Sixteen tag pages and six monthly archives is 22 URLs for 7 posts, each
  carrying 111-174 words of its own and most of them listing a single
  article. That is not a page anybody should land on from Google, and a
  crawler spending its budget on 22 of them instead of the posts is the
  mechanism behind "Crawled - currently not indexed".

  `follow`, though, not `nofollow`: these bars are a real route from the blog
  index to the articles, and cutting the links would de-index the listing and
  strand the posts. See `follow` in layouts/Base.astro.

  The four CATEGORY pages deliberately do NOT get this. They have written
  intros, they group several posts each, and they are linked from every page
  on the blog - they are section pages, not machine-generated permutations.

  This also takes them out of the sitemap for free: the filter in
  astro.config.mjs reads `noindex` off the built HTML rather than a list.
*/}
<Base
  title={`${tag} — ${ui.crumbBlog} — ${ui.siteName}`}
  description={fill(ui.tagDescription, { name: tag })}
  canonical={`/blog/tag/${slug}/`}
  hero="page"
  noindex
  follow
>
  <main id="main">
    <PageHero
      image={art}
      eyebrow={ui.tagEyebrow}
      title={`#${tag}`}
      lead={fill(ui.tagLead, { name: tag })}
      meta={[count]}
      crumbs={[
        { label: ui.crumbHome, href: '/' },
        { label: ui.crumbBlog, href: '/blog/' },
        { label: `#${tag}` },
      ]}
    />

    {/* The rail, same as a post page. A filtered view is exactly where a
        reader wants the other filters within reach — and a tag matching one
        post used to leave three quarters of a wide screen empty beside it. */}
    <div class="section blog-shell">
      <div class="blog-main">
        <CategoryBar counts={counts} extraActive={`#${tag}`} />

        <h2 class="visually-hidden">{fill(ui.tagHeading, { name: tag })}</h2>
        <div class="blog-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>

      <BlogSidebar activeTag={slug} />
    </div>

    <CtaBand />
  </main>

  <Footer />
</Base>
