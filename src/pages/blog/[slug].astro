---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import Comments from '../../components/Comments.astro';
import CtaBand from '../../components/CtaBand.astro';
import Footer from '../../components/Footer.astro';
import { imageUrl, imageSrcSet, shareCard } from '../../lib/sanity/client';
import { getUiCopy } from '../../lib/studio';
import {
  getPosts,
  getRelatedPosts,
  formatDate,
  isoDate,
  readingTime,
  categorySlug,
  tagSlug,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, author, tint, cover, seoTitle, seoDescription, noindex } =
  post.data;

/*
 * The card a pasted link shows.
 *
 * The cover is the right one nine times out of ten, so the sharing image only
 * has to be set when it is the tenth — a still that crops badly to 1200x630,
 * say. The alt text follows the same fork: only the cover has alt text an
 * editor wrote, so a purpose-made sharing image passes none and Base falls
 * back to the studio name.
 */
const seoImage = post.data.ogImage;

const ui = await getUiCopy();

const { Content, headings } = await render(post);
const related = await getRelatedPosts(post);

/* Only h2s. Including h3s makes the contents list longer than the rail it
   sits in, which defeats the point of it being sticky. */
const toc = headings.filter((h) => h.depth === 2);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDate(pubDate),
  dateModified: isoDate(updatedDate ?? pubDate),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: ui.siteName,
    url: 'https://aniwala.com/',
  },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site).href,
  keywords: tags.join(', '),
};
---

<Base
  title={seoTitle ?? `${title} — ${ui.siteName}`}
  description={seoDescription ?? description}
  canonical={post.data.canonicalUrl ?? `/blog/${post.id}/`}
  ogType="article"
  publishedTime={isoDate(pubDate)}
  modifiedTime={isoDate(updatedDate ?? pubDate)}
  ogImage={shareCard(seoImage, cover)}
  ogImageAlt={seoImage ? undefined : cover?.alt}
  noindex={noindex}
>
  <main id="main">
    <PageHero
      eyebrow={category}
      title={title}
      lead={description}
      tint={tint}
      meta={[formatDate(pubDate), readingTime(post.body), author]}
      crumbs={[
        { label: ui.crumbHome, href: '/' },
        { label: ui.crumbBlog, href: '/blog/' },
        { label: category, href: `/blog/category/${categorySlug(category)}/` },
        { label: title },
      ]}
    />

    {
      /* The cover, at full width between the hero and the article.

         Unlike the copy on the blog card, this one carries its real alt text
         and is NOT aria-hidden: here the image is part of the article rather
         than decoration beside a link that already says what the piece is.

         `fetchpriority="high"` and no lazy loading because this is almost
         always the largest element in the viewport on load — lazy-loading it
         would delay the very thing the page is measured on. */
      cover && (
        <figure class="post-cover">
          <img
            src={imageUrl(cover, 1600)}
            srcset={imageSrcSet(cover, [768, 1200, 1600, 2000])}
            sizes="(min-width: 1200px) 1100px, 100vw"
            alt={cover.alt}
            fetchpriority="high"
            decoding="async"
            width="1600"
            height="900"
          />
        </figure>
      )
    }

    <div class="section blog-shell">
      <article class="blog-main">
        {/* .prose lives in global.css — Astro's scoped styles do not reach
            markup produced by <Content />. */}
        <div class="prose" data-reveal>
          <Content />
        </div>

        <footer class="article-foot">
          {
            tags.length > 0 && (
              <ul class="tags" aria-label={ui.tagsLabel}>
                {tags.map((t) => (
                  <li>
                    <a href={`/blog/tag/${tagSlug(t)}/`}>#{t}</a>
                  </li>
                ))}
              </ul>
            )
          }

          {
            updatedDate && (
              <p class="updated">
                {ui.postUpdatedPrefix}{' '}
                <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
              </p>
            )
          }

          <a href="/blog/" class="back">
            <span aria-hidden="true">&larr;</span> {ui.postBackLabel}
          </a>
        </footer>

        <Comments slug={post.id} />
      </article>

      <BlogSidebar toc={toc} excludeId={post.id} activeCategory={category} />
    </div>

    {
      related.length > 0 && (
        <section class="section section--bordered blog-section">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">{ui.postRelatedEyebrow}</p>
            <h2 class="section-title">{ui.postRelatedTitle}</h2>
            <a href="/blog/" class="section-link">
              {ui.postRelatedLink} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <div class="related">
            {related.map((r) => (
              <PostCard post={r} terse />
            ))}
          </div>
        </section>
      )
    }

    <CtaBand />

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
  </main>

  <Footer />
</Base>

<style>
  /* Full-bleed within the content column, not the viewport — a cover that
     runs edge to edge on a wide monitor dwarfs the article it belongs to. */
  .post-cover {
    max-width: 1100px;
    margin: 0 auto 1rem;
    padding: 0 1.5rem;
  }
  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .article-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
    max-width: 68ch;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .tags a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.72rem;
    color: var(--color-ink-faint);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .tags a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .updated {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-ink-faint);
  }
  .back {
    margin-left: auto;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .related {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .related {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  /**
   * Highlights the contents entry for whichever section is on screen.
   *
   * Purely decorative — the links are ordinary anchors and work without this,
   * which is why it bails silently when the rail has no contents list.
   */
  function initToc() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (links.length === 0) return;

    const targets = links
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => Boolean(el));
    if (targets.length === 0) return;

    const setCurrent = (id: string) => {
      links.forEach((l) => l.classList.toggle('is-current', l.dataset.tocLink === id));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // The topmost heading inside the band wins. Reading the last entry
        // instead would flip the highlight when scrolling up.
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setCurrent(visible[0].target.id);
      },
      // A band across the upper third: a heading counts as "current" from the
      // moment it reaches the header until the next one displaces it.
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
    );

    targets.forEach((t) => observer.observe(t));
    setCurrent(targets[0].id);

    // Astro swaps the document on navigation; a stale observer would keep
    // pointing at detached nodes.
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', initToc);
</script>
