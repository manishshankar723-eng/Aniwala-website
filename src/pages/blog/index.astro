---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryBar from '../../components/CategoryBar.astro';
import CtaBand from '../../components/CtaBand.astro';
import Footer from '../../components/Footer.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIES } from '../../config/categories';

const posts = await getPosts();

/** Newest post gets the wide treatment; the rest fill the grid below it. */
const [featured, ...rest] = posts;

const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c, posts.filter((p) => p.data.category === c).length])
);
---

<Base
  title="Blog — Aniwala Studios"
  description="Notes on animation, VFX and game art production: how the work is scheduled, quoted and reviewed, from the people doing it."
>
  <main id="main">
    <PageHero
      eyebrow="Blog"
      title="Notes from inside the pipeline."
      lead="Craft and production writing about how animation actually gets made — what we approve when, what things cost, and the decisions that are cheap now and expensive later. No thought leadership."
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
      tint="195 60% 24%"
      compact
    />

    <section class="section">
      <CategoryBar counts={counts} />

      {
        posts.length === 0 ? (
          /* Honest empty state. Better than a grid of placeholder cards. */
          <div class="empty" data-reveal>
            <p class="empty-title">Nothing published yet.</p>
            <p class="empty-body">
              The first posts are being written. In the meantime, the fastest way to
              hear how we work is to ask.
            </p>
            <a href="/contact/" class="empty-cta">
              Talk to the studio <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        ) : (
          <>
            <h2 class="visually-hidden">All posts</h2>

            <div class="featured">
              <PostCard post={featured} featured />
            </div>

            {rest.length > 0 && (
              <div class="blog-grid">
                {rest.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            )}
          </>
        )
      }
    </section>

    <CtaBand
      eyebrow="Start a project"
      title="Reading is cheaper than a bad brief."
      body="If something here matched a problem you are having, that conversation is free. Send the brief and the deadline and we will tell you what we would actually do."
    />
  </main>

  <Footer />
</Base>

<style>
  .featured {
    margin-bottom: 1.25rem;
  }

  /* --- Empty state ------------------------------------------------------ */
  .empty {
    padding: clamp(3rem, 8vw, 6rem) 1.5rem;
    text-align: center;
    border: 1px dashed var(--color-line-strong);
    border-radius: 0.75rem;
  }
  .empty-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.022em;
  }
  .empty-body {
    margin: 1rem auto 0;
    max-width: 42ch;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }
  .empty-cta {
    display: inline-block;
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid currentColor;
  }
</style>
