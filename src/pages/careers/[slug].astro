---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ApplyForm from '../../components/ApplyForm.astro';
import Footer from '../../components/Footer.astro';
import { employmentTypeSchema } from '../../config/careers';
import { getFlatRoles, type Role } from '../../lib/roles';
import { getContactDetails, getCareersContent } from '../../lib/studio';

/**
 * One page per opening, built from `config/careers.ts`.
 *
 * The whole page is arranged around a single question the applicant is
 * actually asking — "is this me?" — so the requirements are not buried under
 * three paragraphs of studio history, and the apply form is at the bottom of
 * the same page rather than behind another click. Nobody should have to
 * navigate to apply for a job they have just finished reading about.
 *
 * A closed role's object is deleted from the config, which means its page
 * stops being built. That is deliberate: a live page for a filled seat is
 * worse than a 404, because a 404 is at least honest about it.
 */
export async function getStaticPaths() {
  /* Async now that roles come from the CMS rather than a config array. An
     unpublished role builds no page, which is how a filled seat disappears:
     the listing goes, and so does its URL. */
  const roles = await getFlatRoles();
  return roles.map((role) => ({
    params: { slug: role.slug },
    props: { role, others: roles.filter((r) => r.slug !== role.slug) },
  }));
}

interface Props {
  role: Role;
  others: Role[];
}

const { role, others } = Astro.props;

const { careersEmail, addressLines } = await getContactDetails();

/* The same steps the careers index shows. Read from the CMS rather than a
   second copy in config, so the two pages cannot describe different hiring
   processes to the same applicant. */
const { hiringSteps } = await getCareersContent();

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

/* The facts an applicant scans for before reading a word of prose. Kept as
   data so the rail and the structured data cannot disagree. */
const facts: Array<[string, string]> = [
  ['Discipline', role.discipline],
  ['Type', role.kind],
  ['Location', role.location],
  ['Experience', role.experience],
  ['Openings', role.openings === 1 ? '1 seat' : `${role.openings} seats`],
  ['Posted', fmtDate(role.posted)],
  ...(role.closes ? ([['Applications close', fmtDate(role.closes)]] as Array<[string, string]>) : []),
];

const jobSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: role.title,
  description: `${role.summary} ${role.about}`,
  datePosted: role.posted,
  ...(role.closes ? { validThrough: role.closes } : {}),
  employmentType: employmentTypeSchema[role.kind],
  industry: 'Animation, Game Art and VFX',
  skills: role.software.join(', '),
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Aniwala Studios',
    sameAs: 'https://aniwala.com',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: addressLines.slice(0, 2).join(', '),
      addressLocality: 'Pimpri-Chinchwad',
      addressRegion: 'Maharashtra',
      postalCode: '411057',
      addressCountry: 'IN',
    },
  },
  totalJobOpenings: role.openings,
  url: `https://aniwala.com/careers/${role.slug}/`,
};
---

<Base
  title={role.seoTitle ?? `${role.title} — Careers at Aniwala Studios`}
  description={
    role.seoDescription ??
    `${role.summary} ${role.kind}, ${role.location}. ${role.experience}. Apply to Aniwala Studios and get an answer within five working days.`
  }
>
  <main id="main">
    <PageHero
      eyebrow={role.discipline}
      title={role.title}
      lead={role.summary}
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Careers', href: '/careers/' },
        { label: role.title },
      ]}
      tint={role.tint}
      meta={[
        role.kind,
        role.location,
        role.experience,
        role.openings === 1 ? '1 opening' : `${role.openings} openings`,
      ]}
    >
      <div class="hero-acts" data-reveal data-reveal-delay="0.22">
        <a href="#apply" class="hero-act hero-act--primary">Apply for this role</a>
        <a href={`mailto:${careersEmail}?subject=${encodeURIComponent(`Question about ${role.title}`)}`} class="hero-act">
          Ask a question first
        </a>
      </div>
    </PageHero>

    <section class="section" id="detail">
      <div class="shell">
        <!-- ── The role itself ───────────────────────────────────────── -->
        <div class="body">
          <div class="block" data-reveal>
            <h2 class="block-title">The work</h2>
            <p class="block-lead">{role.about}</p>
          </div>

          <div class="block" data-reveal>
            <h2 class="block-title">What you would be doing</h2>
            <ul class="ticks">
              {role.responsibilities.map((r) => <li>{r}</li>)}
            </ul>
          </div>

          <div class="block" data-reveal>
            <h2 class="block-title">What we need from you</h2>
            <ul class="ticks">
              {role.requirements.map((r) => <li>{r}</li>)}
            </ul>
            {/* Said out loud, because the people who most often talk
                themselves out of applying are the ones worth reading. */}
            <p class="block-aside">
              Missing one of these and strong on the rest? Apply anyway and say which
              one. We have hired on that basis before, and the reel decides it — not
              the checklist.
            </p>
          </div>

          {
            role.niceToHave && role.niceToHave.length > 0 && (
              <div class="block" data-reveal>
                <h2 class="block-title">Nice to have</h2>
                <p class="block-note">Genuinely optional. None of these decide it.</p>
                <ul class="pluses">
                  {role.niceToHave.map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="block" data-reveal>
            <h2 class="block-title">Software you would be in</h2>
            <ul class="tools">
              {role.software.map((s) => <li class="tool">{s}</li>)}
            </ul>
          </div>

          {/* The most useful thing on the page, so it is given a panel rather
              than a bullet. Most creative job ads never say it at all. */}
          <div class="reel" data-reveal>
            <p class="reel-eyebrow">What to send</p>
            <p class="reel-body">{role.reelNote}</p>
            <p class="reel-foot">
              A link is all we need — ArtStation, Vimeo, a personal site, a Drive
              folder or a PDF. Please check the sharing permission before you send it.
            </p>
          </div>
        </div>

        <!-- ── Sticky facts rail ─────────────────────────────────────── -->
        <aside class="rail" data-reveal>
          <div class="rail-card">
            <p class="rail-title">At a glance</p>
            <dl class="facts">
              {
                facts.map(([k, v]) => (
                  <div class="fact">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
            <a href="#apply" class="rail-act">Apply for this role</a>
            <p class="rail-note">
              Answer within five working days, either way. Tests are paid and never
              shipped.
            </p>
          </div>

          <div class="rail-card rail-card--quiet">
            <p class="rail-title">The process</p>
            <ol class="mini">
              {
                hiringSteps.map((s) => (
                  <li>
                    <span class="mini-t">{s.title}</span>
                    <span class="mini-w">{s.when}</span>
                  </li>
                ))
              }
            </ol>
            <a href="/careers/#process" class="rail-link">
              In full <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <ApplyForm role={role} />

    {
      others.length > 0 && (
        <section class="section section--bordered" id="other">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">Also open</p>
            <h2 class="section-title">Not quite you?</h2>
            <a href="/careers/#apply" class="section-link">
              Send an open application <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <ul class="others">
            {others.map((o) => (
              <li class="other" style={`--tint:${o.tint}`} data-reveal>
                <a href={`/careers/${o.slug}/`}>
                  <span class="other-d">{o.discipline}</span>
                  <span class="other-t">{o.title}</span>
                  <span class="other-s">{o.summary}</span>
                  <span class="other-m">
                    {o.kind} · {o.experience}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(jobSchema)} is:inline />
</Base>

<style>
  /* --- Hero extras ------------------------------------------------------ */
  .hero-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .hero-act {
    padding: 0.8rem 1.6rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }
  .hero-act:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .hero-act--primary {
    background: var(--color-cta);
    border-color: var(--color-cta);
    color: var(--color-cta-ink);
    font-weight: 700;
  }
  .hero-act--primary:hover {
    background: var(--color-cta-hover);
    border-color: var(--color-cta-hover);
  }

  /* --- Shell ------------------------------------------------------------
     Capped rather than filling the 2240px page shell: the prose runs to a
     68ch measure, and a 1fr track on a wide monitor leaves a corridor of
     dead space between the text and the rail. */
  .shell {
    display: grid;
    gap: clamp(2.5rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .shell {
      max-width: 82rem;
      margin-inline: auto;
      grid-template-columns: minmax(0, 1fr) 21rem;
    }
  }

  .body {
    min-width: 0;
    display: grid;
    gap: clamp(2.25rem, 4vw, 3rem);
  }

  .block-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.025em;
    line-height: 1.15;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    color: var(--color-ink);
  }
  .block-lead {
    margin: 0;
    max-width: 68ch;
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
  .block-note {
    margin: -0.5rem 0 1rem;
    font-size: 0.86rem;
    color: var(--color-ink-faint);
  }
  .block-aside {
    margin: 1.5rem 0 0;
    padding: 0.95rem 1.15rem;
    max-width: 68ch;
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface);
    border-radius: 0 0.45rem 0.45rem 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  /* --- Lists ------------------------------------------------------------ */
  .ticks,
  .pluses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    max-width: 68ch;
  }
  .ticks li,
  .pluses li {
    position: relative;
    padding-left: 1.85rem;
    font-size: 0.97rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.62em;
    width: 0.7rem;
    height: 0.38rem;
    border-left: 2px solid var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    transform: rotate(-45deg);
  }
  .pluses li::before {
    content: '+';
    position: absolute;
    left: 0.3rem;
    top: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-faint);
  }

  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tool {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  /* --- What to send ----------------------------------------------------- */
  .reel {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-surface));
  }
  .reel-eyebrow {
    margin: 0 0 0.85rem;
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    color: var(--color-accent);
  }
  .reel-body {
    margin: 0;
    max-width: 62ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-stretch: 104%;
    letter-spacing: -0.015em;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .reel-foot {
    margin: 1.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    max-width: 62ch;
    font-size: 0.87rem;
    line-height: 1.6;
    color: var(--color-ink-faint);
  }

  /* --- Rail -------------------------------------------------------------- */
  .rail {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .rail {
      position: sticky;
      top: calc(var(--announce-h) + var(--header-h) + 1.5rem);
    }
  }

  .rail-card {
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
  }
  .rail-card--quiet {
    background: transparent;
  }
  .rail-title {
    margin: 0 0 1.15rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    color: var(--color-accent);
  }

  .facts {
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }
  .fact {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .fact dt {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.01em;
    color: var(--color-ink-faint);
  }
  .fact dd {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-ink);
  }

  .rail-act {
    display: block;
    padding: 0.8rem 1.25rem;
    background: var(--color-cta);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--color-cta-ink);
    text-align: center;
    text-decoration: none;
    transition: background 0.18s ease;
  }
  .rail-act:hover {
    background: var(--color-cta-hover);
  }
  .rail-note {
    margin: 1rem 0 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-ink-faint);
  }

  .mini {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: grid;
    gap: 0;
    counter-reset: mini;
  }
  .mini li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--color-line);
    counter-increment: mini;
  }
  .mini li:last-child {
    border-bottom: 0;
  }
  .mini-t {
    font-size: 0.86rem;
    color: var(--color-ink-muted);
  }
  .mini-t::before {
    content: counter(mini, decimal-leading-zero) ' ';
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .mini-w {
    font-family: var(--font-label);
    font-size: 0.72rem;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }
  .rail-link {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .rail-link span {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .rail-link:hover span {
    transform: translateX(4px);
  }

  /* --- Other openings ---------------------------------------------------- */
  .others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .others {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .others {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .other a {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-top: 2px solid hsl(var(--tint) / 0.9);
    border-radius: 0.75rem;
    text-decoration: none;
    transition:
      border-color 0.22s ease,
      transform 0.22s ease;
  }
  .other a:hover {
    transform: translateY(-2px);
    border-color: var(--color-line-strong);
    border-top-color: var(--color-accent);
  }
  .other-d {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    color: var(--color-accent);
  }
  .other-t {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 106%;
    letter-spacing: -0.02em;
    font-size: 1.1rem;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .other-s {
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .other-m {
    margin-top: 0.35rem;
    font-family: var(--font-label);
    font-size: 0.74rem;
    color: var(--color-ink-faint);
  }
</style>
