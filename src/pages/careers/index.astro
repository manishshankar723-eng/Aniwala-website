---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ApplyForm from '../../components/ApplyForm.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Footer from '../../components/Footer.astro';
import { employmentTypeSchema } from '../../config/careers';
import { getFlatRoles } from '../../lib/roles';
import { getFaqs, getContactDetails, getCareersContent, getUiCopy } from '../../lib/studio';
import { fill, plural, ldJson } from '../../lib/copy';
import { shareCard } from '../../lib/sanity/client';
import { heroArtwork } from '../../lib/artwork';

/**
 * Careers.
 *
 * The page is built around one belief: the person worth hiring is usually not
 * looking at the moment your listing goes up. So the open application is not a
 * footnote at the bottom — it is one of two equal doors in the same form, and
 * the page says as much in the hero.
 *
 * Order is deliberate. Roles first, because somebody who arrived from a job
 * board wants the list and nothing else. Then how the studio actually runs,
 * because that is what decides whether a good applicant bothers. Then the
 * process with real timings, so nobody has to ask. Then the form.
 */
/* Copy and the hiring switch both come from the CMS now, so pausing hiring
   is an edit rather than a deploy. */
const copy = await getCareersContent();
const { values, hiringSteps, hiringOpen } = copy;

const ui = await getUiCopy();
const art = await heroArtwork();

const roles = hiringOpen ? await getFlatRoles() : [];

const careerFaqs = await getFaqs('careers');
const { careersEmail, addressLines } = await getContactDetails();
const totalSeats = roles.reduce((n, r) => n + r.openings, 0);

/* Filter chips. Built from the listings rather than typed out, so a chip can
   never survive the role that justified it. */
const disciplineFilters = [...new Set(roles.map((r) => r.discipline))];

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });

/* "New" is 21 days. Long enough to still be true when somebody finds the page
   a fortnight after it was posted, short enough that the badge means something. */
const isNew = (iso: string) =>
  Date.now() - new Date(`${iso}T00:00:00Z`).getTime() < 21 * 864e5;

/**
 * JobPosting structured data, one per listing.
 *
 * This is what puts an opening into Google's job results, which for a studio
 * nobody has heard of is a materially bigger source of applicants than the
 * page itself. It emits only fields we can state truthfully — no salary
 * range, because inventing one to satisfy a schema validator is exactly the
 * kind of thing the honesty rule in config/careers.ts exists to prevent.
 */
const jobSchema = roles.map((r) => ({
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: r.title,
  description: `${r.summary} ${r.about}`,
  datePosted: r.posted,
  ...(r.closes ? { validThrough: r.closes } : {}),
  employmentType: employmentTypeSchema[r.kind],
  hiringOrganization: {
    '@type': 'Organization',
    name: ui.siteName,
    sameAs: 'https://aniwala.com',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: addressLines.slice(0, 2).join(', '),
      addressLocality: 'Pimpri-Chinchwad',
      addressRegion: 'Maharashtra',
      postalCode: '411057',
      addressCountry: 'IN',
    },
  },
  totalJobOpenings: r.openings,
  url: `https://aniwala.com/careers/${r.slug}/`,
}));
---

<Base
  title={copy.seoTitle ?? `${ui.crumbCareers} — ${ui.siteName}`}
  description={copy.seoDescription ?? copy.heroLead}
  canonical={copy.canonicalUrl ?? '/careers/'}
  ogImage={shareCard(copy.ogImage)}
  noindex={copy.noindex}
  hero="page"
>
  <main id="main">
    <PageHero
      image={art}
      eyebrow={copy.heroEyebrow}
      title={copy.heroTitle}
      lead={copy.heroLead}
      crumbs={[{ label: ui.crumbHome, href: '/' }, { label: ui.crumbCareers }]}
    >
      <div class="hero-stats" data-reveal data-reveal-delay="0.22">
        <div class="hero-stat">
          <span class="hero-stat-n">{String(totalSeats).padStart(2, '0')}</span>
          <span class="hero-stat-l">
            {plural(totalSeats, ui.careersSeatOne, ui.careersSeatMany)}
          </span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-n">{copy.heroStatDays}</span>
          <span class="hero-stat-l">{copy.heroStatDaysLabel}</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-n">{copy.heroStatMonths}</span>
          <span class="hero-stat-l">{copy.heroStatMonthsLabel}</span>
        </div>
      </div>

      <div class="hero-acts" data-reveal data-reveal-delay="0.28">
        <a href="#roles" class="btn btn--primary">{copy.heroActRoles}</a>
        <a href="#apply" class="btn btn--ghost" data-open-application>{copy.heroActOpen}</a>
      </div>
    </PageHero>

    <!-- ── Open roles ─────────────────────────────────────────────────
         First, and not below a culture section, because somebody who came
         from a job board is here for the list and will leave if they have to
         scroll past a manifesto to find it. -->
    <section class="section" id="roles">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">{copy.rolesEyebrow}</p>
        <h2 class="section-title">
          {roles.length > 0 ? copy.rolesTitle : copy.rolesTitleEmpty}
        </h2>
        {
          roles.length > 0 && (
            <a href={`mailto:${careersEmail}`} class="section-link">
              {copy.rolesLinkLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          )
        }
      </div>

      {
        /* Filters only earn their place once there is more than one thing to
           filter. Below three listings the chips are noise. */
        disciplineFilters.length > 1 && roles.length > 2 && (
          <div class="chip-row filter-row" role="group" aria-label={ui.filterRoles} data-reveal>
            <button type="button" class="chip chip--filter is-active" data-filter="all">
              {ui.careersFilterAll} <span class="chip-n">{roles.length}</span>
            </button>
            {disciplineFilters.map((d) => (
              <button type="button" class="chip chip--filter" data-filter={d}>
                {d} <span class="chip-n">{roles.filter((r) => r.discipline === d).length}</span>
              </button>
            ))}
          </div>
        )
      }

      {
        roles.length > 0 ? (
          <ol class="jobs" id="jobs">
            {roles.map((r) => (
              <li class="job" style={`--tint:${r.tint}`} data-discipline={r.discipline} data-reveal>
                <span class="job-wash" aria-hidden="true" />

                <div class="job-head">
                  <div class="job-title-row">
                    <h3 class="job-title">
                      <a href={`/careers/${r.slug}/`}>{r.title}</a>
                    </h3>
                    {isNew(r.posted) && <span class="job-new">{ui.careersNewBadge}</span>}
                  </div>
                  <p class="job-summary">{r.summary}</p>
                </div>

                <ul class="job-meta">
                  <li class="chip job-tag--kind">{r.kind}</li>
                  <li class="chip">{r.location}</li>
                  <li class="chip">{r.experience}</li>
                  <li class="chip">
                    {plural(r.openings, ui.careersOpeningOne, ui.careersOpeningMany)}
                  </li>
                </ul>

                <div class="job-foot">
                  <p class="job-posted">
                    {fill(ui.careersPosted, { date: fmtDate(r.posted) })}
                    {r.closes && (
                      <span> · {fill(ui.careersCloses, { date: fmtDate(r.closes) })}</span>
                    )}
                  </p>
                  <div class="job-acts">
                    <a href={`/careers/${r.slug}/`} class="job-read">
                      {ui.careersReadRole} <span aria-hidden="true">&rarr;</span>
                    </a>
                    <a href="#apply" class="btn btn--sm btn--ghost" data-apply={r.slug}>
                      {ui.careersApply}
                    </a>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          /* The honest empty state. A careers page with no listings is not a
             dead page — it is the one moment where the open application is
             unambiguously the right thing to show, so it says so plainly
             instead of apologising. */
          <div class="empty" data-reveal>
            <p class="empty-title">
              {hiringOpen ? copy.emptyOpen : copy.emptyPaused}
            </p>
            <p class="empty-body">{copy.emptyBody}</p>
            <a href="#apply" class="btn btn--primary" data-open-application>{copy.emptyAct}</a>
          </div>
        )
      }

      {
        /* The speculative door, given the same weight as the listings rather
           than a line of small print underneath them. */
        roles.length > 0 && (
          <div class="spec" data-reveal>
            <div class="spec-copy">
              <p class="spec-eyebrow">{copy.specEyebrow}</p>
              <h3 class="spec-title">{copy.specTitle}</h3>
              <p class="spec-body">{copy.specBody}</p>
            </div>
            <a href="#apply" class="btn btn--ghost" data-open-application>
              {copy.specAct} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        )
      }
    </section>

    <!-- ── Why the seat is worth taking ──────────────────────────────── -->
    <section class="section section--bordered" id="studio">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">{copy.studioEyebrow}</p>
        <h2 class="section-title">{copy.studioTitle}</h2>
        <a href="/about/" class="section-link">
          {ui.careersStudioLink} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <p class="studio-note" data-reveal>{copy.studioNote}</p>

      <div class="values">
        {
          values.map((v) => (
            <div class="value" data-reveal>
              <h3 class="value-title">{v.title}</h3>
              <p class="value-body">{v.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── How hiring runs ───────────────────────────────────────────── -->
    <section class="section section--bordered" id="process">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">{copy.processEyebrow}</p>
        <h2 class="section-title">{copy.processTitle}</h2>
      </div>

      <ol class="hire">
        {
          hiringSteps.map((s, i) => (
            <li class="hire-step" data-reveal>
              <span class="hire-n">{String(i + 1).padStart(2, '0')}</span>
              <div class="hire-body">
                <div class="hire-head">
                  <h3 class="hire-title">{s.title}</h3>
                  <span class="chip">{s.when}</span>
                </div>
                <p class="hire-text">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <ApplyForm />

    <Faq
      items={careerFaqs}
      eyebrow={copy.faqEyebrow}
      title={copy.faqTitle}
      name="careers-faq"
    />

    <CtaBand
      eyebrow={copy.ctaEyebrow}
      title={copy.ctaTitle}
      body={copy.ctaBody}
      primary={{ label: copy.ctaPrimaryLabel, href: copy.ctaPrimaryHref }}
      secondary={{ label: copy.ctaSecondaryLabel, href: copy.ctaSecondaryHref }}
    />
  </main>

  <Footer />

  {
    jobSchema.map((j) => (
      <script type="application/ld+json" set:html={ldJson(j)} is:inline />
    ))
  }
</Base>

<script>
  /**
   * Two small jobs, both about not making somebody do work the page can do:
   *
   *  1. The discipline chips filter the list in place. No route, no reload —
   *     six listings is not enough to justify a page per filter.
   *  2. Every Apply button pre-selects its role in the form below, and the
   *     "nothing fits me" links flip the form to the open-application mode.
   *     Scrolling somebody to a form and leaving them to re-find the role they
   *     just clicked is how an application becomes a maybe-later.
   */
  function initCareers() {
    const list = document.getElementById('jobs');

    /* ---------- filters ---------- */
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip--filter');
    if (list && chips.length) {
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const want = chip.dataset.filter;
          chips.forEach((c) => c.classList.toggle('is-active', c === chip));
          list.querySelectorAll<HTMLLIElement>('.job').forEach((job) => {
            const show = want === 'all' || job.dataset.discipline === want;
            job.hidden = !show;
          });
        });
      });
    }

    /* ---------- apply buttons ---------- */
    const roleSel = () => document.getElementById('ap-role') as HTMLSelectElement | null;

    document.querySelectorAll<HTMLAnchorElement>('[data-apply]').forEach((btn) => {
      btn.addEventListener('click', () => {
        // Make sure the role half of the form is the visible one first, or the
        // select we are about to set is sitting inside a hidden block.
        (document.getElementById('ap-mode-role') as HTMLButtonElement | null)?.click();
        const sel = roleSel();
        if (sel && btn.dataset.apply) {
          sel.value = btn.dataset.apply;
          sel.dispatchEvent(new Event('change'));
        }
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-open-application]').forEach((btn) => {
      btn.addEventListener('click', () => {
        (document.getElementById('ap-mode-open') as HTMLButtonElement | null)?.click();
      });
    });
  }

  document.addEventListener('astro:page-load', initCareers);
</script>

<style>
  /* --- Hero extras ------------------------------------------------------ */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.75rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
  .hero-stat {
    display: grid;
    gap: 0.3rem;
  }
  .hero-stat-n {
    font-family: var(--font-display);
    font-weight: calc(800 + var(--type-display-weight, 0));
    font-stretch: 112%;
    letter-spacing: calc(-0.04em + var(--type-display-track, 0em));
    line-height: 1;
    font-size: calc(clamp(2rem, 4vw, 2.9rem) * var(--type-display-scale, 1));
    color: var(--color-accent);
  }
  .hero-stat-l {
    max-width: 16ch;
    font-family: var(--font-label);
    font-size: calc(0.78rem * var(--type-label-scale, 1));
    line-height: 1.4;
    color: var(--color-ink-faint);
  }

  .hero-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* --- Filters ---------------------------------------------------------- */
  .filter-row {
    margin-bottom: 2rem;
  }

  /* --- Job rows ---------------------------------------------------------
     Rows, not cards. A card grid forces every listing into the same height
     and truncates the one thing a listing is for — the description. */
  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .job {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .job[hidden] {
    display: none;
  }
  .job:hover {
    border-color: var(--color-line-strong);
    transform: translateY(-2px);
  }

  /* The tint only shows on hover, so a list of six does not read as six
     competing colour fields. */
  .job-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(ellipse 60% 140% at 100% 0%, hsl(var(--tint) / 0.5), transparent 70%);
    transition: opacity 0.35s ease;
  }
  .job:hover .job-wash {
    opacity: 1;
  }
  :global(:root[data-theme='light']) .job-wash {
    background: radial-gradient(ellipse 60% 140% at 100% 0%, hsl(var(--tint) / 0.14), transparent 70%);
  }

  .job-head {
    display: grid;
    gap: 0.6rem;
  }
  .job-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .job-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: calc(750 + var(--type-display-weight, 0));
    font-stretch: 108%;
    letter-spacing: calc(-0.025em + var(--type-display-track, 0em));
    line-height: 1.15;
    font-size: calc(clamp(1.3rem, 2.6vw, 1.85rem) * var(--type-display-scale, 1));
    color: var(--color-ink);
  }
  .job-title a {
    color: inherit;
    text-decoration: none;
  }
  /* Stretched link: the whole row is clickable, but the Apply button and the
     read link below sit above it on the z-axis and still work on their own. */
  .job-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .job:hover .job-title a {
    color: var(--color-accent);
  }

  .job-new {
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    font-family: var(--font-label);
    font-size: calc(0.68rem * var(--type-label-scale, 1));
    font-weight: calc(700 + var(--type-label-weight, 0));
    letter-spacing: calc(0.02em + var(--type-label-track, 0em));
    color: var(--color-accent);
  }

  .job-summary {
    margin: 0;
    max-width: 62ch;
    font-size: calc(0.97rem * var(--type-body-scale, 1));
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .job-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .job-tag--kind {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    color: var(--color-accent);
  }

  .job-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .job-posted {
    margin: 0;
    font-family: var(--font-label);
    font-size: calc(0.76rem * var(--type-label-scale, 1));
    color: var(--color-ink-faint);
  }
  .job-acts {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .job-read {
    font-family: var(--font-label);
    font-size: calc(0.83rem * var(--type-label-scale, 1));
    font-weight: calc(600 + var(--type-label-weight, 0));
    color: var(--color-accent);
    text-decoration: none;
  }
  .job-read span {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .job-read:hover span {
    transform: translateX(4px);
  }

  /* --- Empty state ------------------------------------------------------ */

  /* --- Speculative panel ------------------------------------------------ */
  .spec {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    margin-top: 1rem;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    border: 1px dashed var(--color-line-strong);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-accent) 4%, transparent);
  }
  .spec-copy {
    flex: 1 1 34ch;
  }
  .spec-eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-label);
    font-size: calc(0.75rem * var(--type-label-scale, 1));
    font-weight: calc(700 + var(--type-label-weight, 0));
    letter-spacing: calc(0.015em + var(--type-label-track, 0em));
    color: var(--color-accent);
  }
  .spec-title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-weight: calc(700 + var(--type-display-weight, 0));
    font-stretch: 106%;
    letter-spacing: calc(-0.025em + var(--type-display-track, 0em));
    line-height: 1.2;
    font-size: calc(clamp(1.2rem, 2.4vw, 1.6rem) * var(--type-display-scale, 1));
    color: var(--color-ink);
    text-wrap: balance;
  }
  .spec-body {
    margin: 0;
    max-width: 58ch;
    font-size: calc(0.93rem * var(--type-body-scale, 1));
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  /* --- Values ------------------------------------------------------------ */
  .studio-note {
    margin: -1rem 0 2.5rem;
    max-width: 60ch;
    font-size: calc(1rem * var(--type-label-scale, 1));
    line-height: 1.7;
    color: var(--color-ink-muted);
  }
  .values {
    display: grid;
    gap: 1px;
    grid-template-columns: 1fr;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    overflow: hidden;
  }
  @media (min-width: 700px) {
    .values {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .values {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .value {
    padding: clamp(1.5rem, 2.8vw, 2.25rem);
    background: var(--color-surface);
  }
  .value-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-weight: calc(700 + var(--type-heading-weight, 0));
    font-stretch: 106%;
    letter-spacing: calc(-0.02em + var(--type-heading-track, 0em));
    font-size: calc(1.12rem * var(--type-heading-scale, 1));
    color: var(--color-ink);
  }
  .value-body {
    margin: 0;
    font-size: calc(0.92rem * var(--type-body-scale, 1));
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  /* --- Hiring steps ------------------------------------------------------ */
  .hire {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .hire-step {
    display: grid;
    gap: 0.75rem 1.75rem;
    grid-template-columns: 1fr;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 760px) {
    .hire-step {
      grid-template-columns: 5rem minmax(0, 1fr);
    }
  }
  .hire-n {
    font-family: var(--font-display);
    font-weight: calc(800 + var(--type-display-weight, 0));
    font-stretch: 112%;
    letter-spacing: calc(-0.04em + var(--type-display-track, 0em));
    line-height: 1;
    font-size: calc(2.25rem * var(--type-display-scale, 1));
    color: var(--color-line-strong);
  }
  .hire-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1rem;
    margin-bottom: 0.6rem;
  }
