---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { openRoles } from '../config/careers';

/**
 * 404.
 *
 * Was the only page on the site written in Tailwind utilities, and three of
 * the ones it used — `text-accent`, `text-ink-muted`, `border-line` — never
 * existed, because the theme block only ever defined fonts. So the eyebrow
 * had no accent colour and the button had no border colour, on the one page
 * a visitor reaches when something has already gone wrong.
 *
 * Rewritten in the same scoped-CSS-and-design-tokens system as every other
 * page, which is also what let Tailwind come out of the project entirely.
 *
 * A dead end is a navigation problem, so this offers routes out rather than
 * just apologising. Served by Apache's ErrorDocument (see public/.htaccess),
 * which means it renders at the URL the visitor actually asked for — the
 * links have to be absolute, and they are.
 */
const routes = [
  { label: 'The work', href: '/portfolio/', blurb: 'Animation, game art and VFX' },
  { label: 'Services', href: '/services/', blurb: 'Six disciplines, one pipeline' },
  { label: 'Case studies', href: '/case-studies/', blurb: 'How three jobs actually went' },
  { label: 'Journal', href: '/blog/', blurb: 'Breakdowns and studio notes' },
  { label: 'Contact', href: '/contact/', blurb: 'Briefs, quotes and bookings' },
  ...(openRoles.length > 0
    ? [{ label: 'Careers', href: '/careers/', blurb: `${openRoles.length} roles open` }]
    : []),
];
---

<Base title="Page not found — Aniwala Studios" description="That page doesn't exist." noindex>
  <main id="main" class="nf">
    <div class="nf-wash" aria-hidden="true"></div>

    <div class="nf-inner">
      <p class="nf-code">404</p>
      <h1 class="nf-title">Nothing here.</h1>
      <p class="nf-lead">
        That page moved, or never existed. Nothing is broken on your end — here is
        everywhere else.
      </p>

      <ul class="nf-routes">
        {
          routes.map((r) => (
            <li>
              <a href={r.href}>
                <span class="nf-route-label">{r.label}</span>
                <span class="nf-route-blurb">{r.blurb}</span>
                <span class="nf-route-go" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="nf-foot">
        Followed a link from somewhere on this site? Tell us where it was and we
        will fix it — <a href="/contact/">contact the studio</a>.
      </p>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    /* Fills the window under the fixed header without pushing the footer
       off a short viewport. */
    min-height: 78vh;
    padding: calc(var(--announce-h) + var(--header-h) + clamp(3rem, 8vw, 6rem)) var(--gutter)
      clamp(3rem, 8vw, 6rem);
  }

  .nf-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 90% at 85% 0%, hsl(265 60% 28% / 0.5), transparent 70%),
      radial-gradient(
        ellipse 60% 80% at 0% 20%,
        color-mix(in srgb, var(--color-accent) 12%, transparent),
        transparent 65%
      ),
      linear-gradient(to bottom, var(--color-surface), var(--color-ground) 92%);
  }
  :global(:root[data-theme='light']) .nf-wash {
    background:
      radial-gradient(ellipse 70% 90% at 85% 0%, hsl(265 60% 28% / 0.16), transparent 70%),
      radial-gradient(
        ellipse 60% 80% at 0% 20%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 65%
      ),
      linear-gradient(to bottom, var(--color-surface-2), var(--color-ground) 92%);
  }

  .nf-inner {
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
  }

  .nf-code {
    font-family: var(--font-label);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--color-accent);
    margin: 0 0 1.25rem;
  }

  .nf-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: -0.03em;
    line-height: 1;
    font-size: clamp(2.4rem, 8vw, 5.5rem);
    color: var(--color-ink);
  }

  .nf-lead {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .nf-routes {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    grid-template-columns: 1fr;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .nf-routes {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .nf-routes {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .nf-routes a {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 1.25rem 1.4rem;
    background: var(--color-surface);
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .nf-routes a:hover {
    background: var(--color-surface-2);
  }

  .nf-route-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 106%;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
    color: var(--color-ink);
  }
  .nf-route-blurb {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  .nf-route-go {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-accent);
    transition: transform 0.25s ease;
    justify-self: start;
  }
  .nf-routes a:hover .nf-route-go {
    transform: translateX(4px);
  }

  .nf-foot {
    margin: 2rem 0 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-ink-faint);
  }
  .nf-foot a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
</style>
