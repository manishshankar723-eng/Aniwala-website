---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Aniwala" description="That page doesn't exist.">
  <main class="min-h-screen flex flex-col items-center justify-center gap-6 px-6 text-center">
    <p class="font-mono text-[0.7rem] tracking-[0.18em] uppercase text-accent">
      Error 404
    </p>
    <h1
      class="font-display font-extrabold tracking-[-0.03em] text-[clamp(2rem,7vw,4rem)]"
      style="font-stretch:115%"
    >
      Nothing here.
    </h1>
    <p class="text-ink-muted max-w-[38ch]">
      That page moved, or never existed. The work is back home.
    </p>
    <a
      href="/"
      class="font-mono text-[0.75rem] tracking-wider uppercase border border-line rounded-full px-5 py-2.5 hover:border-accent hover:text-accent transition-colors"
    >
      Back to Aniwala
    </a>
  </main>
</Base>
