---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { serviceSlot } from '../../config/imageSlots';
import { getArtwork } from '../../lib/artwork';
import { getFaqs, getUiCopy } from '../../lib/studio';
import { fill } from '../../lib/copy';
import Faq from '../../components/Faq.astro';
import ProcessFlow from '../../components/ProcessFlow.astro';
import CtaBand from '../../components/CtaBand.astro';
import Footer from '../../components/Footer.astro';
import { getServices, servicesBySlugs, type Service } from '../../lib/services';

/**
 * One page per record in `config/services.ts`. Adding a service there adds a
 * route here — there is no per-service template to keep in sync.
 */
export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;

/** Cross-links. Filtered, so a typo in `related` drops the card rather than
    rendering an undefined one. */
const related = await servicesBySlugs(service.related);

const ui = await getUiCopy();

/* Every heading on this page is written once and reads correctly for all six
   disciplines, because the service carries its own article and short name. */
const words = { article: service.article, name: service.shortName };

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.title,
  name: service.title,
  description: service.intro,
  provider: {
    '@type': 'Organization',
    name: ui.siteName,
    url: 'https://aniwala.com/',
  },
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${service.title} services`,
    itemListElement: service.offerings.map((o) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: o.title, description: o.body },
    })),
  },
};

/* Optional. An empty slot leaves the tint gradient exactly as it was. */
const heroArt = await getArtwork(serviceSlot(service.slug));

/* FAQs moved to the CMS — they are the most-edited copy on a service page. */
const faqs = await getFaqs(`service:${service.slug}`);
---

<Base
  title={service.seoTitle ?? `${service.title} — ${ui.siteName}`}
  description={service.seoDescription ?? service.tagline}
  canonical={`/services/${service.slug}/`}
>
  <main id="main">
    <PageHero
      image={heroArt}
      eyebrow={ui.serviceEyebrow}
      title={service.title}
      lead={service.intro}
      tint={service.tint}
      crumbs={[
        { label: ui.crumbHome, href: '/' },
        { label: ui.crumbServices, href: '/services/' },
        { label: service.label },
      ]}
    >
      <div class="hero-actions" data-reveal data-reveal-delay="0.22">
        <a href="/contact/" class="btn-primary">{ui.serviceHeroPrimary}</a>
        <a href="#pipeline" class="btn-ghost">{ui.serviceHeroSecondary}</a>
      </div>
    </PageHero>

    <!-- WHAT WE MAKE — the discipline split into things a client can actually
         put on a purchase order. -->
    <section class="section" id="offerings">
      <div class="section-head" data-reveal>
        <p class="section-eyebrow">{ui.serviceOfferEyebrow}</p>
        <h2 class="section-title">{fill(ui.serviceOfferTitle, words)}</h2>
      </div>

      <div class="offerings">
        {
          service.offerings.map((o) => (
            <div class="offering" data-reveal>
              <h3 class="offering-title">{o.title}</h3>
              <p class="offering-body">{o.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/*
      PIPELINE — the discipline-specific route through the studio, drawn as a
      connected flow rather than listed. Same data as before (the `pipeline`
      array in config/services.ts); the component owns the drawing.
    */}
    <ProcessFlow
      steps={service.pipeline}
      eyebrow={ui.serviceProcessEyebrow}
      title={fill(ui.serviceProcessTitle, words)}
      lead={ui.serviceProcessLead}
      tint={service.tint}
    />

    <!-- TOOLS + DELIVERABLES — the two lists a technical director asks for
         before anyone talks about money. -->
    <section class="section section--bordered" id="specs">
      <div class="specs">
        <div class="spec" data-reveal>
          <p class="section-eyebrow">{ui.serviceToolsEyebrow}</p>
          <h2 class="spec-title">{ui.serviceToolsTitle}</h2>
          <ul class="tools">
            {service.tools.map((t) => <li class="tool">{t}</li>)}
          </ul>
          <p class="spec-note">{ui.serviceToolsNote}</p>
        </div>

        <div class="spec" data-reveal data-reveal-delay="0.08">
          <p class="section-eyebrow">{ui.serviceDeliverEyebrow}</p>
          <h2 class="spec-title">{ui.serviceDeliverTitle}</h2>
          <ul class="deliverables">
            {
              service.deliverables.map((d) => (
                <li>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M3 8.5l3.2 3.2L13 5"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{d}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- RELATED — most briefs cross a discipline boundary somewhere. -->
    {
      related.length > 0 && (
        <section class="section section--bordered" id="related">
          <div class="section-head" data-reveal>
            <p class="section-eyebrow">{ui.serviceRelatedEyebrow}</p>
            <h2 class="section-title">{ui.serviceRelatedTitle}</h2>
            <a href="/services/" class="section-link">
              {ui.serviceRelatedLink} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <div class="related">
            {related.map((r) => (
              <a href={`/services/${r.slug}/`} class="rel" style={`--tint:${r.tint}`} data-reveal>
                <span class="rel-art" aria-hidden="true" />
                <span class="rel-body">
                  <span class="rel-title">{r.title}</span>
                  <span class="rel-tagline">{r.tagline}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <Faq
      items={faqs}
      name={`faq-${service.slug}`}
      title={fill(ui.serviceFaqTitle, { label: service.label })}
    />

    <CtaBand
      eyebrow={ui.serviceCtaEyebrow}
      title={fill(ui.serviceCtaTitle, words)}
      body={ui.serviceCtaBody}
    />

    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  </main>

  <Footer />
</Base>

<style>
  /* --- Hero buttons ----------------------------------------------------- */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.95rem 1.6rem;
    border-radius: 0.3rem;
    background: var(--color-cta);
    color: var(--color-cta-ink);
    font-family: var(--font-label);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .btn-primary:hover {
    background: var(--color-cta-hover);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.95rem 1.6rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.3rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* --- Offerings -------------------------------------------------------- */
  .offerings {
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    overflow: hidden;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .offerings {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .offerings {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* A fourth column past this point. Three across a 2240px shell gives each
     card ~90 characters of measure, which is well past readable. */
  @media (min-width: 1700px) {
    .offerings {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .offering {
    background: var(--color-ground);
    padding: clamp(1.6rem, 2.6vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background-color 0.25s ease;
  }
  .offering:hover {
    background: var(--color-surface);
  }
  .offering-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 700;
    font-stretch: 106%;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }
  .offering-body {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  /* --- Specs ------------------------------------------------------------ */
  .specs {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .specs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .spec-title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.022em;
  }
  .spec-note {
    margin: 1.5rem 0 0;
    max-width: 44ch;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-ink-faint);
  }

  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tool {
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    font-family: var(--font-label);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
  }

  .deliverables {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .deliverables li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .deliverables li:first-child {
    border-top: 1px solid var(--color-line);
  }
  .deliverables svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    margin-top: 0.28rem;
    color: var(--color-accent);
  }

  /* --- Related ---------------------------------------------------------- */
  .related {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .related {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .rel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 13rem;
    padding: 1.4rem;
    border-radius: 0.75rem;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
  }
  .rel-art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 90% 70% at 30% 20%, hsl(var(--tint) / 0.85), transparent 70%),
      linear-gradient(160deg, hsl(var(--tint) / 0.55), #0b0c10 75%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 62%);
  }
  .rel:hover .rel-art {
    transform: scale(1.06);
  }
  .rel-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rel-title {
    font-family: var(--font-display);
    font-weight: 740;
    font-stretch: 108%;
    letter-spacing: -0.015em;
    font-size: 1.2rem;
    color: #f4f4f2;
  }
  .rel-tagline {
    font-size: 0.85rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.72);
  }
</style>
