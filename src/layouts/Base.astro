---
import { ClientRouter } from 'astro:transitions';
import Announce from '../components/Announce.astro';
import { announce } from '../config/nav';
import Header from '../components/Header.astro';
import Search from '../components/Search.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path only, e.g. "/work/nexus-origins/" */
  canonical?: string;
  /** True on pages whose hero runs under a transparent header. */
  transparentHeader?: boolean;
}

const {
  title,
  description = 'Aniwala is an animation studio producing 2D, 3D, VFX and game art.',
  canonical = Astro.url.pathname,
  transparentHeader = false,
} = Astro.props;

const canonicalURL = new URL(canonical, Astro.site);
const ogImage = new URL('/og-default.jpg', Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Phase 02: self-host these as WOFF2 and drop the third-party request. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <ClientRouter />

    {/*
      Must be inline and in <head>: it runs before first paint, so a visitor
      who chose light does not get a flash of the dark theme. A deferred or
      bundled script would paint dark first, then correct itself.
    */}
    <script is:inline define:vars={{ announceId: announce.id }}>
      (function () {
        try {
          if (localStorage.getItem('aniwala-theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
          }
          // Collapse the announcement strip before paint if this exact
          // announcement was dismissed — otherwise the bar flashes in and
          // the whole header jumps up as the script catches up.
          if (localStorage.getItem('aniwala-announce-dismissed') === announceId) {
            document.documentElement.dataset.announce = 'off';
          }
        } catch (e) {
          /* private mode: fall through to the defaults */
        }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Announce />
    <Header overlay={transparentHeader} />
    <slot />
    <Search />

    <script>
      import { initMotion, teardownMotion } from '../lib/motion';

      // Fires on first load AND after every view transition.
      document.addEventListener('astro:page-load', initMotion);
      // Fires before Astro swaps the document out.
      document.addEventListener('astro:before-swap', teardownMotion);

      // Re-assert the theme after a swap so it cannot flash back to dark.
      document.addEventListener('astro:after-swap', () => {
        try {
          if (localStorage.getItem('aniwala-theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
          } else {
            delete document.documentElement.dataset.theme;
          }
        } catch {
          /* private mode — dark default stands */
        }
      });
    </script>
  </body>
</html>
