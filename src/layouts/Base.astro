---
import { ClientRouter } from 'astro:transitions';
import Announce from '../components/Announce.astro';
import { getAnnouncement } from '../lib/announce';
import Header from '../components/Header.astro';
import Loader from '../components/Loader.astro';
import Search from '../components/Search.astro';
import PreviewBar from '../components/PreviewBar.astro';
import { previewMode } from '../lib/sanity/client';
import { getUiCopy, getBrand, getContactDetails } from '../lib/studio';
import SiteSchema from '../components/SiteSchema.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path only, e.g. "/work/nexus-origins/" */
  canonical?: string;
  /** True on pages whose hero runs under a transparent header. */
  transparentHeader?: boolean;
  /**
   * Keep the page out of search results.
   *
   * Also suppresses the canonical tag, which is the point: the 404 is served
   * by Apache at whatever URL the visitor mistyped, so a canonical built from
   * `Astro.url.pathname` would point at /404 — a URL that does not resolve and
   * that we would then be asking Google to index.
   */
  noindex?: boolean;
  /**
   * Social-card image. Absolute URL.
   *
   * Defaults to the studio's generic card. Blog posts and case studies pass
   * their cover here, so a shared link shows the piece rather than the same
   * logo every time — which is the difference between a link that gets
   * clicked in a group chat and one that looks like an ad.
   */
  ogImage?: string;
  /** Alt text for the social card. */
  ogImageAlt?: string;
  /**
   * Open Graph type. `article` on anything with an author and a date — a blog
   * post — and `website` on everything else.
   *
   * It was hardcoded to `website` on every page including the seven posts,
   * which is the one place it is actually wrong: a link preview for an
   * article is allowed to carry a byline and a date, and a "website" is not.
   */
  ogType?: 'website' | 'article';
  /** ISO dates, emitted only on an article. */
  publishedTime?: string;
  modifiedTime?: string;
}

const ui = await getUiCopy();
const brand = await getBrand();

/**
 * The X handle, derived from the social link rather than typed again.
 *
 * `twitter:site` wants `@name`, and the studio's profile URL already
 * contains it. Deriving it means the handle cannot disagree with the link in
 * the footer.
 *
 * `profileSocials`, not `publishedSocials`: the X link is still a placeholder
 * pointing at x.com itself, and the last path segment of that is "x.com" —
 * so the naive version of this emitted `@x.com`. No profile, no tag.
 */
/**
 * Brand-colour overrides, as CSS custom properties.
 *
 * `--color-accent-on-dark` deliberately takes the DARK-theme accent in both
 * themes: it paints the video hero, the transparent header over it and the
 * portfolio tiles, all of which stay dark whatever the visitor's theme. That
 * distinction used to be ten hardcoded hexes across five components, which is
 * precisely why changing the brand colour did nothing to half the site.
 */
const brandVars: [string, string][] = [
  ['--color-accent', brand.accentDark],
  ['--color-accent-on-dark', brand.accentDark],
  ['--color-cta', brand.accentDark],
  ['--color-marquee', brand.accentDark],
  ['--color-cta-ink', brand.buttonInk],
  ['--color-marquee-ink', brand.buttonInk],
];

const brandVarsLight: [string, string][] = [
  ['--color-accent', brand.accentLight],
  /* Repeated here, not inherited. The stylesheet redefines this token inside
     its own light-theme block, which is as specific as the override above and
     comes later in the cascade — so without restating it, the video hero and
     the portfolio tiles snapped back to the old gold the moment somebody
     switched theme. */
  ['--color-accent-on-dark', brand.accentDark],
  ['--color-cta', brand.buttonFill],
  ['--color-marquee', brand.buttonFill],
];

const rule = (selector: string, pairs: [string, string][]) => {
  const set = pairs.filter(([, value]) => value).map(([name, value]) => `${name}:${value}`);
  /* The hover shade rides along with the fill it belongs to. */
  if (pairs.some(([name, value]) => name === '--color-cta' && value)) {
    set.push('--color-cta-hover:color-mix(in srgb, var(--color-cta) 82%, #fff)');
  }
  return set.length ? `${selector}{${set.join(';')}}` : '';
};

/*
 * `:root:root`, not `:root`.
 *
 * The stylesheet defines these same properties on `:root`, and Astro emits
 * its <link> tags after this inline block — so at equal specificity the
 * stylesheet wins on source order and the override does nothing at all. That
 * is precisely what happened: the colour was set, the CSS was in the page,
 * and every element stayed gold.
 *
 * Repeating the selector raises specificity from (0,1,0) to (0,2,0) without
 * changing what it matches, so this wins wherever it lands in the head. The
 * alternative — relying on being emitted after the stylesheets — depends on
 * Astro's asset ordering, which is not ours to promise.
 */
const brandCss =
  rule(':root:root', brandVars) +
  rule(':root:root[data-theme="light"]', brandVarsLight);

const { profileSocials } = await getContactDetails();
const xHandle = profileSocials
  .find((s) => s.icon === 'x')
  ?.href.replace(/\/+$/, '')
  .split('/')
  .pop();

const {
  title,
  /* The floor, not a default anybody should be relying on: nearly every page
     supplies its own, and one that does not is usually a page that forgot. */
  description = ui.defaultDescription,
  canonical = Astro.url.pathname,
  transparentHeader = false,
  noindex = false,
  ogImage: ogImageProp,
  ogImageAlt,
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

/**
 * A preview build is never indexable, whatever a page asked for.
 *
 * This is not belt-and-braces — it is the one thing that makes a public
 * preview URL safe to have. Without it a crawler finds the preview, indexes
 * unpublished drafts, and starts serving them as duplicate copies of the live
 * pages. A page's own `noindex` still applies on the live site; this only
 * ever adds to it, never removes.
 */
const hideFromSearch = noindex || previewMode;

const announce = await getAnnouncement();

const canonicalURL = new URL(canonical, Astro.site);

/* A Sanity CDN URL arrives absolute and is used as-is; the fallback has to be
   resolved against `site` because Open Graph rejects a relative path. */
const ogImage = ogImageProp ?? new URL('/og-default.jpg', Astro.site).href;
---

{/*
  `data-announce="off"` collapses `--announce-h` to zero — see global.css.

  Set here, server-side, when the strip is turned off in config. The inline
  script below only sets it when a visitor has DISMISSED the current
  announcement, so with `announce.enabled = false` nothing set it at all and
  the header sat 2.75rem down the page with empty space above it. Doing it in
  the markup also means it is right before any script runs, and right for a
  visitor with JavaScript disabled.
*/}
<html lang="en" data-announce={announce.enabled ? undefined : 'off'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

{/*
      The browser icon.

      With one uploaded in the Studio, every size comes off Sanity's image CDN
      — one square upload, resized on the fly, rather than five files
      generated by a script and committed. Without one, the committed set in
      `public/` is used, which is what the site shipped with.

      `/favicon.ico` is listed either way and is never a CDN URL. A browser
      asks for that exact path on its own, before it has parsed any HTML, so
      it has to be a real file at the root — which is precisely why the
      committed one stays even when the rest is overridden.
    */}
    {
      brand.icon ? (
        <>
          {brand.icon.svg && <link rel="icon" type="image/svg+xml" href={brand.icon.svg} />}
          <link rel="icon" type="image/png" sizes="32x32" href={brand.icon.png32} />
          <link rel="apple-touch-icon" sizes="180x180" href={brand.icon.png180} />
        </>
      ) : (
        <>
          <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
          <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        </>
      )
    }
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="manifest" href="/site.webmanifest" />
    {/*
      Paints the browser chrome to match the page on Android and on iOS
      Safari's address bar. Two values so a visitor in light mode does not get
      a black bar above a cream page.

      BOTH CARRY A `media`, and that is load-bearing rather than tidy. A
      browser uses the FIRST theme-color whose media matches — so an
      unconditional tag anywhere above these matches everything and silently
      wins, which is exactly the bug that turned the light-mode address bar
      black when this was first made editable.
    */}
    <meta name="theme-color" content={brand.themeColor} media="(prefers-color-scheme: dark)" />
    <meta
      name="theme-color"
      content={brand.themeColorLight}
      media="(prefers-color-scheme: light)"
    />

    {/*
      The brand colour, when one is set.

      A handful of custom properties redefined on :root, which every colour in
      the site already resolves through — so this reaches the buttons, the
      links, the eyebrows, the marquee and the hero without any component
      knowing the colour is configurable.

      IN THE HEAD, before the stylesheet's own :root is overridden by nothing
      else and before first paint. Later would mean the page rendering gold
      and then repainting.

      Each line is emitted only when its field is filled in, so a blank field
      leaves the stylesheet's value exactly where it was — rather than
      overriding it with an empty string, which invalidates the declaration
      and silently reverts the colour in a way that looks like a broken field.

      The hover shade is DERIVED rather than asked for. It is a mechanical
      lightening of the fill, nobody has an opinion about it, and asking would
      be a fifth colour well for something the browser can work out.
    */}
    {brandCss && <style is:inline set:html={brandCss} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    {hideFromSearch ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalURL} />}

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta property="og:site_name" content={ui.siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {/* Same reasoning as the canonical above: on the 404 this would name the
        URL the visitor mistyped, which is not a page and should not be
        advertised as one. */}
    {!hideFromSearch && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? ui.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    {xHandle && <meta name="twitter:site" content={`@${xHandle}`} />}

    {/* The studio itself, as a machine-readable record. On every page,
        because that is where a consumer looks for it. */}
    <SiteSchema />

    {/*
      Fonts are served from this origin — see the @font-face block at the top
      of styles/global.css. Preloading the two latin faces that paint above the
      fold starts them in parallel with the stylesheet instead of after it;
      without this the browser cannot discover a font until it has parsed the
      CSS that references it, which costs a full round trip on first paint.

      Only latin, and only these two: the mono face is used for small print
      well down the page, and latin-ext loads on demand via unicode-range.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/bricolage-grotesque-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/instrument-sans-latin.woff2"
      crossorigin
    />

    <ClientRouter />

    {/*
      Must be inline and in <head>: it runs before first paint, so a visitor
      who chose light does not get a flash of the dark theme. A deferred or
      bundled script would paint dark first, then correct itself.
    */}
    <script is:inline define:vars={{ announceId: announce.id }}>
      (function () {
        try {
          if (localStorage.getItem('aniwala-theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
          }
          // Collapse the announcement strip before paint if this exact
          // announcement was dismissed — otherwise the bar flashes in and
          // the whole header jumps up as the script catches up.
          if (localStorage.getItem('aniwala-announce-dismissed') === announceId) {
            document.documentElement.dataset.announce = 'off';
          }
        } catch (e) {
          /* private mode: fall through to the defaults */
        }

        // ---- First-load curtain -------------------------------------
        // Decided here, before first paint, for the same reason the theme is:
        // anything later means the page paints and is then covered, which is
        // a flash in the opposite direction.
        //
        // Shown on every FULL page load. That is not as often as it sounds:
        // ClientRouter turns every internal link into a client-side swap, so
        // moving around the site never triggers this. What is left is the
        // first arrival, a refresh, and opening a link in a new tab — all
        // moments where a page is genuinely being loaded.
        //
        // This was gated on sessionStorage at first, which was too clever:
        // refreshing is exactly when someone expects to see it again, and it
        // made the thing effectively invisible.
        //
        // No JavaScript never reaches this line at all, and the element stays
        // display:none — so the default is still to skip.
        try {
          var reduced =
            window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          if (!reduced) {
            document.documentElement.dataset.loader = 'on';
            // Read by the motion boot below, so reveals do not play behind
            // the curtain and finish before anyone can see them.
            window.__aniwalaLoaderPending = true;
          }
        } catch (e) {
          /* matchMedia missing: no curtain, which is the safe direction */
        }
      })();
    </script>
  </head>

  <body>
    {/* Renders only in a preview build, and pushes the page down rather than
        floating over it — a floating bar would cover the nav on a phone. */}
    <PreviewBar />

    {/* First in the body: fixed-position, so the whole document is parsed
        and laid out behind it rather than gated by it. */}
    <Loader />

    <a href="#main" class="skip-link">{ui.skipToContent}</a>
    <Announce />
    <Header overlay={transparentHeader} />
    <slot />
    <Search />

    <script>
      import { initMotion, teardownMotion } from '../lib/motion';

      /**
       * On a first load behind the curtain, hold the reveals until it lifts.
       * Otherwise every above-the-fold element animates in against a black
       * screen and is already settled by the time anyone can see it — the
       * loader would be actively destroying the entrance it exists to set up.
       */
      function bootMotion() {
        if ((window as any).__aniwalaLoaderPending) {
          (window as any).__aniwalaLoaderPending = false;
          window.addEventListener('aniwala:loader-done', () => initMotion(), { once: true });
          return;
        }
        initMotion();
      }

      // Fires on first load AND after every view transition.
      document.addEventListener('astro:page-load', bootMotion);
      // Fires before Astro swaps the document out.
      document.addEventListener('astro:before-swap', teardownMotion);

      // Re-assert the theme after a swap so it cannot flash back to dark.
      document.addEventListener('astro:after-swap', () => {
        try {
          if (localStorage.getItem('aniwala-theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
          } else {
            delete document.documentElement.dataset.theme;
          }
        } catch {
          /* private mode — dark default stands */
        }
      });
    </script>
  </body>
</html>
