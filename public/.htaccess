# ---------------------------------------------------------------
# Aniwala — Apache/LiteSpeed config for Hostinger shared hosting.
# Lives in public/ so Astro copies it into dist/ on every build.
# ---------------------------------------------------------------

# No directory listings. Any folder that ends up without an index.html
# otherwise serves a browsable index of its contents to anyone who guesses
# the path — which is a free map of the site for whoever is looking.
Options -Indexes

# Nothing beginning with a dot is ever meant to be fetched over HTTP.
# The deploy uploads only ./dist, so this should never have anything to
# catch — which is exactly why it belongs here. It costs nothing and it is
# the difference between one bad upload and a published .env or .git
# directory. Belt and braces, deliberately.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

RewriteEngine On

# Force HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# One canonical hostname: aniwala.com.
# Sends www.aniwala.com, aniwala.in and www.aniwala.in to the .com apex.
# Harmless if a hostname never reaches this server.
RewriteCond %{HTTP_HOST} ^www\.aniwala\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(www\.)?aniwala\.in$ [NC]
RewriteRule ^(.*)$ https://aniwala.com/$1 [R=301,L]

# --- Staging safety net ------------------------------------------
# Anything reached on a hostname OTHER than the canonical one is a staging
# or preview copy of this site, and must never reach a search index.
#
# This is a real hazard rather than a theoretical one: a staging host serving
# the same 65 pages is duplicate content, and the copy Google keeps might be
# the one nobody is maintaining. The canonical tags already point at
# aniwala.com, but a canonical is a hint — `noindex` is an instruction.
#
# Deliberately host-based rather than a separate staging .htaccess: the file
# is built from public/ and deployed identically everywhere, so a rule that
# has to be remembered per environment is a rule that gets forgotten. Add the
# real hostname here if the canonical one ever changes, or the LIVE site
# quietly de-indexes itself.
#
# The condition is skipped for the redirects above, which never reach here.
RewriteCond %{HTTP_HOST} !^aniwala\.com$ [NC]
RewriteRule ^ - [E=STAGING:1]

# --- Which assets may be cached forever --------------------------
# Everything Astro fingerprints lives under /_astro/ and carries a content
# hash in its filename, so its bytes genuinely never change. Flagged here and
# read by the Cache-Control block below.
#
# SET WITH mod_rewrite, NOT SetEnvIf. The first version of this used
# `SetEnvIf Request_URI "^/_astro/"`, which is the more obvious spelling and
# does nothing on this server — LiteSpeed served every fingerprinted bundle
# with the fallback rule instead, quietly dropping a year of caching to a day.
# It failed in the safe direction and so said nothing about it.
#
# mod_rewrite is demonstrably working here: it is doing the HTTPS redirect, the
# canonical host and the STAGING flag immediately above. Same mechanism, same
# file, one fewer module to depend on.
RewriteRule ^_astro/ - [E=FINGERPRINTED:1]

ErrorDocument 404 /404.html

# --- Caching -----------------------------------------------------
<IfModule mod_headers.c>
  # WHICH FILES MAY BE CACHED FOREVER, and it is a narrower set than it looks.
  #
  # `immutable` is a promise that the bytes at this URL will never change. That
  # is true of /_astro/, where Astro puts a content hash in every filename: a
  # changed file is a changed URL, so nothing there can go stale.
  #
  # It used to be applied by EXTENSION rather than by path, which quietly
  # extended the same promise to every image, icon and font at the site root —
  # /favicon.svg, /apple-touch-icon.png, /icon-512.png, /fonts/*.woff2 and, the
  # one that actually bit, /og-default.jpg. Those names are stable and their
  # CONTENTS change. The promise was false, and the cost of a false `immutable`
  # is that there is no way to withdraw it: replacing the social card left every
  # returning visitor, every proxy and every CDN edge holding the old one for a
  # year, and the only fix would have been to rename the file and every tag
  # that points at it.
  #
  # That is not hypothetical. The card was regenerated because it was still
  # showing a logo the studio had stopped using, and this header is what would
  # have stopped the new one arriving.
  #
  # So the forever bucket is keyed on the path Astro actually fingerprints, and
  # everything else revalidates daily: one cheap conditional request, a 304 in
  # the ordinary case, and an asset that can be replaced.
  #
  # THE SAFE RULE IS THE UNCONDITIONAL ONE, and the order below is the point.
  #
  # The daily rule is set for every asset first, and the forever rule then
  # overrides it only where FINGERPRINTED was flagged in the rewrite section
  # above. `Header set` replaces, and later directives win, so a server that
  # never sets the flag — for whatever reason, and the last attempt at this
  # found one — serves everything revalidating rather than serving a
  # fingerprinted bundle and a replaceable favicon the same false promise.
  #
  # Written this way round on purpose: the failure mode of the daily rule is a
  # conditional request and a 304, and the failure mode of a wrong `immutable`
  # is an asset nobody can replace for a year.
  #
  # REDIRECT_FINGERPRINTED is the same flag after an internal redirect, which
  # is how Apache renames environment variables that survive one. Naming both
  # costs a line and covers the case where a rewrite has run first.
  <FilesMatch "\.(js|css|woff2|svg|jpg|jpeg|png|webp|avif|mp4|webm)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
    Header set Cache-Control "public, max-age=31536000, immutable" env=FINGERPRINTED
    Header set Cache-Control "public, max-age=31536000, immutable" env=REDIRECT_FINGERPRINTED
  </FilesMatch>

  # HTML must revalidate or visitors get a stale site after a deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Security headers ------------------------------------------
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Keeps the staging copy out of search. Paired with the STAGING env var set
  # by the rewrite near the top of this file; on the canonical hostname the
  # variable is never set and this header is never sent.
  Header always set X-Robots-Tag "noindex, nofollow" env=STAGING

  # Tells browsers to reach this host over HTTPS for the next two years,
  # so the http:// redirect above is never used a second time — and a
  # first-request downgrade attack has nothing to work with.
  #
  # NOTE: `preload` is deliberately ABSENT. Adding it and submitting to
  # hstspreload.org is effectively irreversible for months and would take
  # every subdomain with it. Add it only once you are certain nothing on
  # aniwala.com will ever need plain HTTP.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # Nothing on this site is meant to be framed. Blocks clickjacking, in
  # both the modern (CSP) and legacy (XFO) spelling.
  Header always set X-Frame-Options "DENY"

  # No page here uses a camera, a microphone, a location or a payment API.
  # Saying so removes them from any embedded context too.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Content Security Policy.
  #
  # The site is static files plus one API: Supabase, which every form posts
  # to directly from the browser. That is the whole network surface, and
  # `connect-src` names it explicitly — so even if something managed to
  # inject a script, it could not exfiltrate a form to anywhere else.
  #
  # 'unsafe-inline' on script-src is load bearing and cannot currently be
  # removed: Astro emits inline <script> for the pre-paint theme switch
  # (which must be inline, or the page flashes dark before correcting) and
  # for every `define:vars` block. Hashes would change on every build and
  # nonces need a server, which shared static hosting does not give us.
  # It still blocks the thing that matters most on a static site — loading
  # an attacker-controlled script from another origin.
  #
  # style-src needs it too: components set CSS custom properties through
  # inline style attributes (--tint on the job and service rows).
  #
  # Fonts are self-hosted, so there is no font CDN in here. If you ever
  # re-add a third-party origin — an embed, a font host, an analytics
  # script — it has to be named here or the browser will silently drop it.
  #
  # cdn.sanity.io IS such an origin, and it was missing. Every image the CMS
  # serves comes from there — `imageUrl()` in lib/sanity/client.ts builds
  # those URLs — so `img-src 'self' data: blob:` would have blocked all of
  # them, silently, with nothing in the page to say why. It had not bitten
  # yet only because the last build happened to contain no CMS images. It is
  # named here rather than fixed later under pressure, because the fix under
  # pressure is `img-src *`.
  #
  # media-src gets it too: the hero background video is a CMS-supplied URL.
  #
  # The R2 bucket is named EXACTLY, not as *.r2.dev, for the same reason the
  # Supabase project is named below: r2.dev hands every bucket on the platform
  # a subdomain, so the wildcard would trust any bucket anyone can create in a
  # minute — which is most of what this directive exists to prevent.
  #
  # IF THE BUCKET MOVES TO A CUSTOM DOMAIN, change it here too. The failure is
  # silent: the hero shows its poster still and never moves, which reads as
  # "the video did not upload" rather than "the policy is stale".
  #
  # challenges.cloudflare.com is Turnstile, the "are you human" check in front
  # of the three forms. It needs TWO directives and the second is easy to
  # forget: `script-src` for its api.js, and `frame-src` for the iframe the
  # widget renders itself into. There is no `frame-src` fallback to be had —
  # without naming it, the directive inherits `default-src 'self'`, the iframe
  # is blocked, and the widget never produces a token, so every form rejects
  # every submission with "please complete the check" and no way to do so.
  #
  # frame-ancestors stays 'none': that governs who may frame US, which is
  # still nobody. It is unrelated to what we are allowed to frame.
  #
  # cloudflarestream.com / videodelivery.net are the portfolio's videos, and
  # they are in frame-src ONLY. A Stream video is an iframe carrying
  # Cloudflare's own player, so the player's own requests are governed by the
  # policy inside that frame, not this one: nothing needs adding to media-src,
  # connect-src or script-src for it, and adding it would widen the page's
  # policy for no gain. The wildcard is on the SUBDOMAIN alone — a Stream
  # embed lives at customer-<code>.cloudflarestream.com, where the code is
  # per-account, and `*.` matches that without naming every account's code.
  # videodelivery.net is the account-agnostic embed host, used when somebody
  # pastes a bare video id with no customer subdomain to read off.
  #
  # A blocked frame here is silent: the tile shows its poster and never moves,
  # which looks exactly like a video that has not been uploaded yet.
  #
  # connect-src NAMES THE PROJECT, and used to say `https://*.supabase.co`.
  # That wildcard trusted every Supabase project on the internet, which gives
  # away most of what this directive is for: the point of listing Supabase is
  # that an injected script cannot post a form anywhere else, and a wildcard
  # makes "anywhere else" include any project an attacker can create in about
  # a minute. The project ref is not secret — it is already in SUPABASE_URL,
  # which ships in the bundle.
  #
  # IF THE SUPABASE PROJECT EVER CHANGES, change it here too. The failure is
  # silent and total: every form gets a CSP violation in the console and
  # nothing else, so it reads as "the forms are broken" rather than "the
  # policy is stale".
  #
  # GOOGLE ANALYTICS 4 needs THREE directives, and missing any one of them
  # fails the same quiet way everything else in this file does — the tag looks
  # installed, the Realtime report stays empty, and the obvious conclusion is
  # that the measurement id is wrong.
  #
  #   script-src   googletagmanager.com serves gtag.js itself.
  #   connect-src  where the hits actually go. `*.google-analytics.com` is a
  #                SUBDOMAIN wildcard and has to be: GA4 sends collection hits
  #                to a regional host — region1.google-analytics.com and
  #                friends — chosen by Google, not by us, so naming
  #                www.google-analytics.com alone drops traffic from whichever
  #                regions get routed elsewhere. It matches subdomains of
  #                google-analytics.com and nothing else, which is the same
  #                shape as the cloudflarestream.com entry below and not the
  #                suffix match that rule warns about.
  #   img-src      gtag still falls back to a pixel when a browser blocks or
  #                fails the fetch, and that pixel is how those visits get
  #                counted at all.
  #
  # Nothing here is added to frame-src: GA4 renders no iframe.
  #
  # IF ANALYTICS IS EVER REMOVED, take these back out. A policy that trusts an
  # origin nothing loads from is a permission granted to whatever gets injected
  # next, for no benefit at all.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.sanity.io https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://ocxbnnfchqzgkbqlagnq.supabase.co https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; media-src 'self' https://cdn.sanity.io https://pub-5bcaef0bed5a45e1bb7c8c42238fa677.r2.dev; frame-src https://challenges.cloudflare.com https://*.cloudflarestream.com https://iframe.videodelivery.net; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# --- Fonts need CORS to be preloaded -----------------------------
# A <link rel="preload" as="font"> is fetched in anonymous CORS mode even
# from the same origin. Without an ACAO header the browser downloads the
# file, throws the response away and downloads it a second time.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# --- Compression -------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Correct MIME types for modern formats -----------------------
<IfModule mod_mime.c>
  AddType image/avif  .avif
  AddType font/woff2  .woff2
  AddType video/webm  .webm
</IfModule>
